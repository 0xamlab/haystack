"""test_query_aggregate_fused.mojo — the fused, radix and code-indexed grouping paths.

Hand-written. The load-bearing assertions, in order of what they protect:

  * EQUIVALENCE: `group_by_many(batch, [k], [v], [op])` must be IDENTICAL to the
    existing `group_by(batch, k, v, op)` for every opcode — same groups, same
    first-appearance order, same counts, same values. Serial against serial is
    bit-exact by shared fold order; banded-8 against `group_by_parallel`-8 is
    bit-exact by shared bands and shared merge order. This is what licenses every
    caller to switch to the fused driver.
  * The multi-aggregate case asserts each fused column against its own separate
    single-column run — the fused scan must be a pure fusion, not a re-derivation.
  * RADIX == SERIAL, bit-for-bit, INCLUDING mean/variance and INCLUDING order, at
    100k groups. The radix path folds each group's rows in ascending global row
    order (bucket concatenation in band order), so it owes bit-equality — a
    stronger promise than the band path's merge tolerance — and the first-row
    P-way merge owes the exact first-appearance order. This pair of assertions is
    what makes the partitioned path shippable.
  * CODED == HASHED on valid codes, and a TYPED REFUSAL — never an index — on
    anything that is not a code in [0, cardinality): non-integral, negative, at
    or past the cardinality, NaN. The dense array is only safe because of that
    guard, so the suite drives every violation class through both worker shapes.
  * Known values computed by hand (sums 16/20, variance 20/3, the 200/7 bimodal
    m2 that a naive stripe merge gets exactly wrong), so the equivalences above
    cannot all be satisfied by a shared bug.

Data is generated by a fixed-seed LCG in this file, so failures reproduce.
"""
from columnar.array import Float64Array, float64_from_list, float64_with_nulls
from columnar.batch import RecordBatch, schema_of
from numeric.contract import (
    AGG_AVG,
    AGG_COUNT,
    AGG_MAX,
    AGG_MIN,
    AGG_STD,
    AGG_SUM,
    AGG_VAR,
)
from query.aggregate import (
    CARDINALITY_PROBE_ROWS,
    GROUP_CODED_BAD_REQUEST,
    GROUP_CODED_CARDINALITY_INVALID,
    GROUP_CODED_KEY_NOT_A_CODE,
    GROUP_CODED_OK,
    GroupedResult,
    ManyGroupedResult,
    MAX_CODED_CARDINALITY,
    MAX_FUSED_AGGS,
    MultiGroupedResult,
    group_by_coded,
    group_by_coded_parallel,
    group_by_many,
    group_by_many_banded,
    group_by_many_parallel,
    group_by_many_radix,
    group_by_multi_parallel,
    group_by_parallel,
    probe_cardinality,
)


def _lcg_next(state: UInt64) -> UInt64:
    return state * 6364136223846793005 + 1442695040888963407


def _batch_ints(n_rows: Int, n_groups: Int, with_nulls: Bool) -> RecordBatch:
    """k in 0..n_groups-1; v1/v2/v3 integers with THREE DIFFERENT null patterns.

    Different patterns per value column because the fused counts are per
    (group, aggregate) — identical patterns would let a shared-count bug pass.
    """
    var state: UInt64 = 0x9E3779B97F4A7C15
    var keys = List[Float64]()
    var key_mask = List[Bool]()
    var v1 = List[Float64]()
    var m1 = List[Bool]()
    var v2 = List[Float64]()
    var m2 = List[Bool]()
    var v3 = List[Float64]()
    var m3 = List[Bool]()
    for i in range(n_rows):
        state = _lcg_next(state)
        keys.append(Float64(Int((state >> 33) % UInt64(n_groups))))
        key_mask.append(not (with_nulls and i % 97 == 0))
        state = _lcg_next(state)
        v1.append(Float64(Int((state >> 33) % 1000)))
        m1.append(not (with_nulls and i % 13 == 0))
        state = _lcg_next(state)
        v2.append(Float64(Int((state >> 33) % 500)))
        m2.append(not (with_nulls and i % 7 == 0))
        state = _lcg_next(state)
        v3.append(Float64(Int((state >> 33) % 100)))
        m3.append(not (with_nulls and i % 31 == 0))

    var names = List[String]()
    names.append("k")
    names.append("v1")
    names.append("v2")
    names.append("v3")
    var cols = List[Float64Array]()
    cols.append(float64_with_nulls(keys^, key_mask))
    cols.append(float64_with_nulls(v1^, m1))
    cols.append(float64_with_nulls(v2^, m2))
    cols.append(float64_with_nulls(v3^, m3))
    return RecordBatch(schema_of(names^), cols^, n_rows)


def _batch_continuous(n_rows: Int, n_groups: Int) -> RecordBatch:
    """Continuous v1/v2 in [0, 1) — where association drift is visible, so
    where bit-equality claims actually bite."""
    var state: UInt64 = 0xDEADBEEFCAFEF00D
    var keys = List[Float64]()
    var v1 = List[Float64]()
    var v2 = List[Float64]()
    for _ in range(n_rows):
        state = _lcg_next(state)
        keys.append(Float64(Int((state >> 33) % UInt64(n_groups))))
        state = _lcg_next(state)
        v1.append(Float64(Int(state >> 11)) / 9007199254740992.0)
        state = _lcg_next(state)
        v2.append(Float64(Int(state >> 11)) / 9007199254740992.0)

    var names = List[String]()
    names.append("k")
    names.append("v1")
    names.append("v2")
    var cols = List[Float64Array]()
    cols.append(float64_from_list(keys^))
    cols.append(float64_from_list(v1^))
    cols.append(float64_from_list(v2^))
    return RecordBatch(schema_of(names^), cols^, n_rows)


def _many_matches_grouped(many: ManyGroupedResult, agg: Int, single: GroupedResult) -> Bool:
    """Fused column `agg` against a single-column run: bit-exact, order included."""
    if many.n_groups() != single.n_groups() or many.key_width != 1:
        return False
    if many.null_key_rows != single.null_key_rows:
        return False
    for g in range(single.n_groups()):
        if many.key_tuples[g] != single.keys[g]:
            return False
        if many.value_at(g, agg) != single.values[g]:
            return False
        if many.present_at(g, agg) != single.present[g]:
            return False
        if many.count_at(g, agg) != single.counts[g]:
            return False
    return True


def _many_matches_grouped_close(
    many: ManyGroupedResult, agg: Int, single: GroupedResult, rel_tol: Float64
) -> Bool:
    """Same groups/order/counts exactly; values within relative tolerance."""
    if many.n_groups() != single.n_groups() or many.key_width != 1:
        return False
    if many.null_key_rows != single.null_key_rows:
        return False
    for g in range(single.n_groups()):
        if many.key_tuples[g] != single.keys[g]:
            return False
        if many.present_at(g, agg) != single.present[g]:
            return False
        if many.count_at(g, agg) != single.counts[g]:
            return False
        var scale = single.values[g] if single.values[g] > 0.0 else -single.values[g]
        if scale < 1.0:
            scale = 1.0
        var delta = many.value_at(g, agg) - single.values[g]
        if delta < 0.0:
            delta = -delta
        if delta > rel_tol * scale:
            return False
    return True


def _many_identical_exact(a: ManyGroupedResult, b: ManyGroupedResult) -> Bool:
    """Bit-equality across the whole result: tuples, order, values, presence, counts."""
    if a.n_groups() != b.n_groups() or a.key_width != b.key_width:
        return False
    if a.n_aggs != b.n_aggs or a.null_key_rows != b.null_key_rows:
        return False
    for i in range(len(a.key_tuples)):
        if a.key_tuples[i] != b.key_tuples[i]:
            return False
    for i in range(len(a.values)):
        if a.values[i] != b.values[i]:
            return False
        if a.present[i] != b.present[i]:
            return False
        if a.counts[i] != b.counts[i]:
            return False
    return True


def _many_matches_multi(many: ManyGroupedResult, agg: Int, multi: MultiGroupedResult) -> Bool:
    """Fused composite column `agg` against a `group_by_multi` run: bit-exact."""
    if many.n_groups() != multi.n_groups() or many.key_width != multi.key_width:
        return False
    if many.null_key_rows != multi.null_key_rows:
        return False
    for i in range(len(many.key_tuples)):
        if many.key_tuples[i] != multi.key_tuples[i]:
            return False
    for g in range(multi.n_groups()):
        if many.value_at(g, agg) != multi.values[g]:
            return False
        if many.present_at(g, agg) != multi.present[g]:
            return False
        if many.count_at(g, agg) != multi.counts[g]:
            return False
    return True


def _is_empty_refusal(coded_status: Int, want_status: Int, result: ManyGroupedResult) -> Bool:
    return (
        coded_status == want_status
        and result.n_groups() == 0
        and result.n_aggs == 0
        and len(result.values) == 0
    )


def main() raises:
    var passed = 0
    var failed = 0

    var all_ops = List[Int]()
    all_ops.append(AGG_SUM)
    all_ops.append(AGG_COUNT)
    all_ops.append(AGG_AVG)
    all_ops.append(AGG_MIN)
    all_ops.append(AGG_MAX)
    all_ops.append(AGG_VAR)
    all_ops.append(AGG_STD)

    var k_only = List[Int]()
    k_only.append(0)

    # ── 1. fused single-aggregate == group_by, serially, for EVERY opcode ──────
    var ints = _batch_ints(120_000, 100, True)
    var ok_serial = True
    for oi in range(len(all_ops)):
        var op = all_ops[oi]
        var vc = List[Int]()
        vc.append(1)
        var ops = List[Int]()
        ops.append(op)
        var fused = group_by_many_parallel(ints, k_only, vc, ops, 1)
        var single = group_by_parallel(ints, 0, 1, op, 1)
        if not _many_matches_grouped(fused, 0, single):
            ok_serial = False
    if ok_serial:
        passed += 1
        print("  ✅ fused [v],[op] == group_by for all 7 opcodes, serial, bit-exact")
    else:
        failed += 1
        print("  ❌ fused single-aggregate diverged from group_by on some opcode")

    # ── 2. fused single-aggregate banded-8 == group_by_parallel-8, every opcode ─
    # Same bands, same merge order: the associations are identical, so this is
    # bit-exact even for mean/variance on continuous data.
    var cont = _batch_continuous(200_000, 64)
    var ok_banded = True
    for oi in range(len(all_ops)):
        var op = all_ops[oi]
        var vc = List[Int]()
        vc.append(1)
        var ops = List[Int]()
        ops.append(op)
        if not _many_matches_grouped(
            group_by_many_banded(ints, k_only, vc, ops, 8),
            0,
            group_by_parallel(ints, 0, 1, op, 8),
        ):
            ok_banded = False
        if not _many_matches_grouped(
            group_by_many_banded(cont, k_only, vc, ops, 8),
            0,
            group_by_parallel(cont, 0, 1, op, 8),
        ):
            ok_banded = False
    if ok_banded:
        passed += 1
        print("  ✅ fused banded-8 == group_by_parallel-8 for all 7 opcodes, bit-exact")
    else:
        failed += 1
        print("  ❌ banded fused diverged from group_by_parallel at equal workers")

    # ── 3. multi-aggregate: each fused column == its own single-column run ─────
    # Five aggregates over three value columns with three null patterns, v1
    # appearing twice under different opcodes.
    var vc5 = List[Int]()
    vc5.append(1)
    vc5.append(2)
    vc5.append(3)
    vc5.append(1)
    vc5.append(2)
    var ops5 = List[Int]()
    ops5.append(AGG_SUM)
    ops5.append(AGG_AVG)
    ops5.append(AGG_MAX)
    ops5.append(AGG_MIN)
    ops5.append(AGG_VAR)
    var fused5 = group_by_many_parallel(ints, k_only, vc5, ops5, 1)
    var ok_multi = fused5.n_aggs == 5
    for j in range(5):
        if not _many_matches_grouped(
            fused5, j, group_by_parallel(ints, 0, vc5[j], ops5[j], 1)
        ):
            ok_multi = False
    var fused5p = group_by_many_banded(ints, k_only, vc5, ops5, 8)
    for j in range(5):
        if not _many_matches_grouped(
            fused5p, j, group_by_parallel(ints, 0, vc5[j], ops5[j], 8)
        ):
            ok_multi = False
    if ok_multi:
        passed += 1
        print("  ✅ 5-aggregate fusion: every column bit-equal to its separate run, 1 and 8 workers")
    else:
        failed += 1
        print("  ❌ a fused column diverged from its own single-column run")

    # ── 4. RADIX == SERIAL bit-for-bit at 100k groups, order included ──────────
    # The radix path folds every group in ascending global row order, so unlike
    # the band path it owes bit-equality on mean and variance too — and the
    # first-row merge owes the exact first-appearance order. 300k rows over
    # 100k groups, continuous values, plus the nulls shape.
    var vc2 = List[Int]()
    vc2.append(1)
    vc2.append(2)
    var ops2 = List[Int]()
    ops2.append(AGG_AVG)
    ops2.append(AGG_VAR)
    var big = _batch_continuous(300_000, 100_000)
    var r_serial = group_by_many_parallel(big, k_only, vc2, ops2, 1)
    var r_radix = group_by_many_radix(big, k_only, vc2, ops2, 8)
    var ints_hi = _batch_ints(300_000, 50_000, True)
    var sum2 = List[Int]()
    sum2.append(AGG_SUM)
    sum2.append(AGG_COUNT)
    var n_serial = group_by_many_parallel(ints_hi, k_only, vc2, sum2, 1)
    var n_radix = group_by_many_radix(ints_hi, k_only, vc2, sum2, 8)
    if (
        r_serial.n_groups() == 95_003  # 300k draws over a 100k key space realize 95003
        and _many_identical_exact(r_serial, r_radix)
        and _many_identical_exact(n_serial, n_radix)
    ):
        passed += 1
        print("  ✅ radix-8 == serial bit-for-bit at 100k groups: order, mean, variance, nulls")
    else:
        failed += 1
        print(
            "  ❌ radix diverged from serial:",
            r_serial.n_groups(),
            r_radix.n_groups(),
        )

    # ── 5. radix reproducibility and adversarial shapes ────────────────────────
    var r_again = group_by_many_radix(big, k_only, vc2, ops2, 8)
    var one_keys = List[Float64]()
    var one_v = List[Float64]()
    for i in range(100_000):
        one_keys.append(7.0)
        one_v.append(Float64(i % 100))
    var g1names = List[String]()
    g1names.append("k")
    g1names.append("v")
    var g1cols = List[Float64Array]()
    g1cols.append(float64_from_list(one_keys^))
    g1cols.append(float64_from_list(one_v^))
    var one_group = RecordBatch(schema_of(g1names^), g1cols^, 100_000)
    var dis_keys = List[Float64]()
    var dis_v = List[Float64]()
    for i in range(100_000):
        dis_keys.append(Float64(i))
        dis_v.append(3.0)
    var gdnames = List[String]()
    gdnames.append("k")
    gdnames.append("v")
    var gdcols = List[Float64Array]()
    gdcols.append(float64_from_list(dis_keys^))
    gdcols.append(float64_from_list(dis_v^))
    var distinct = RecordBatch(schema_of(gdnames^), gdcols^, 100_000)
    var vc1 = List[Int]()
    vc1.append(1)
    var ops1 = List[Int]()
    ops1.append(AGG_SUM)
    var one_s = group_by_many_parallel(one_group, k_only, vc1, ops1, 1)
    var one_r = group_by_many_radix(one_group, k_only, vc1, ops1, 8)
    var dis_s = group_by_many_parallel(distinct, k_only, vc1, ops1, 1)
    var dis_r = group_by_many_radix(distinct, k_only, vc1, ops1, 8)
    if (
        _many_identical_exact(r_radix, r_again)
        and one_r.n_groups() == 1
        and _many_identical_exact(one_s, one_r)
        and dis_r.n_groups() == 100_000
        and _many_identical_exact(dis_s, dis_r)
    ):
        passed += 1
        print("  ✅ radix: reproducible, and exact on all-one-group and 100k all-distinct")
    else:
        failed += 1
        print("  ❌ radix adversarial shapes diverged:", one_r.n_groups(), dis_r.n_groups())

    # ── 6. composite keys through the fused paths, radix included ──────────────
    var state: UInt64 = 0x1234ABCD5678EF90
    var mk1 = List[Float64]()
    var mk2 = List[Float64]()
    var mv = List[Float64]()
    var mkm = List[Bool]()
    var mvm = List[Bool]()
    for i in range(150_000):
        state = _lcg_next(state)
        mk1.append(Float64(Int((state >> 33) % 80)))
        state = _lcg_next(state)
        mk2.append(Float64(Int((state >> 33) % 50)))
        state = _lcg_next(state)
        mv.append(Float64(Int((state >> 33) % 500)))
        mkm.append(i % 89 != 0)
        mvm.append(i % 11 != 0)
    var mnames = List[String]()
    mnames.append("k1")
    mnames.append("k2")
    mnames.append("v")
    var mcols = List[Float64Array]()
    mcols.append(float64_with_nulls(mk1^, mkm))
    mcols.append(float64_from_list(mk2^))
    mcols.append(float64_with_nulls(mv^, mvm))
    var mbatch = RecordBatch(schema_of(mnames^), mcols^, 150_000)
    var kc2 = List[Int]()
    kc2.append(0)
    kc2.append(1)
    var mvc = List[Int]()  # mbatch's value column is 2 (0 and 1 are the keys)
    mvc.append(2)
    var m_single = group_by_multi_parallel(mbatch, kc2, 2, AGG_SUM, 1)
    var m_fused = group_by_many_parallel(mbatch, kc2, mvc, ops1, 1)
    var m_banded = group_by_many_banded(mbatch, kc2, mvc, ops1, 8)
    var m_radix = group_by_many_radix(mbatch, kc2, mvc, ops1, 8)
    var m_single8 = group_by_multi_parallel(mbatch, kc2, 2, AGG_SUM, 8)
    if (
        m_fused.n_groups() == 4000
        and _many_matches_multi(m_fused, 0, m_single)
        and _many_matches_multi(m_banded, 0, m_single8)
        and _many_identical_exact(m_fused, m_radix)
    ):
        passed += 1
        print("  ✅ composite keys: fused == group_by_multi serial/banded; radix == serial exact")
    else:
        failed += 1
        print("  ❌ composite fused diverged:", m_fused.n_groups(), m_radix.n_groups())

    # ── 7. the between-bands m2 term survives fusion, per stripe ───────────────
    # Two value columns, both [0 x4, 10 x4] on one group, split by 2 workers:
    # each band's m2 is 0 per column; the true variance is 200/7 per column. A
    # merge that combines the wrong stripe, or adds m2 naively, fails here.
    var bkeys = List[Float64]()
    var bv1 = List[Float64]()
    var bv2 = List[Float64]()
    for i in range(8):
        bkeys.append(1.0)
        bv1.append(0.0 if i < 4 else 10.0)
        bv2.append(0.0 if i < 4 else 10.0)
    var bnames = List[String]()
    bnames.append("k")
    bnames.append("v1")
    bnames.append("v2")
    var bcols = List[Float64Array]()
    bcols.append(float64_from_list(bkeys^))
    bcols.append(float64_from_list(bv1^))
    bcols.append(float64_from_list(bv2^))
    var bimodal = RecordBatch(schema_of(bnames^), bcols^, 8)
    var var2 = List[Int]()
    var2.append(AGG_VAR)
    var2.append(AGG_VAR)
    var bi = group_by_many_banded(bimodal, k_only, vc2, var2, 2)
    var want = 200.0 / 7.0
    var d0 = bi.value_at(0, 0) - want
    if d0 < 0.0:
        d0 = -d0
    var d1 = bi.value_at(0, 1) - want
    if d1 < 0.0:
        d1 = -d1
    if bi.n_groups() == 1 and d0 < 1e-12 and d1 < 1e-12:
        passed += 1
        print("  ✅ two zero-m2 bands merge to variance 200/7 in BOTH stripes")
    else:
        failed += 1
        print("  ❌ striped m2 merge wrong:", bi.value_at(0, 0), bi.value_at(0, 1))

    # ── 8. known values by hand, through serial, banded and radix ──────────────
    # keys [1,2]x4; v1 = 1..8 so sum(g1)={1,3,5,7}=16, sum(g2)=20, var(g1)=20/3;
    # v2 = 10,10,20,20,30,30,40,40, present only on g1's rows, so g2's v2 mean
    # is ABSENT (count 0) and g1's is mean{10,20,30,40} = 25.
    var hkeys = List[Float64]()
    var hv1 = List[Float64]()
    var hv2 = List[Float64]()
    var hm2 = List[Bool]()
    for i in range(8):
        hkeys.append(1.0 if i % 2 == 0 else 2.0)
        hv1.append(Float64(i + 1))
        hv2.append(Float64((i // 2 + 1) * 10))
        hm2.append(i % 2 == 0)
    var hnames = List[String]()
    hnames.append("k")
    hnames.append("v1")
    hnames.append("v2")
    var hcols = List[Float64Array]()
    hcols.append(float64_from_list(hkeys^))
    hcols.append(float64_from_list(hv1^))
    hcols.append(float64_with_nulls(hv2^, hm2))
    var hand = RecordBatch(schema_of(hnames^), hcols^, 8)
    var hops = List[Int]()
    hops.append(AGG_SUM)
    hops.append(AGG_AVG)
    var hvc = List[Int]()
    hvc.append(1)
    hvc.append(2)
    var known_ok = True
    for path in range(3):
        var res = group_by_many_parallel(hand, k_only, hvc, hops, 1)
        if path == 1:
            res = group_by_many_banded(hand, k_only, hvc, hops, 4)
        if path == 2:
            res = group_by_many_radix(hand, k_only, hvc, hops, 4)
        if res.n_groups() != 2:
            known_ok = False
            continue
        if res.key_tuples[0] != 1.0 or res.key_tuples[1] != 2.0:
            known_ok = False
        if res.value_at(0, 0) != 16.0 or res.value_at(1, 0) != 20.0:
            known_ok = False
        var dm = res.value_at(0, 1) - 25.0
        if dm < 0.0:
            dm = -dm
        if dm > 1e-12 or not res.present_at(0, 1):
            known_ok = False
        if res.present_at(1, 1) or res.count_at(1, 1) != 0.0:
            known_ok = False
        if res.count_at(0, 0) != 4.0 or res.count_at(1, 0) != 4.0:
            known_ok = False
    var var_only = List[Int]()
    var_only.append(AGG_VAR)
    var hvar = group_by_many_parallel(hand, k_only, vc1, var_only, 1)
    var dv = hvar.value_at(0, 0) - 20.0 / 3.0
    if dv < 0.0:
        dv = -dv
    if known_ok and dv < 1e-12:
        passed += 1
        print("  ✅ hand-computed sums 16/20, mean 25, absent g2 mean, var 20/3 — all 3 paths")
    else:
        failed += 1
        print("  ❌ known-value check failed on some path")

    # ── 9. coded == hashed on valid codes, every opcode, both worker shapes ────
    # _batch_ints keys are 0..99, so cardinality 100 is exactly right, and the
    # nulls exercise exclusion (a null key is NOT a bad code).
    var coded_ok = True
    for oi in range(len(all_ops)):
        var op = all_ops[oi]
        var vc = List[Int]()
        vc.append(1)
        var ops = List[Int]()
        ops.append(op)
        var c1 = group_by_coded_parallel(ints, 0, 100, vc, ops, 1)
        if not c1.ok() or not _many_matches_grouped(
            c1.result, 0, group_by_parallel(ints, 0, 1, op, 1)
        ):
            coded_ok = False
        var c8 = group_by_coded_parallel(ints, 0, 100, vc, ops, 8)
        if not c8.ok() or not _many_matches_grouped(
            c8.result, 0, group_by_parallel(ints, 0, 1, op, 8)
        ):
            coded_ok = False
    var cf = group_by_coded_parallel(ints, 0, 100, vc5, ops5, 1)
    if not cf.ok() or not _many_identical_exact(cf.result, fused5):
        coded_ok = False
    if coded_ok:
        passed += 1
        print("  ✅ coded == hashed: all 7 opcodes at 1 and 8 workers, and the 5-agg fusion")
    else:
        failed += 1
        print("  ❌ coded path diverged from the hash path on valid codes")

    # ── 10. coded order is THIS batch's first appearance, not code order ───────
    var okeys = List[Float64]()
    okeys.append(5.0)
    okeys.append(2.0)
    okeys.append(5.0)
    okeys.append(9.0)
    okeys.append(2.0)
    okeys.append(0.0)
    var ov = List[Float64]()
    for i in range(6):
        ov.append(Float64(i))
    var onames = List[String]()
    onames.append("k")
    onames.append("v")
    var ocols = List[Float64Array]()
    ocols.append(float64_from_list(okeys^))
    ocols.append(float64_from_list(ov^))
    var obatch = RecordBatch(schema_of(onames^), ocols^, 6)
    var oc1 = group_by_coded_parallel(obatch, 0, 10, vc1, ops1, 1)
    var oc2 = group_by_coded_parallel(obatch, 0, 10, vc1, ops1, 2)
    var order_ok = oc1.ok() and oc2.ok() and oc1.result.n_groups() == 4
    if order_ok:
        var want_order = List[Float64]()
        want_order.append(5.0)
        want_order.append(2.0)
        want_order.append(9.0)
        want_order.append(0.0)
        for g in range(4):
            if oc1.result.key_tuples[g] != want_order[g]:
                order_ok = False
            if oc2.result.key_tuples[g] != want_order[g]:
                order_ok = False
    if order_ok:
        passed += 1
        print("  ✅ coded groups come back [5,2,9,0] — first appearance, not code order")
    else:
        failed += 1
        print("  ❌ coded group order wrong")

    # ── 11. every not-a-code class refuses, at 1 worker and at 8 ───────────────
    # Codes at the cardinality boundary, non-integral, negative, NaN. Each must
    # return GROUP_CODED_KEY_NOT_A_CODE with an EMPTY result — never index.
    var bad_kinds_ok = True
    for kind in range(4):
        var bkeys2 = List[Float64]()
        var bvals = List[Float64]()
        for i in range(70_000):
            bkeys2.append(Float64(i % 50))
            bvals.append(1.0)
        # One poisoned row, deep enough that band 7 of 8 sees it too.
        if kind == 0:
            bkeys2[65_000] = 50.0  # == cardinality: first out-of-range value
        elif kind == 1:
            bkeys2[65_000] = 3.5  # non-integral
        elif kind == 2:
            bkeys2[65_000] = -1.0  # negative
        else:
            bkeys2[65_000] = Float64(0.0) / Float64(0.0)  # NaN
        var bn = List[String]()
        bn.append("k")
        bn.append("v")
        var bc = List[Float64Array]()
        bc.append(float64_from_list(bkeys2^))
        bc.append(float64_from_list(bvals^))
        var bb = RecordBatch(schema_of(bn^), bc^, 70_000)
        var refuse1 = group_by_coded_parallel(bb, 0, 50, vc1, ops1, 1)
        var refuse8 = group_by_coded_parallel(bb, 0, 50, vc1, ops1, 8)
        if not _is_empty_refusal(refuse1.status, GROUP_CODED_KEY_NOT_A_CODE, refuse1.result):
            bad_kinds_ok = False
        if not _is_empty_refusal(refuse8.status, GROUP_CODED_KEY_NOT_A_CODE, refuse8.result):
            bad_kinds_ok = False
    if bad_kinds_ok:
        passed += 1
        print("  ✅ boundary, non-integral, negative and NaN keys all refuse, 1 and 8 workers")
    else:
        failed += 1
        print("  ❌ a not-a-code key did not refuse")

    # ── 12. cardinality and request validation on the coded path ───────────────
    var c_zero = group_by_coded_parallel(ints, 0, 0, vc1, ops1, 1)
    var c_neg = group_by_coded_parallel(ints, 0, -5, vc1, ops1, 1)
    var c_huge = group_by_coded_parallel(ints, 0, MAX_CODED_CARDINALITY + 1, vc1, ops1, 1)
    var c_atmax = group_by_coded_parallel(ints, 0, MAX_CODED_CARDINALITY, vc1, ops1, 8)
    var mismatched = List[Int]()
    mismatched.append(AGG_SUM)
    mismatched.append(AGG_AVG)
    var c_mismatch = group_by_coded_parallel(ints, 0, 100, vc1, mismatched, 1)
    if (
        _is_empty_refusal(c_zero.status, GROUP_CODED_CARDINALITY_INVALID, c_zero.result)
        and _is_empty_refusal(c_neg.status, GROUP_CODED_CARDINALITY_INVALID, c_neg.result)
        and _is_empty_refusal(c_huge.status, GROUP_CODED_CARDINALITY_INVALID, c_huge.result)
        and c_atmax.ok()
        and c_atmax.result.n_groups() == 100
        and _is_empty_refusal(c_mismatch.status, GROUP_CODED_BAD_REQUEST, c_mismatch.result)
    ):
        passed += 1
        print("  ✅ cardinality 0/-5/4097 refuse, 4096 works, opcode mismatch refuses")
    else:
        failed += 1
        print("  ❌ coded validation wrong:", c_zero.status, c_huge.status, c_mismatch.status)

    # ── 13. malformed fused requests get the empty result on every path ────────
    var too_many_vc = List[Int]()
    var too_many_ops = List[Int]()
    for _ in range(MAX_FUSED_AGGS + 1):
        too_many_vc.append(1)
        too_many_ops.append(AGG_SUM)
    var e1 = group_by_many_parallel(ints, k_only, vc1, mismatched, 8)
    var e2 = group_by_many_parallel(ints, k_only, List[Int](), List[Int](), 8)
    var e3 = group_by_many_banded(ints, k_only, too_many_vc, too_many_ops, 8)
    var e4 = group_by_many_radix(ints, k_only, vc1, mismatched, 8)
    if (
        e1.n_aggs == 0 and e1.n_groups() == 0 and len(e1.values) == 0
        and e2.n_aggs == 0 and len(e2.values) == 0
        and e3.n_aggs == 0 and len(e3.values) == 0
        and e4.n_aggs == 0 and len(e4.values) == 0
    ):
        passed += 1
        print("  ✅ mismatched/empty/oversized requests: empty result, all fused paths")
    else:
        failed += 1
        print("  ❌ a malformed fused request produced a non-empty result")

    # ── 14. zero key columns: one stripe over everything, any worker count ─────
    var w0_s = group_by_many_parallel(ints, List[Int](), vc5, ops5, 1)
    var w0_p = group_by_many_parallel(ints, List[Int](), vc5, ops5, 8)
    var w0_ok = (
        w0_s.n_groups() == 0
        and len(w0_s.values) == 5
        and len(w0_p.values) == 5
        and w0_s.n_aggs == 5
    )
    if w0_ok:
        for j in range(5):
            if w0_s.values[j] != w0_p.values[j] or w0_s.counts[j] != w0_p.counts[j]:
                w0_ok = False
    if w0_ok:
        passed += 1
        print("  ✅ zero key columns: five totals over everything, identical at 1 and 8 workers")
    else:
        failed += 1
        print("  ❌ width-0 fused grouping diverged")

    # ── 15. probe_cardinality: counts distinct, skips nulls, caps at the window ─
    var p_small = probe_cardinality(ints, k_only, CARDINALITY_PROBE_ROWS)
    var p_all = probe_cardinality(distinct, k_only, CARDINALITY_PROBE_ROWS)
    var p_tiny = probe_cardinality(obatch, k_only, CARDINALITY_PROBE_ROWS)
    var p_comp = probe_cardinality(mbatch, kc2, CARDINALITY_PROBE_ROWS)
    if (
        p_small == 100
        and p_all == CARDINALITY_PROBE_ROWS
        and p_tiny == 4
        and p_comp == 4000
    ):
        passed += 1
        print("  ✅ probe: 100 of 100, window-capped on all-distinct, 4 of 4, 4000 composite")
    else:
        failed += 1
        print("  ❌ probe_cardinality wrong:", p_small, p_all, p_tiny, p_comp)

    # ── 16. the dispatching entry point agrees with serial in both regimes ─────
    # Low cardinality (band branch): exact for sums/counts, 1e-9 for the mean
    # drift the band merge is allowed. High cardinality (radix branch): exact.
    var avg1 = List[Int]()
    avg1.append(AGG_AVG)
    var auto_low = group_by_many_parallel(ints, k_only, vc2, sum2, 8)
    var low_serial = group_by_many_parallel(ints, k_only, vc2, sum2, 1)
    var auto_low_avg = group_by_many_parallel(cont, k_only, vc1, avg1, 8)
    var low_serial_avg = group_by_many_parallel(cont, k_only, vc1, avg1, 1)
    var auto_hi = group_by_many_parallel(big, k_only, vc2, ops2, 8)
    var auto_ok = (
        _many_identical_exact(auto_low, low_serial)
        and _many_identical_exact(auto_hi, r_serial)
        and _many_matches_grouped_close(
            auto_low_avg, 0, group_by_parallel(cont, 0, 1, AGG_AVG, 1), 1e-9
        )
        and low_serial_avg.n_groups() == auto_low_avg.n_groups()
    )
    if auto_ok:
        passed += 1
        print("  ✅ auto dispatch: band regime within tolerance, radix regime bit-exact")
    else:
        failed += 1
        print("  ❌ auto-dispatched group_by_many diverged from serial")

    # ── 17. the unsuffixed entry points plan like round 1's ────────────────────
    var auto_full = group_by_many(big, k_only, vc2, ops2)
    var coded_auto = group_by_coded(ints, 0, 100, vc1, ops1)
    if _many_identical_exact(auto_full, r_serial) and coded_auto.ok():
        passed += 1
        print("  ✅ group_by_many / group_by_coded (auto workers) match their explicit forms")
    else:
        failed += 1
        print("  ❌ auto-planned entry points diverged")

    print("  [query.aggregate fused] Passed:", passed, "Failed:", failed)
    if failed > 0:
        raise Error("test_query_aggregate_fused: " + String(failed) + " failure(s)")
