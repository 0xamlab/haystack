"""test_query_aggregate_round3.mojo — opcode-specialized updates, the counted
scatter, batched hashing, and the four-engine routing table.

Hand-written. What each block protects, in order:

  * SPECIALIZED == FULL, field for field: `observe_op` must leave every field
    its opcode reads — `value_for(op)`, `has_answer(op)`, `count` — bit-equal
    to what the full `observe` leaves, on random AND adversarial finite
    values, and the equality must survive `merge_from` (the band-merge
    composition). This is the license for every fused path to specialize.
  * PRECOMPUTED-HASH PROBES == SELF-HASHING PROBES, slot for slot:
    `get_or_assign_bits` / `get_or_assign_hashed` fed the caller-computed
    (bits, hash) must assign and find exactly the slots `get_or_assign` does,
    including -0.0 (collapses to +0.0) and NaN (one group, not one per row).
    A batched hasher that disagreed with the table would lose groups silently.
  * The BATCHED width-N fast path == `group_by_multi` (an untouched round-1
    reference) on null-free composite keys — the shape the existing suite
    only covers through its null-key slow path.
  * COUNTED SCATTER == SERIAL, bit for bit and order included, on the shapes
    that stress the count/prefix/write machinery: fully clustered keys (some
    (worker, partition) cells empty), reverse-clustered, a batch smaller than
    the worker count, an odd worker count, null keys and values (the
    re-checked skip path), and ALL keys null (zero survivors — the empty
    payload edge). Radix owes serial bit-equality (ascending fold order), so
    every one of these is an exact comparison.
  * The ROUTING TABLE: `plan_many_route` answers per shape — CODED with the
    right bound for small integral codes, never CODED for non-integral,
    negative, >= MAX_CODED_CARDINALITY, composite or all-null keys, RADIX at
    high probed cardinality, SERIAL at one worker or width 0 — and the routed
    entry point returns the same answer the serial path does on every one of
    those shapes.
  * The REFUSAL FALLBACK: a batch whose probe window is all clean codes but
    whose tail is not (the window can only lie one way) must still return the
    hash engines' exact answer through `group_by_many_parallel`.

Data is generated by a fixed-seed LCG in this file, so failures reproduce.
"""
from columnar.array import Float64Array, float64_from_list, float64_with_nulls
from columnar.batch import RecordBatch, schema_of
from columnar.hash_index import (
    CompositeKeyIndex,
    HashIndex,
    hash_bits,
    hash_composite,
    normalize_bits,
)
from columnar.validity import count_valid, is_valid, new_all_valid, set_null
from numeric.contract import (
    AGG_AVG,
    AGG_COUNT,
    AGG_MAX,
    AGG_MIN,
    AGG_STD,
    AGG_SUM,
    AGG_VAR,
)
from query.aggregate import (
    CARDINALITY_PROBE_ROWS,
    GroupAccumulator,
    GroupedResult,
    ManyGroupedResult,
    MAX_CODED_CARDINALITY,
    ROUTE_BANDED,
    ROUTE_CODED,
    ROUTE_RADIX,
    ROUTE_SERIAL,
    group_by_many_banded,
    group_by_many_parallel,
    group_by_many_radix,
    group_by_multi_parallel,
    group_by_parallel,
    plan_many_route,
    probe_at_least,
    probe_coded_bound,
)


def _lcg_next(state: UInt64) -> UInt64:
    return state * 6364136223846793005 + 1442695040888963407


def _many_identical_exact(a: ManyGroupedResult, b: ManyGroupedResult) -> Bool:
    if a.n_groups() != b.n_groups() or a.key_width != b.key_width:
        return False
    if a.n_aggs != b.n_aggs or a.null_key_rows != b.null_key_rows:
        return False
    for i in range(len(a.key_tuples)):
        if a.key_tuples[i] != b.key_tuples[i]:
            return False
    for i in range(len(a.values)):
        if a.values[i] != b.values[i]:
            return False
        if a.present[i] != b.present[i]:
            return False
        if a.counts[i] != b.counts[i]:
            return False
    return True


def _many_matches_grouped(many: ManyGroupedResult, agg: Int, single: GroupedResult) -> Bool:
    if many.n_groups() != single.n_groups() or many.key_width != 1:
        return False
    if many.null_key_rows != single.null_key_rows:
        return False
    for g in range(single.n_groups()):
        if many.key_tuples[g] != single.keys[g]:
            return False
        if many.value_at(g, agg) != single.values[g]:
            return False
        if many.present_at(g, agg) != single.present[g]:
            return False
        if many.count_at(g, agg) != single.counts[g]:
            return False
    return True


def _single_key_batch(keys: List[Float64], values: List[Float64]) -> RecordBatch:
    var names = List[String]()
    names.append("k")
    names.append("v")
    var cols = List[Float64Array]()
    var n = len(keys)
    var ks = keys.copy()
    var vs = values.copy()
    cols.append(float64_from_list(ks^))
    cols.append(float64_from_list(vs^))
    return RecordBatch(schema_of(names^), cols^, n)


def main() raises:
    var passed = 0
    var failed = 0

    var all_ops = List[Int]()
    all_ops.append(AGG_SUM)
    all_ops.append(AGG_COUNT)
    all_ops.append(AGG_AVG)
    all_ops.append(AGG_MIN)
    all_ops.append(AGG_MAX)
    all_ops.append(AGG_VAR)
    all_ops.append(AGG_STD)

    var k_only = List[Int]()
    k_only.append(0)
    var vc1 = List[Int]()
    vc1.append(1)

    # ── 1. observe_op == observe, field for field, per opcode ──────────────────
    # Random values plus adversarial finite ones (±0.0, extremes, denormal
    # scale), streamed into a specialized and a full accumulator side by side.
    # The opcode's answer, answerability and count must match bit for bit at
    # every step — not just at the end — so an ordering bug cannot hide.
    var spec_ok = True
    var adversarial = List[Float64]()
    adversarial.append(0.0)
    adversarial.append(-0.0)
    adversarial.append(1e308)
    adversarial.append(-1e308)
    adversarial.append(1e-308)
    adversarial.append(-42.5)
    adversarial.append(7.25)
    for oi in range(len(all_ops)):
        var op = all_ops[oi]
        var full = GroupAccumulator(1.0)
        var spec = GroupAccumulator(1.0)
        var state: UInt64 = 0xABCDEF0123456789
        for step in range(5000):
            var v: Float64
            if step % 11 == 0:
                v = adversarial[(step // 11) % len(adversarial)]
            else:
                state = _lcg_next(state)
                v = Float64(Int(state >> 40)) / 1024.0 - 8000.0
            full.observe(v)
            spec.observe_op(op, v)
            if spec.value_for(op) != full.value_for(op):
                spec_ok = False
            if spec.has_answer(op) != full.has_answer(op):
                spec_ok = False
            if spec.count != full.count:
                spec_ok = False
    if spec_ok:
        passed += 1
        print("  ✅ observe_op == observe per opcode: value, answerability, count, every step")
    else:
        failed += 1
        print("  ❌ a specialized update diverged from the full observe")

    # ── 2. the specialization survives merge_from — the band-merge composition ─
    # Two bands per shape, one merged from specialized halves, one from full
    # halves; the opcode's answer must agree bit for bit (AVG merges through
    # the same Chan combine because count and mean are maintained).
    var merge_ok = True
    for oi in range(len(all_ops)):
        var op = all_ops[oi]
        var full_a = GroupAccumulator(1.0)
        var full_b = GroupAccumulator(1.0)
        var spec_a = GroupAccumulator(1.0)
        var spec_b = GroupAccumulator(1.0)
        var state: UInt64 = 0x1122334455667788
        for step in range(400):
            state = _lcg_next(state)
            var v = Float64(Int(state >> 40)) / 4096.0
            if step % 2 == 0:
                full_a.observe(v)
                spec_a.observe_op(op, v)
            else:
                full_b.observe(v)
                spec_b.observe_op(op, v)
        var full_m = GroupAccumulator(1.0)
        full_m.merge_from(full_a)
        full_m.merge_from(full_b)
        var spec_m = GroupAccumulator(1.0)
        spec_m.merge_from(spec_a)
        spec_m.merge_from(spec_b)
        if spec_m.value_for(op) != full_m.value_for(op):
            merge_ok = False
        if spec_m.has_answer(op) != full_m.has_answer(op):
            merge_ok = False
        if spec_m.count != full_m.count:
            merge_ok = False
        # An empty side must stay a no-op for specialized state too.
        var spec_e = GroupAccumulator(1.0)
        spec_m.merge_from(spec_e)
        if spec_m.value_for(op) != full_m.value_for(op):
            merge_ok = False
    if merge_ok:
        passed += 1
        print("  ✅ specialized accumulators merge bit-equal to full ones, all 7 opcodes")
    else:
        failed += 1
        print("  ❌ merge_from broke a specialized accumulator's answer")

    # ── 3. precomputed-hash probes == self-hashing probes, slot for slot ───────
    # 20k keys with heavy duplication, plus -0.0/NaN: the two entries must
    # assign identical slots in identical order on both index types.
    var probe_ok = True
    var hi_a = HashIndex(64)
    var hi_b = HashIndex(64)
    var state3: UInt64 = 0xFEEDFACE12345678
    for i in range(20_000):
        var k: Float64
        if i % 501 == 0:
            k = -0.0
        elif i % 503 == 0:
            k = Float64(0.0) / Float64(0.0)  # NaN
        else:
            state3 = _lcg_next(state3)
            k = Float64(Int((state3 >> 33) % 3000)) * 0.5 - 200.0
        var slot_a = hi_a.get_or_assign(k, hi_a.size())
        var bits = normalize_bits(k)
        var slot_b = hi_b.get_or_assign_bits(bits, hash_bits(bits), hi_b.size())
        if slot_a != slot_b:
            probe_ok = False
    if hi_a.size() != hi_b.size():
        probe_ok = False
    var ci_a = CompositeKeyIndex(3, 64)
    var ci_b = CompositeKeyIndex(3, 64)
    var key3 = List[Float64](length=3, fill=0.0)
    for i in range(20_000):
        state3 = _lcg_next(state3)
        key3[0] = Float64(Int((state3 >> 33) % 40))
        state3 = _lcg_next(state3)
        key3[1] = Float64(Int((state3 >> 33) % 30)) - 15.0
        state3 = _lcg_next(state3)
        key3[2] = 0.0 if i % 97 == 0 else -0.0  # must collapse to one value
        var slot_a3 = ci_a.get_or_assign(key3, ci_a.size())
        var slot_b3 = ci_b.get_or_assign_hashed(
            key3, hash_composite(key3, 3), ci_b.size()
        )
        if slot_a3 != slot_b3:
            probe_ok = False
    if ci_a.size() != ci_b.size():
        probe_ok = False
    if probe_ok:
        passed += 1
        print("  ✅ get_or_assign_bits/_hashed == get_or_assign slot-for-slot, -0.0 and NaN included")
    else:
        failed += 1
        print("  ❌ a precomputed-hash probe diverged from the self-hashing one")

    # ── 4. batched width-N fast path == group_by_multi on null-free keys ───────
    # The existing suite's composite batch has null keys, so it exercises the
    # per-row slow path; this one has none, so the BLOCK hasher and
    # get_or_assign_hashed carry the whole scan. group_by_multi is round-1
    # machinery, untouched by round 3 — an independent reference.
    var statec: UInt64 = 0x0F1E2D3C4B5A6978
    var ck1 = List[Float64]()
    var ck2 = List[Float64]()
    var cv = List[Float64]()
    for _ in range(150_000):
        statec = _lcg_next(statec)
        ck1.append(Float64(Int((statec >> 33) % 70)))
        statec = _lcg_next(statec)
        ck2.append(Float64(Int((statec >> 33) % 40)) * 0.25)
        statec = _lcg_next(statec)
        cv.append(Float64(Int(statec >> 11)) / 9007199254740992.0)
    var cnames = List[String]()
    cnames.append("k1")
    cnames.append("k2")
    cnames.append("v")
    var ccols = List[Float64Array]()
    ccols.append(float64_from_list(ck1^))
    ccols.append(float64_from_list(ck2^))
    ccols.append(float64_from_list(cv^))
    var cbatch = RecordBatch(schema_of(cnames^), ccols^, 150_000)
    var kc2 = List[Int]()
    kc2.append(0)
    kc2.append(1)
    var cvc = List[Int]()
    cvc.append(2)
    var comp_ok = True
    var comp_ops = List[Int]()
    comp_ops.append(AGG_SUM)
    comp_ops.append(AGG_AVG)
    comp_ops.append(AGG_MIN)
    for oi in range(len(comp_ops)):
        var op = comp_ops[oi]
        var ops = List[Int]()
        ops.append(op)
        var f1 = group_by_many_parallel(cbatch, kc2, cvc, ops, 1)
        var m1 = group_by_multi_parallel(cbatch, kc2, 2, op, 1)
        var f8 = group_by_many_banded(cbatch, kc2, cvc, ops, 8)
        var m8 = group_by_multi_parallel(cbatch, kc2, 2, op, 8)
        if f1.n_groups() != m1.n_groups() or f8.n_groups() != m8.n_groups():
            comp_ok = False
            continue
        for g in range(m1.n_groups()):
            if f1.value_at(g, 0) != m1.values[g] or f1.count_at(g, 0) != m1.counts[g]:
                comp_ok = False
            if f8.value_at(g, 0) != m8.values[g] or f8.count_at(g, 0) != m8.counts[g]:
                comp_ok = False
        for i in range(len(m1.key_tuples)):
            if f1.key_tuples[i] != m1.key_tuples[i]:
                comp_ok = False
            if f8.key_tuples[i] != m8.key_tuples[i]:
                comp_ok = False
    if comp_ok:
        passed += 1
        print("  ✅ batched composite fast path == group_by_multi, serial and banded-8, sum/avg/min")
    else:
        failed += 1
        print("  ❌ the batched composite scan diverged from group_by_multi")

    # ── 5. counted scatter: clustered and reverse-clustered keys == serial ─────
    # Sorted keys concentrate whole partitions in single bands, leaving many
    # (worker, partition) cells EMPTY — the prefix sum's degenerate case. The
    # probe also under-reads here, so these go through the radix engine
    # directly, and owe serial bit-equality, order included.
    var vc2ops = List[Int]()
    vc2ops.append(AGG_AVG)
    vc2ops.append(AGG_VAR)
    var vc2cols = List[Int]()
    vc2cols.append(1)
    vc2cols.append(2)
    var sk = List[Float64]()
    var sv1 = List[Float64]()
    var sv2 = List[Float64]()
    var states: UInt64 = 0x5A5A5A5A5A5A5A5A
    for i in range(300_000):
        sk.append(Float64(i // 3))
        states = _lcg_next(states)
        sv1.append(Float64(Int(states >> 11)) / 9007199254740992.0)
        states = _lcg_next(states)
        sv2.append(Float64(Int(states >> 11)) / 9007199254740992.0)
    var rk = List[Float64]()
    for i in range(300_000):
        rk.append(Float64((300_000 - 1 - i) // 3))
    var snames = List[String]()
    snames.append("k")
    snames.append("v1")
    snames.append("v2")
    var scols = List[Float64Array]()
    var sv1a = float64_from_list(sv1^)
    var sv2a = float64_from_list(sv2^)
    scols.append(float64_from_list(sk^))
    scols.append(sv1a.copy())
    scols.append(sv2a.copy())
    var sorted_batch = RecordBatch(schema_of(snames^), scols^, 300_000)
    var rnames = List[String]()
    rnames.append("k")
    rnames.append("v1")
    rnames.append("v2")
    var rcols = List[Float64Array]()
    rcols.append(float64_from_list(rk^))
    rcols.append(sv1a^)
    rcols.append(sv2a^)
    var reverse_batch = RecordBatch(schema_of(rnames^), rcols^, 300_000)
    var s_serial = group_by_many_parallel(sorted_batch, k_only, vc2cols, vc2ops, 1)
    var s_radix = group_by_many_radix(sorted_batch, k_only, vc2cols, vc2ops, 8)
    var r_serial = group_by_many_parallel(reverse_batch, k_only, vc2cols, vc2ops, 1)
    var r_radix = group_by_many_radix(reverse_batch, k_only, vc2cols, vc2ops, 8)
    if (
        s_serial.n_groups() == 100_000
        and _many_identical_exact(s_serial, s_radix)
        and _many_identical_exact(r_serial, r_radix)
    ):
        passed += 1
        print("  ✅ counted scatter: clustered and reverse-clustered == serial bit-for-bit at 100k groups")
    else:
        failed += 1
        print("  ❌ the counted scatter diverged on clustered keys")

    # ── 6. counted scatter: tiny batches, odd workers, nulls, zero survivors ───
    var tiny_k = List[Float64]()
    var tiny_v = List[Float64]()
    for i in range(37):
        tiny_k.append(Float64(i % 10))
        tiny_v.append(Float64(i))
    var tiny = _single_key_batch(tiny_k, tiny_v)
    var sum1 = List[Int]()
    sum1.append(AGG_SUM)
    var tiny_s = group_by_many_parallel(tiny, k_only, vc1, sum1, 1)
    var tiny_r = group_by_many_radix(tiny, k_only, vc1, sum1, 8)

    var staten: UInt64 = 0x2468ACE13579BDF0
    var nk = List[Float64]()
    var nkm = List[Bool]()
    var nv1 = List[Float64]()
    var nm1 = List[Bool]()
    var nv2 = List[Float64]()
    var nm2 = List[Bool]()
    for i in range(200_000):
        staten = _lcg_next(staten)
        nk.append(Float64(Int((staten >> 33) % 50_000)))
        nkm.append(i % 97 != 0)
        staten = _lcg_next(staten)
        nv1.append(Float64(Int(staten >> 11)) / 9007199254740992.0)
        nm1.append(i % 7 != 0)
        staten = _lcg_next(staten)
        nv2.append(Float64(Int(staten >> 11)) / 9007199254740992.0)
        nm2.append(i % 13 != 0)
    var nnames = List[String]()
    nnames.append("k")
    nnames.append("v1")
    nnames.append("v2")
    var ncols = List[Float64Array]()
    ncols.append(float64_with_nulls(nk^, nkm))
    ncols.append(float64_with_nulls(nv1^, nm1))
    ncols.append(float64_with_nulls(nv2^, nm2))
    var nbatch = RecordBatch(schema_of(nnames^), ncols^, 200_000)
    var nops = List[Int]()
    nops.append(AGG_AVG)
    nops.append(AGG_MIN)
    var n_serial = group_by_many_parallel(nbatch, k_only, vc2cols, nops, 1)
    var n_radix7 = group_by_many_radix(nbatch, k_only, vc2cols, nops, 7)
    var n_radix8 = group_by_many_radix(nbatch, k_only, vc2cols, nops, 8)

    var allnull_k = List[Float64]()
    var allnull_m = List[Bool]()
    var allnull_v = List[Float64]()
    for i in range(70_000):
        allnull_k.append(Float64(i % 100))
        allnull_m.append(False)
        allnull_v.append(1.0)
    var anames = List[String]()
    anames.append("k")
    anames.append("v")
    var acols = List[Float64Array]()
    acols.append(float64_with_nulls(allnull_k^, allnull_m))
    acols.append(float64_from_list(allnull_v^))
    var allnull = RecordBatch(schema_of(anames^), acols^, 70_000)
    var an_radix = group_by_many_radix(allnull, k_only, vc1, sum1, 8)
    if (
        _many_identical_exact(tiny_s, tiny_r)
        and _many_identical_exact(n_serial, n_radix7)
        and _many_identical_exact(n_serial, n_radix8)
        and an_radix.n_groups() == 0
        and an_radix.null_key_rows == 70_000
    ):
        passed += 1
        print("  ✅ counted scatter: 37 rows/8 workers, 7 workers, null keys+values, zero survivors")
    else:
        failed += 1
        print("  ❌ a counted-scatter edge shape diverged from serial")

    # ── 7. all 7 opcodes through the counted scatter at 50k groups ─────────────
    # Radix owes bit-equality to group_by (round-1 machinery) per opcode; the
    # existing suite pins 4 opcodes on this shape, this pins the full set.
    var stateo: UInt64 = 0x13579BDF02468ACE
    var ok_keys = List[Float64]()
    var ok_vals = List[Float64]()
    for _ in range(250_000):
        stateo = _lcg_next(stateo)
        ok_keys.append(Float64(Int((stateo >> 33) % 50_000)))
        stateo = _lcg_next(stateo)
        ok_vals.append(Float64(Int(stateo >> 11)) / 9007199254740992.0)
    var obatch = _single_key_batch(ok_keys, ok_vals)
    var all_ops_ok = True
    for oi in range(len(all_ops)):
        var op = all_ops[oi]
        var ops = List[Int]()
        ops.append(op)
        var rad = group_by_many_radix(obatch, k_only, vc1, ops, 8)
        var reference = group_by_parallel(obatch, 0, 1, op, 1)
        if not _many_matches_grouped(rad, 0, reference):
            all_ops_ok = False
    if all_ops_ok:
        passed += 1
        print("  ✅ radix == group_by serial for all 7 opcodes at 50k groups, bit-exact")
    else:
        failed += 1
        print("  ❌ an opcode diverged through the counted scatter")

    # ── 8. the routing table, entry by entry ───────────────────────────────────
    var route_ok = True
    # Small integral codes 0..99 -> CODED with bound 100.
    var codes_k = List[Float64]()
    var codes_v = List[Float64]()
    var stater: UInt64 = 0x9999AAAABBBBCCCC
    for _ in range(100_000):
        stater = _lcg_next(stater)
        codes_k.append(Float64(Int((stater >> 33) % 100)))
        stater = _lcg_next(stater)
        codes_v.append(Float64(Int((stater >> 33) % 1000)))
    var coded_batch = _single_key_batch(codes_k, codes_v)
    var p1 = plan_many_route(coded_batch, k_only, 8)
    if p1.route != ROUTE_CODED or p1.coded_bound != 100:
        route_ok = False
        print("  [route] small codes:", p1.route, p1.coded_bound)
    # The same keys shifted by 0.5 are not codes -> BANDED.
    var half_k = List[Float64]()
    for i in range(100_000):
        half_k.append(codes_k[i] + 0.5)
    var half_batch = _single_key_batch(half_k, codes_v)
    var p2 = plan_many_route(half_batch, k_only, 8)
    if p2.route != ROUTE_BANDED or p2.coded_bound != 0:
        route_ok = False
        print("  [route] non-integral:", p2.route)
    # Negative integral keys are not codes -> BANDED.
    var neg_k = List[Float64]()
    for i in range(100_000):
        neg_k.append(0.0 - codes_k[i] - 1.0)
    var neg_batch = _single_key_batch(neg_k, codes_v)
    if plan_many_route(neg_batch, k_only, 8).route != ROUTE_BANDED:
        route_ok = False
        print("  [route] negative codes routed wrong")
    # Integral but past the dense-array ceiling -> not coded; high cardinality
    # -> RADIX. This batch is deliberately RAGGED (200k keys over a 100k value
    # column): rows past the value column's end have always read as null
    # through is_valid_at's bounds check, and the pointer fast paths must not
    # turn that into an out-of-bounds read — block 9 compares the routed
    # answer against serial on exactly this shape.
    var big_k = List[Float64]()
    for _ in range(200_000):
        stater = _lcg_next(stater)
        big_k.append(Float64(Int((stater >> 33) % 100_000)))
    var big_batch = _single_key_batch(big_k, codes_v)
    var p3 = plan_many_route(big_batch, k_only, 8)
    if p3.route != ROUTE_RADIX or p3.coded_bound != 0:
        route_ok = False
        print("  [route] 100k integral keys:", p3.route)
    # Exactly MAX_CODED_CARDINALITY - 1 as a key -> CODED at the full bound;
    # exactly MAX_CODED_CARDINALITY -> BANDED (one distinct key, low card).
    var edge_k = List[Float64]()
    var edge_v = List[Float64]()
    for _ in range(70_000):
        edge_k.append(Float64(MAX_CODED_CARDINALITY - 1))
        edge_v.append(1.0)
    var edge_batch = _single_key_batch(edge_k, edge_v)
    var p4 = plan_many_route(edge_batch, k_only, 8)
    if p4.route != ROUTE_CODED or p4.coded_bound != MAX_CODED_CARDINALITY:
        route_ok = False
        print("  [route] bound edge:", p4.route, p4.coded_bound)
    var over_k = List[Float64]()
    for _ in range(70_000):
        over_k.append(Float64(MAX_CODED_CARDINALITY))
    var over_batch = _single_key_batch(over_k, edge_v)
    if plan_many_route(over_batch, k_only, 8).route != ROUTE_BANDED:
        route_ok = False
        print("  [route] over-ceiling key routed wrong")
    # Composite keys are never coded -> BANDED at low cardinality.
    if plan_many_route(cbatch, kc2, 8).route != ROUTE_BANDED:
        route_ok = False
        print("  [route] composite routed wrong")
    # One worker -> SERIAL; width 0 -> SERIAL.
    if plan_many_route(coded_batch, k_only, 1).route != ROUTE_SERIAL:
        route_ok = False
    if plan_many_route(coded_batch, List[Int](), 8).route != ROUTE_SERIAL:
        route_ok = False
    # An all-null key window offers no coded evidence -> BANDED.
    if plan_many_route(allnull, k_only, 8).route != ROUTE_BANDED:
        route_ok = False
        print("  [route] all-null keys routed wrong")
    if probe_coded_bound(allnull, 0, CARDINALITY_PROBE_ROWS) != -1:
        route_ok = False
    # The early-exit probe answers exactly `probe_cardinality >= threshold`:
    # 100 distinct codes clear 100, miss 101; the 100k-key batch clears the
    # radix threshold.
    if not probe_at_least(coded_batch, k_only, CARDINALITY_PROBE_ROWS, 100):
        route_ok = False
    if probe_at_least(coded_batch, k_only, CARDINALITY_PROBE_ROWS, 101):
        route_ok = False
    if not probe_at_least(big_batch, k_only, CARDINALITY_PROBE_ROWS, 8192):
        route_ok = False
    if route_ok:
        passed += 1
        print("  ✅ routing table: coded/banded/radix/serial answers per shape, bounds included")
    else:
        failed += 1
        print("  ❌ a routing-table entry is wrong")

    # ── 9. the routed entry point answers like serial on every routed shape ────
    var wire_ok = True
    var routed_coded = group_by_many_parallel(coded_batch, k_only, vc1, sum1, 8)
    var serial_coded = group_by_many_parallel(coded_batch, k_only, vc1, sum1, 1)
    if not _many_identical_exact(routed_coded, serial_coded):
        wire_ok = False
    var routed_banded = group_by_many_parallel(half_batch, k_only, vc1, sum1, 8)
    var serial_banded = group_by_many_parallel(half_batch, k_only, vc1, sum1, 1)
    if not _many_identical_exact(routed_banded, serial_banded):
        wire_ok = False
    var routed_radix = group_by_many_parallel(big_batch, k_only, vc1, sum1, 8)
    var serial_radix = group_by_many_parallel(big_batch, k_only, vc1, sum1, 1)
    if not _many_identical_exact(routed_radix, serial_radix):
        wire_ok = False
    if wire_ok:
        passed += 1
        print("  ✅ routed == serial, bit-exact, on the coded, banded and radix shapes")
    else:
        failed += 1
        print("  ❌ a routed engine disagreed with the serial path")

    # ── 10. the refusal fallback: a probe window that lies ─────────────────────
    # Clean codes for the whole 64k window, then a giant integral key at row
    # 150k: the plan says CODED, the coded engine refuses mid-scan, and the
    # entry point must fall back and still return the hash engines' exact
    # answer — including the giant key as an ordinary group.
    var liar_k = List[Float64]()
    var liar_v = List[Float64]()
    var statel: UInt64 = 0xDDDDEEEEFFFF0000
    for i in range(200_000):
        if i == 150_000:
            liar_k.append(1e9)
        else:
            statel = _lcg_next(statel)
            liar_k.append(Float64(Int((statel >> 33) % 50)))
        statel = _lcg_next(statel)
        liar_v.append(Float64(Int((statel >> 33) % 1000)))
    var liar = _single_key_batch(liar_k, liar_v)
    var pl = plan_many_route(liar, k_only, 8)
    var liar_routed = group_by_many_parallel(liar, k_only, vc1, sum1, 8)
    var liar_serial = group_by_many_parallel(liar, k_only, vc1, sum1, 1)
    if (
        pl.route == ROUTE_CODED  # the window really does lie
        and liar_routed.n_groups() == 51
        and _many_identical_exact(liar_routed, liar_serial)
    ):
        passed += 1
        print("  ✅ a lying probe window: plan says coded, scan refuses, fallback answers exactly")
    else:
        failed += 1
        print("  ❌ the refusal fallback broke:", pl.route, liar_routed.n_groups())

    # ── 11. word-wise count_valid == a per-bit walk on multi-word bitmaps ──────
    # Round 3 made count_valid word-wise because the null hoisting put it on
    # every scan's serial prefix. The pre-existing validity suite only builds
    # bitmaps under 64 bits, where the word loop never runs (a dropped-last-
    # word sabotage passed it 17/17) — so the word path is pinned HERE against
    # the per-bit definition, across sizes that cover 0, 1 and many words plus
    # every partial-byte remainder.
    var cv_ok = True
    var sizes = List[Int]()
    sizes.append(1)
    sizes.append(63)
    sizes.append(64)
    sizes.append(65)
    sizes.append(127)
    sizes.append(128)
    sizes.append(1000)
    sizes.append(1024)
    sizes.append(4099)
    for si in range(len(sizes)):
        var n = sizes[si]
        var bitmap = new_all_valid(n)
        # Punch a deterministic pattern of nulls, including in the last word.
        for i in range(n):
            if i % 3 == 0 or i == n - 1:
                set_null(bitmap, i)
        var expect = 0
        for i in range(n):
            if is_valid(bitmap, i):
                expect += 1
        if count_valid(bitmap, n) != expect:
            cv_ok = False
            print("  [count_valid] n =", n, "got", count_valid(bitmap, n), "want", expect)
        var full = new_all_valid(n)
        if count_valid(full, n) != n:
            cv_ok = False
            print("  [count_valid] all-valid n =", n, "got", count_valid(full, n))
    if cv_ok:
        passed += 1
        print("  ✅ count_valid word path == per-bit walk at 1..4099 slots, nulls in every word")
    else:
        failed += 1
        print("  ❌ the word-wise count_valid miscounted a multi-word bitmap")

    # ── NaN VALUES through the specialized extremum paths ─────────────────────
    # The #459 policy: a NaN value counts, poisons sum/mean/m2 associatively, and
    # contributes to NO extremum. The full `observe` carries the guard; this block
    # exists because the specialized `observe_min`/`observe_max` initially did NOT,
    # which would have resurrected the exact defect #459 fixed. NaN KEYS are
    # covered above; this is NaN in the VALUES, per specialized path.
    var nan_v = Float64(0.0) / Float64(0.0)
    var vseq = List[Float64]()
    vseq.append(3.0)
    vseq.append(nan_v)
    vseq.append(1.0)
    var acc_full = GroupAccumulator(0.0)
    var acc_min = GroupAccumulator(0.0)
    var acc_max = GroupAccumulator(0.0)
    var acc_op = GroupAccumulator(0.0)
    for i in range(len(vseq)):
        acc_full.observe(vseq[i])
        acc_min.observe_min(vseq[i])
        acc_max.observe_max(vseq[i])
        acc_op.observe_op(AGG_MIN, vseq[i])
    var nan_ok = True
    if acc_min.minimum != 1.0 or not acc_min.seen:
        nan_ok = False
        print("  [nan-values] observe_min got", acc_min.minimum, "want 1.0 (live min)")
    if acc_max.maximum != 3.0 or not acc_max.seen:
        nan_ok = False
        print("  [nan-values] observe_max got", acc_max.maximum, "want 3.0 (live max)")
    if acc_op.minimum != acc_full.minimum:
        nan_ok = False
        print("  [nan-values] observe_op(AGG_MIN)", acc_op.minimum, "!= observe", acc_full.minimum)
    if acc_min.count != 3:
        nan_ok = False
        print("  [nan-values] NaN must still COUNT: got", acc_min.count, "want 3")
    # NaN-FIRST is the order that poisoned #456: the seed position must not matter.
    var acc_first = GroupAccumulator(0.0)
    acc_first.observe_min(nan_v)
    acc_first.observe_min(5.0)
    acc_first.observe_min(2.0)
    if acc_first.minimum != 2.0 or not acc_first.seen:
        nan_ok = False
        print("  [nan-values] NaN-first observe_min got", acc_first.minimum, "want 2.0")
    if nan_ok:
        passed += 1
        print("  ✅ NaN values contribute to no extremum on the specialized paths, in any order")
    else:
        failed += 1
        print("  ❌ a NaN value reached a specialized extremum — the #459 defect is back")

    print("  [query.aggregate round3] Passed:", passed, "Failed:", failed)
    if failed > 0:
        raise Error("test_query_aggregate_round3: " + String(failed) + " failure(s)")
