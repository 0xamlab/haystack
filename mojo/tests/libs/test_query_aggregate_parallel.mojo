"""test_query_aggregate_parallel.mojo — the parallel grouping path against the serial one.

Hand-written. Every assertion here holds the DATA fixed and varies only the worker
count, because that is the one thing the parallel path changes. What must survive:

  * the group SET and its first-appearance ORDER — exactly, for every worker count;
  * counts, min and max — bit-identical (no association to reorder), INCLUDING
    when NaN sits among the values: a NaN names no extremum (module header,
    "NaN values and the extrema"), because the pre-policy fold was
    order-dependent — a band whose first row was NaN reported a NaN extremum
    and the merge then silently dropped every live value that band had folded,
    so the same data answered differently at different worker counts;
  * sums — exactly, on integer-valued data (every partial is exactly representable,
    so association cannot change the answer, which makes exact equality a fair gate);
  * mean/variance/std on continuous data — the parallel-Welford merge against the
    sequential fold, within a stated tolerance (1e-9 relative), with the
    between-bands m2 term pinned by a known-value case a naive `m2_a + m2_b`
    merge gets exactly wrong;
  * bit-reproducibility — same inputs, same worker count, twice;
  * the crossover — `planned_workers` refuses to fan out below PARALLEL_MIN_ROWS.

Data is generated by a fixed-seed LCG in this file, so failures reproduce.
"""
from std.math import isnan, sqrt

from columnar.array import Float64Array, float64_from_list, float64_with_nulls
from columnar.batch import RecordBatch, schema_of
from numeric.contract import AGG_AVG, AGG_COUNT, AGG_MAX, AGG_MIN, AGG_SUM, AGG_VAR
from query.aggregate import (
    GroupAccumulator,
    GroupedResult,
    MultiGroupedResult,
    PARALLEL_MIN_ROWS,
    group_by,
    group_by_multi,
    group_by_multi_parallel,
    group_by_parallel,
    planned_workers,
)


fn _lcg_next(state: UInt64) -> UInt64:
    return state * 6364136223846793005 + 1442695040888963407


fn _batch_random_ints(n_rows: Int, n_groups: Int, with_nulls: Bool) -> RecordBatch:
    """`key` in 0..n_groups-1, `value` an integer in 0..999 — sums stay exact.

    With `with_nulls`, every 97th key and every 13th value is null, so the
    parallel path is exercised on exclusion and on null values, not just on the
    clean case.
    """
    var state: UInt64 = 0x9E3779B97F4A7C15
    var keys = List[Float64]()
    var key_mask = List[Bool]()
    var values = List[Float64]()
    var value_mask = List[Bool]()
    for i in range(n_rows):
        state = _lcg_next(state)
        keys.append(Float64(Int((state >> 33) % UInt64(n_groups))))
        key_mask.append(not (with_nulls and i % 97 == 0))
        state = _lcg_next(state)
        values.append(Float64(Int((state >> 33) % 1000)))
        value_mask.append(not (with_nulls and i % 13 == 0))

    var names = List[String]()
    names.append("k")
    names.append("v")
    var cols = List[Float64Array]()
    cols.append(float64_with_nulls(keys^, key_mask))
    cols.append(float64_with_nulls(values^, value_mask))
    return RecordBatch(schema_of(names^), cols^, n_rows)


fn _batch_continuous(n_rows: Int, n_groups: Int) -> RecordBatch:
    """Continuous values in [0, 1) — the Welford tolerance case."""
    var state: UInt64 = 0xDEADBEEFCAFEF00D
    var keys = List[Float64]()
    var values = List[Float64]()
    for _ in range(n_rows):
        state = _lcg_next(state)
        keys.append(Float64(Int((state >> 33) % UInt64(n_groups))))
        state = _lcg_next(state)
        values.append(Float64(Int(state >> 11)) / 9007199254740992.0)

    var names = List[String]()
    names.append("k")
    names.append("v")
    var cols = List[Float64Array]()
    cols.append(float64_from_list(keys^))
    cols.append(float64_from_list(values^))
    return RecordBatch(schema_of(names^), cols^, n_rows)


fn _grouped_identical_exact(a: GroupedResult, b: GroupedResult) -> Bool:
    """Same groups, same ORDER, bit-equal values/counts, same null tally."""
    if a.n_groups() != b.n_groups() or a.null_key_rows != b.null_key_rows:
        return False
    for i in range(a.n_groups()):
        if a.keys[i] != b.keys[i]:
            return False
        if a.counts[i] != b.counts[i]:
            return False
        if a.present[i] != b.present[i]:
            return False
        if a.values[i] != b.values[i]:
            return False
    return True


fn _grouped_close(a: GroupedResult, b: GroupedResult, rel_tol: Float64) -> Bool:
    """Same groups/order/counts exactly; values within relative tolerance."""
    if a.n_groups() != b.n_groups() or a.null_key_rows != b.null_key_rows:
        return False
    for i in range(a.n_groups()):
        if a.keys[i] != b.keys[i] or a.counts[i] != b.counts[i]:
            return False
        if a.present[i] != b.present[i]:
            return False
        var scale = a.values[i] if a.values[i] > 0.0 else -a.values[i]
        if scale < 1.0:
            scale = 1.0
        var delta = a.values[i] - b.values[i]
        if delta < 0.0:
            delta = -delta
        if delta > rel_tol * scale:
            return False
    return True


fn _multi_identical_exact(a: MultiGroupedResult, b: MultiGroupedResult) -> Bool:
    if a.n_groups() != b.n_groups() or a.key_width != b.key_width:
        return False
    if a.null_key_rows != b.null_key_rows:
        return False
    for i in range(len(a.key_tuples)):
        if a.key_tuples[i] != b.key_tuples[i]:
            return False
    for i in range(a.n_groups()):
        if a.counts[i] != b.counts[i] or a.values[i] != b.values[i]:
            return False
        if a.present[i] != b.present[i]:
            return False
    return True


fn main() raises:
    var passed = 0
    var failed = 0

    # ── the crossover: planned_workers refuses to fan out on small inputs ──────
    if (
        planned_workers(PARALLEL_MIN_ROWS - 1, 16) == 1
        and planned_workers(PARALLEL_MIN_ROWS, 16) == 16
        and planned_workers(100, 16) == 1
        and planned_workers(PARALLEL_MIN_ROWS, 0) == 1
        and planned_workers(PARALLEL_MIN_ROWS, -3) == 1
        and planned_workers(PARALLEL_MIN_ROWS, PARALLEL_MIN_ROWS * 2) == PARALLEL_MIN_ROWS
    ):
        passed += 1
        print("  ✅ planned_workers: 1 below PARALLEL_MIN_ROWS, honoured+clamped above")
    else:
        failed += 1
        print(
            "  ❌ planned_workers crossover wrong:",
            planned_workers(PARALLEL_MIN_ROWS - 1, 16),
            planned_workers(PARALLEL_MIN_ROWS, 16),
        )

    # ── integer data: parallel == serial EXACTLY, including group order ───────
    # 200k rows, 100 groups, nulls in both columns. Integer values make every
    # partial sum exactly representable, so any association gives the same sum —
    # equality here is exact by right, not by luck.
    var ints = _batch_random_ints(200_000, 100, True)
    var s_sum = group_by_parallel(ints, 0, 1, AGG_SUM, 1)
    var p_sum = group_by_parallel(ints, 0, 1, AGG_SUM, 8)
    if s_sum.n_groups() == 100 and _grouped_identical_exact(s_sum, p_sum):
        passed += 1
        print("  ✅ 8-worker sums: group set, order, counts and totals all exact")
    else:
        failed += 1
        print("  ❌ parallel sum diverged:", s_sum.n_groups(), p_sum.n_groups())

    var s_count = group_by_parallel(ints, 0, 1, AGG_COUNT, 1)
    var p_count = group_by_parallel(ints, 0, 1, AGG_COUNT, 8)
    var s_min = group_by_parallel(ints, 0, 1, AGG_MIN, 1)
    var p_min = group_by_parallel(ints, 0, 1, AGG_MIN, 8)
    var s_max = group_by_parallel(ints, 0, 1, AGG_MAX, 1)
    var p_max = group_by_parallel(ints, 0, 1, AGG_MAX, 8)
    if (
        _grouped_identical_exact(s_count, p_count)
        and _grouped_identical_exact(s_min, p_min)
        and _grouped_identical_exact(s_max, p_max)
    ):
        passed += 1
        print("  ✅ counts, min and max are bit-identical across worker counts")
    else:
        failed += 1
        print("  ❌ count/min/max diverged under parallelism")

    # ── the auto path agrees with the explicit serial path on the same data ───
    var auto_sum = group_by(ints, 0, 1, AGG_SUM)
    if _grouped_identical_exact(s_sum, auto_sum):
        passed += 1
        print("  ✅ group_by (auto workers) matches the serial result exactly")
    else:
        failed += 1
        print("  ❌ auto-planned group_by diverged from serial")

    # ── continuous data: Welford merge within stated tolerance ────────────────
    var cont = _batch_continuous(200_000, 64)
    var s_var = group_by_parallel(cont, 0, 1, AGG_VAR, 1)
    var p_var = group_by_parallel(cont, 0, 1, AGG_VAR, 8)
    var s_avg = group_by_parallel(cont, 0, 1, AGG_AVG, 1)
    var p_avg = group_by_parallel(cont, 0, 1, AGG_AVG, 8)
    if _grouped_close(s_var, p_var, 1e-9) and _grouped_close(s_avg, p_avg, 1e-9):
        passed += 1
        print("  ✅ mean and variance: parallel-Welford within 1e-9 of the serial fold")
    else:
        failed += 1
        print("  ❌ Welford merge drifted beyond 1e-9")

    # ── the between-bands m2 term, pinned by a known value ────────────────────
    # One group, [0 x4, 10 x4], split at the band boundary by 2 workers: each
    # band has m2 = 0, so a naive m2_a + m2_b merge reports variance 0. The true
    # combined m2 is 200 (mean 5, eight squared deviations of 25), variance
    # 200/7. This is the assertion that bites on a wrong merge.
    var bimodal_values = List[Float64]()
    var bimodal_keys = List[Float64]()
    for i in range(8):
        bimodal_keys.append(1.0)
        bimodal_values.append(0.0 if i < 4 else 10.0)
    var bnames = List[String]()
    bnames.append("k")
    bnames.append("v")
    var bcols = List[Float64Array]()
    bcols.append(float64_from_list(bimodal_keys^))
    bcols.append(float64_from_list(bimodal_values^))
    var bimodal = RecordBatch(schema_of(bnames^), bcols^, 8)
    var bi_var = group_by_parallel(bimodal, 0, 1, AGG_VAR, 2)
    var want = 200.0 / 7.0
    var got = bi_var.values[0]
    var vdelta = got - want
    if vdelta < 0.0:
        vdelta = -vdelta
    if bi_var.n_groups() == 1 and vdelta < 1e-12:
        passed += 1
        print("  ✅ two zero-m2 bands with different means merge to variance 200/7")
    else:
        failed += 1
        print("  ❌ between-bands m2 term wrong: got", got, "want", want)

    # ── bit-reproducibility at a fixed worker count ────────────────────────────
    var again = group_by_parallel(cont, 0, 1, AGG_VAR, 8)
    if _grouped_identical_exact(p_var, again):
        passed += 1
        print("  ✅ same inputs, same worker count, twice: bit-identical")
    else:
        failed += 1
        print("  ❌ parallel grouping is not reproducible run to run")

    # ── group order is global first-appearance order under parallelism ────────
    # Keys ascend with the row index, so each band introduces new groups; a merge
    # in anything but band order would interleave them wrongly.
    var ordered_keys = List[Float64]()
    var ordered_values = List[Float64]()
    for i in range(80_000):
        ordered_keys.append(Float64(i // 10_000))
        ordered_values.append(1.0)
    var onames = List[String]()
    onames.append("k")
    onames.append("v")
    var ocols = List[Float64Array]()
    ocols.append(float64_from_list(ordered_keys^))
    ocols.append(float64_from_list(ordered_values^))
    var ordered = RecordBatch(schema_of(onames^), ocols^, 80_000)
    var o_par = group_by_parallel(ordered, 0, 1, AGG_COUNT, 8)
    var order_ok = o_par.n_groups() == 8
    for i in range(o_par.n_groups()):
        if o_par.keys[i] != Float64(i) or o_par.counts[i] != 10_000.0:
            order_ok = False
    if order_ok:
        passed += 1
        print("  ✅ groups come back in global first-appearance order, 8 workers")
    else:
        failed += 1
        print("  ❌ parallel merge broke first-appearance order")

    # ── adversarial shapes: all one group, and every row its own group ─────────
    var one_keys = List[Float64]()
    var one_values = List[Float64]()
    for i in range(100_000):
        one_keys.append(7.0)
        one_values.append(Float64(i % 100))
    var g1names = List[String]()
    g1names.append("k")
    g1names.append("v")
    var g1cols = List[Float64Array]()
    g1cols.append(float64_from_list(one_keys^))
    g1cols.append(float64_from_list(one_values^))
    var one_group = RecordBatch(schema_of(g1names^), g1cols^, 100_000)
    var one_s = group_by_parallel(one_group, 0, 1, AGG_SUM, 1)
    var one_p = group_by_parallel(one_group, 0, 1, AGG_SUM, 8)

    var distinct_keys = List[Float64]()
    var distinct_values = List[Float64]()
    for i in range(100_000):
        distinct_keys.append(Float64(i))
        distinct_values.append(3.0)
    var gdnames = List[String]()
    gdnames.append("k")
    gdnames.append("v")
    var gdcols = List[Float64Array]()
    gdcols.append(float64_from_list(distinct_keys^))
    gdcols.append(float64_from_list(distinct_values^))
    var distinct = RecordBatch(schema_of(gdnames^), gdcols^, 100_000)
    var dis_s = group_by_parallel(distinct, 0, 1, AGG_SUM, 1)
    var dis_p = group_by_parallel(distinct, 0, 1, AGG_SUM, 8)
    if (
        one_p.n_groups() == 1
        and _grouped_identical_exact(one_s, one_p)
        and dis_p.n_groups() == 100_000
        and _grouped_identical_exact(dis_s, dis_p)
    ):
        passed += 1
        print("  ✅ all-one-group and all-distinct both merge exactly")
    else:
        failed += 1
        print("  ❌ adversarial shapes diverged:", one_p.n_groups(), dis_p.n_groups())

    # ── more workers than rows, and non-positive worker counts ────────────────
    var tiny = _batch_random_ints(10, 3, False)
    var tiny_s = group_by_parallel(tiny, 0, 1, AGG_SUM, 1)
    var tiny_p = group_by_parallel(tiny, 0, 1, AGG_SUM, 64)
    var tiny_z = group_by_parallel(tiny, 0, 1, AGG_SUM, 0)
    if _grouped_identical_exact(tiny_s, tiny_p) and _grouped_identical_exact(
        tiny_s, tiny_z
    ):
        passed += 1
        print("  ✅ 64 workers on 10 rows clamps; 0 workers means 1, not a crash")
    else:
        failed += 1
        print("  ❌ worker clamping wrong on a tiny batch")

    # ── multi-key: parallel == serial exactly, tuples and order included ───────
    var mkeys1 = List[Float64]()
    var mkeys2 = List[Float64]()
    var mvalues = List[Float64]()
    var mvalue_mask = List[Bool]()
    var mkey_mask = List[Bool]()
    var state: UInt64 = 0x1234ABCD5678EF90
    for i in range(150_000):
        state = _lcg_next(state)
        mkeys1.append(Float64(Int((state >> 33) % 40)))
        state = _lcg_next(state)
        mkeys2.append(Float64(Int((state >> 33) % 25)))
        state = _lcg_next(state)
        mvalues.append(Float64(Int((state >> 33) % 500)))
        mkey_mask.append(i % 89 != 0)
        mvalue_mask.append(i % 11 != 0)
    var mnames = List[String]()
    mnames.append("k1")
    mnames.append("k2")
    mnames.append("v")
    var mcols = List[Float64Array]()
    mcols.append(float64_with_nulls(mkeys1^, mkey_mask))
    mcols.append(float64_from_list(mkeys2^))
    mcols.append(float64_with_nulls(mvalues^, mvalue_mask))
    var mbatch = RecordBatch(schema_of(mnames^), mcols^, 150_000)
    var key_cols = List[Int]()
    key_cols.append(0)
    key_cols.append(1)
    var m_s = group_by_multi_parallel(mbatch, key_cols, 2, AGG_SUM, 1)
    var m_p = group_by_multi_parallel(mbatch, key_cols, 2, AGG_SUM, 8)
    var m_auto = group_by_multi(mbatch, key_cols, 2, AGG_SUM)
    if (
        m_s.n_groups() == 1000
        and _multi_identical_exact(m_s, m_p)
        and _multi_identical_exact(m_s, m_auto)
    ):
        passed += 1
        print("  ✅ multi-key: 1000 composite groups exact across 1/8/auto workers")
    else:
        failed += 1
        print("  ❌ multi-key parallel diverged:", m_s.n_groups(), m_p.n_groups())

    var m_s_count = group_by_multi_parallel(mbatch, key_cols, 2, AGG_COUNT, 1)
    var m_p_count = group_by_multi_parallel(mbatch, key_cols, 2, AGG_COUNT, 8)
    if (
        _multi_identical_exact(m_s_count, m_p_count)
        and m_p_count.null_key_rows == m_s_count.null_key_rows
        and m_p_count.null_key_rows > 0
    ):
        passed += 1
        print("  ✅ multi-key counts and null-key exclusions match exactly")
    else:
        failed += 1
        print("  ❌ multi-key counts/null tally diverged")

    # ── width == 0 stays one-group-over-everything on every worker count ───────
    var no_keys = List[Int]()
    var w0_s = group_by_multi_parallel(mbatch, no_keys, 2, AGG_SUM, 1)
    var w0_p = group_by_multi_parallel(mbatch, no_keys, 2, AGG_SUM, 8)
    if (
        w0_s.n_groups() == 0
        and len(w0_s.values) == 1
        and len(w0_p.values) == 1
        and w0_s.values[0] == w0_p.values[0]
    ):
        passed += 1
        print("  ✅ zero key columns: one total, identical on any worker count")
    else:
        failed += 1
        print("  ❌ width-0 grouping diverged under parallelism")

    # ── an all-null key column yields zero groups, all rows tallied ────────────
    var an_keys = List[Float64]()
    var an_values = List[Float64]()
    var an_mask = List[Bool]()
    for i in range(70_000):
        an_keys.append(0.0)
        an_values.append(Float64(i))
        an_mask.append(False)
    var annames = List[String]()
    annames.append("k")
    annames.append("v")
    var ancols = List[Float64Array]()
    ancols.append(float64_with_nulls(an_keys^, an_mask))
    ancols.append(float64_from_list(an_values^))
    var an_batch = RecordBatch(schema_of(annames^), ancols^, 70_000)
    var an_p = group_by_parallel(an_batch, 0, 1, AGG_SUM, 8)
    if an_p.n_groups() == 0 and an_p.null_key_rows == 70_000:
        passed += 1
        print("  ✅ 70k all-null keys: zero groups, every exclusion counted once")
    else:
        failed += 1
        print("  ❌ null-key tally wrong:", an_p.n_groups(), an_p.null_key_rows)

    # ── NaN among the VALUES: min/max identical at every worker count ─────────
    # keys all 7.0; values [3, 5, 9, NaN, 1, 2]. At 2 workers the second band is
    # [NaN, 1, 2] — its first row is NaN, which under the pre-policy fold seeded
    # a sticky NaN band extremum that the merge then dropped, LOSING the live 1
    # and 2 and answering min = 3. The skip-NaN policy makes every banding
    # answer exactly what the serial fold answers: min 1, max 9.
    var nan = sqrt(Float64(-1.0))
    var nan_keys = List[Float64]()
    var nan_values = List[Float64]()
    nan_values.append(3.0)
    nan_values.append(5.0)
    nan_values.append(9.0)
    nan_values.append(nan)
    nan_values.append(1.0)
    nan_values.append(2.0)
    for _ in range(6):
        nan_keys.append(7.0)
    var nannames = List[String]()
    nannames.append("k")
    nannames.append("v")
    var nancols = List[Float64Array]()
    nancols.append(float64_from_list(nan_keys^))
    nancols.append(float64_from_list(nan_values^))
    var nan_batch = RecordBatch(schema_of(nannames^), nancols^, 6)
    var nan_ok = True
    for w in range(1, 4):
        var w_min = group_by_parallel(nan_batch, 0, 1, AGG_MIN, w)
        var w_max = group_by_parallel(nan_batch, 0, 1, AGG_MAX, w)
        if w_min.values[0] != 1.0 or w_max.values[0] != 9.0:
            nan_ok = False
            print(
                "  ❌ at workers=", w, ": min=", w_min.values[0],
                " max=", w_max.values[0], " (want 1 and 9)",
            )
    if nan_ok:
        passed += 1
        print("  ✅ a NaN value cannot poison a band: min 1 / max 9 at 1, 2, 3 workers")
    else:
        failed += 1

    # ── the same mechanism through the PUBLIC, auto-planned path ──────────────
    # 65536 rows (= PARALLEL_MIN_ROWS, so group_by fans out), one group, NaN at
    # row 61440 — the first row of the last band when 16 workers split evenly —
    # and the unique global minimum 1.0 immediately after it. The machine's core
    # count must not change the answer.
    var pub_keys = List[Float64](capacity=65536)
    var pub_values = List[Float64](capacity=65536)
    for i in range(65536):
        pub_keys.append(7.0)
        if i == 61440:
            pub_values.append(nan)
        elif i == 61441:
            pub_values.append(1.0)
        else:
            pub_values.append(5.0 + Float64(i % 3))
    var pubnames = List[String]()
    pubnames.append("k")
    pubnames.append("v")
    var pubcols = List[Float64Array]()
    pubcols.append(float64_from_list(pub_keys^))
    pubcols.append(float64_from_list(pub_values^))
    var pub_batch = RecordBatch(schema_of(pubnames^), pubcols^, 65536)
    var pub_serial = group_by_parallel(pub_batch, 0, 1, AGG_MIN, 1)
    var pub_auto = group_by(pub_batch, 0, 1, AGG_MIN)
    var pub_16 = group_by_parallel(pub_batch, 0, 1, AGG_MIN, 16)
    if (
        pub_serial.values[0] == 1.0
        and pub_auto.values[0] == 1.0
        and pub_16.values[0] == 1.0
    ):
        passed += 1
        print("  ✅ NaN at a band start: public group_by still finds the true min 1.0")
    else:
        failed += 1
        print(
            "  ❌ auto-planned min diverges from serial on NaN values:",
            pub_serial.values[0], pub_auto.values[0], pub_16.values[0],
        )

    # ── merge_from: a side whose values were all NaN carries no extremum ───────
    # Its stale minimum/maximum fields hold 0.0; folding those in would invent a
    # value nobody observed (the old merge did exactly that with the poisoned
    # NaN). Both directions: NaN-only into live, live into NaN-only. The sum
    # stays poisoned and the count still tallies — NaN is a value, not a null.
    var live = GroupAccumulator(1.0)
    live.observe(4.0)
    live.observe(8.0)
    var nan_only = GroupAccumulator(1.0)
    nan_only.observe(nan)
    live.merge_from(nan_only)
    var adopt = GroupAccumulator(1.0)
    adopt.observe(nan)
    var live_b = GroupAccumulator(1.0)
    live_b.observe(-2.0)
    adopt.merge_from(live_b)
    if (
        live.minimum == 4.0
        and live.maximum == 8.0
        and live.count == 3.0
        and isnan(live.total)
        and adopt.minimum == -2.0
        and adopt.maximum == -2.0
        and adopt.seen
        and adopt.count == 2.0
    ):
        passed += 1
        print("  ✅ merge_from: an all-NaN side moves no extremum, both directions")
    else:
        failed += 1
        print(
            "  ❌ all-NaN merge wrong: live min", live.minimum,
            " adopt min", adopt.minimum,
        )

    # ── merge_from unit behaviour: empty sides and extrema ─────────────────────
    var acc_a = GroupAccumulator(1.0)
    acc_a.observe(2.0)
    acc_a.observe(4.0)
    var acc_empty = GroupAccumulator(1.0)
    acc_a.merge_from(acc_empty)  # no-op
    var acc_b = GroupAccumulator(1.0)
    acc_b.observe(-6.0)
    acc_a.merge_from(acc_b)
    var acc_c = GroupAccumulator(1.0)
    acc_c.merge_from(acc_a)  # copy into empty
    if (
        acc_a.count == 3.0
        and acc_a.total == 0.0
        and acc_a.minimum == -6.0
        and acc_a.maximum == 4.0
        and acc_c.count == 3.0
        and acc_c.minimum == -6.0
    ):
        passed += 1
        print("  ✅ merge_from: empty is a no-op, extrema and totals fold correctly")
    else:
        failed += 1
        print("  ❌ merge_from unit behaviour wrong:", acc_a.count, acc_a.minimum)

    print("  [query.aggregate parallel] Passed:", passed, "Failed:", failed)
    if failed > 0:
        raise Error("test_query_aggregate_parallel: " + String(failed) + " failure(s)")
