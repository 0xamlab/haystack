"""test_esrnn_per_frequency.mojo — known-value tests for the LINEAR-class per-frequency
residual corrector: the fit/refusal contract and the call-only predict-and-add composition.

Hand-written. The cases that carry the module's reason to exist:

  * CALL-ONLY, PROVEN BIT-EXACT AGAINST `ridge_regression`. `esrnn_fit_frequency_corrector`
    on a well-formed pool is asserted `==` (not a tolerance) against a direct
    `regression.ridge_regression` call on the SAME `X`/`y`/`alpha` — the "never
    reimplement" rule checked at the value level, exactly like
    `test_esrnn_global_residual.mojo` pins `esrnn_backbone_forecast` against a direct
    fitted-driver call.
  * A RECOVERABLE LINEAR SIGNAL, NOT JUST A SHAPE CHECK. Fitting on data generated by a
    KNOWN linear function (`y = 2*x0 + 3*x1 + 5`, zero noise) recovers coefficients and
    intercept close to the true `[2, 3]`/`5` and `r_squared` close to `1.0` — proving the
    composition actually reaches the SAME signal a direct `ridge_regression` call would,
    not merely that it returns SOME `RegressionResult` shape.
  * REFUSAL, NOT A CRASH, ON A BAD SHAPE. An empty pool and a length-mismatched pool BOTH
    refuse with an empty `RegressionResult` — the check `ridge_regression` itself does not
    make on its own for the length-mismatch case.
  * CALL-ONLY, PROVEN BIT-EXACT AGAINST `predict` + `esrnn_apply_correction`.
    `esrnn_apply_linear_correction`'s output is asserted `==` a direct
    `predict(...)` followed by `esrnn_apply_correction(...)` — the same two-call
    composition, run by hand, must produce the identical list.
  * SIGN CHECK. Correcting a zero backbone with a linear model that reconstructs `y`
    exactly reproduces `y` itself — pinning the correction's sign, not just its shape.
  * NON-FINITE AND LENGTH-MISMATCH REFUSAL PROPAGATE. A backbone/`X` row-count mismatch,
    and a non-finite coefficient, both refuse (empty) — `esrnn_apply_correction`'s own
    refusal discipline, inherited rather than re-implemented.
"""
from esrnn.global_residual import esrnn_apply_correction
from esrnn.per_frequency import esrnn_apply_linear_correction, esrnn_fit_frequency_corrector
from regression import predict, ridge_regression


fn _same_values(a: List[Float64], b: List[Float64]) -> Bool:
    """Elementwise `==` over two value lists, the same helper convention
    `test_esrnn_global_residual.mojo` uses for every bit-exact comparison in this suite."""
    if len(a) != len(b):
        return False
    for i in range(len(a)):
        if a[i] != b[i]:
            return False
    return True


fn _abs(v: Float64) -> Float64:
    return -v if v < 0.0 else v


fn main():
    var passed = 0
    var failed = 0
    print("\n[esrnn.per_frequency] hand-written known-value suite")

    # ══ 1. esrnn_fit_frequency_corrector: call-only, bit-exact against ridge_regression ══
    var X = List[List[Float64]]()
    var row0 = List[Float64]()
    row0.append(1.0)
    row0.append(0.5)
    var row1 = List[Float64]()
    row1.append(2.0)
    row1.append(-1.0)
    var row2 = List[Float64]()
    row2.append(0.0)
    row2.append(3.0)
    var row3 = List[Float64]()
    row3.append(-1.0)
    row3.append(1.0)
    X.append(row0^)
    X.append(row1^)
    X.append(row2^)
    X.append(row3^)
    var y = List[Float64]()
    y.append(2.5)
    y.append(-0.5)
    y.append(4.0)
    y.append(1.0)
    var alpha = 0.7
    var via_module = esrnn_fit_frequency_corrector(X, y, alpha)
    var via_direct = ridge_regression(X, y, alpha)
    if (
        _same_values(via_module.coefficients, via_direct.coefficients)
        and via_module.intercept == via_direct.intercept
        and via_module.r_squared == via_direct.r_squared
        and _same_values(via_module.residuals, via_direct.residuals)
        and len(via_module.coefficients) == 2
    ):
        passed += 1
        print("  ✅ fit_frequency_corrector reproduces ridge_regression bit-for-bit")
    else:
        failed += 1
        print("  ❌ fit_frequency_corrector diverged from a direct ridge_regression call")

    # ══ 2. A recoverable KNOWN linear signal, zero noise: y = 2*x0 + 3*x1 + 5 ══════════
    var Xk = List[List[Float64]]()
    var yk = List[Float64]()
    for i in range(20):
        var x0 = Float64(i) * 0.3 - 2.0
        var x1 = Float64(i % 5) * 0.7
        var r = List[Float64]()
        r.append(x0)
        r.append(x1)
        Xk.append(r^)
        yk.append(2.0 * x0 + 3.0 * x1 + 5.0)
    var fk = esrnn_fit_frequency_corrector(Xk, yk, 0.0)
    if (
        len(fk.coefficients) == 2
        and _abs(fk.coefficients[0] - 2.0) < 1.0e-6
        and _abs(fk.coefficients[1] - 3.0) < 1.0e-6
        and _abs(fk.intercept - 5.0) < 1.0e-6
        and fk.r_squared > 0.999999
    ):
        passed += 1
        print("  ✅ zero-noise linear signal recovered: coeffs ≈ [2,3], intercept ≈ 5, R² ≈ 1")
    else:
        failed += 1
        print(
            "  ❌ linear signal not recovered:",
            fk.coefficients[0] if len(fk.coefficients) > 0 else -999.0,
            fk.coefficients[1] if len(fk.coefficients) > 1 else -999.0,
            fk.intercept, fk.r_squared,
        )

    # ══ 3. Refusal: empty pool, length mismatch ═══════════════════════════════════════
    var X_empty = List[List[Float64]]()
    var y_empty = List[Float64]()
    var f_empty = esrnn_fit_frequency_corrector(X_empty, y_empty, 1.0)
    var y_short = List[Float64]()
    y_short.append(1.0)
    y_short.append(2.0)
    var f_mismatch = esrnn_fit_frequency_corrector(X, y_short, 1.0)  # X has 4 rows, y_short has 2
    if (
        len(f_empty.coefficients) == 0 and len(f_empty.residuals) == 0 and f_empty.r_squared == 0.0
        and len(f_mismatch.coefficients) == 0 and len(f_mismatch.residuals) == 0
        and f_mismatch.r_squared == 0.0
    ):
        passed += 1
        print("  ✅ fit_frequency_corrector refuses (empty result) on empty pool and length mismatch")
    else:
        failed += 1
        print("  ❌ refusal path wrong:", len(f_empty.coefficients), len(f_mismatch.coefficients))

    # ══ 4. esrnn_apply_linear_correction: call-only, bit-exact against predict+apply ══
    var backbone = List[Float64]()
    backbone.append(10.0)
    backbone.append(20.0)
    backbone.append(30.0)
    backbone.append(40.0)
    var coeffs = List[Float64]()
    coeffs.append(1.5)
    coeffs.append(-0.5)
    var intercept = 2.0
    var via_bias = esrnn_apply_linear_correction(backbone, X, coeffs, intercept)
    var direct_resid = predict(X, coeffs, intercept)
    var via_direct_apply = esrnn_apply_correction(backbone, direct_resid)
    if (
        len(via_bias) == 4 and _same_values(via_bias, via_direct_apply)
    ):
        passed += 1
        print("  ✅ apply_linear_correction reproduces predict()+apply_correction() bit-for-bit")
    else:
        failed += 1
        print("  ❌ apply_linear_correction diverged from the direct two-call composition")

    # ══ 5. Sign check: correcting a zero backbone reconstructs `y` exactly ════════════
    var zero_backbone = List[Float64]()
    for _ in range(20):
        zero_backbone.append(0.0)
    var reconstructed = esrnn_apply_linear_correction(zero_backbone, Xk, fk.coefficients, fk.intercept)
    var max_err = 0.0
    for i in range(20):
        var e = _abs(reconstructed[i] - yk[i])
        if e > max_err:
            max_err = e
    if len(reconstructed) == 20 and max_err < 1.0e-6:
        passed += 1
        print("  ✅ sign check: correcting a zero backbone with the fitted model reconstructs y (max err", max_err, ")")
    else:
        failed += 1
        print("  ❌ sign/reconstruction wrong, max_err =", max_err)

    # ══ 6. Row-count mismatch and non-finite coefficient both refuse ═════════════════
    var short_backbone = List[Float64]()
    short_backbone.append(1.0)
    short_backbone.append(2.0)
    var mismatched_apply = esrnn_apply_linear_correction(short_backbone, X, coeffs, intercept)  # 2 vs 4 rows
    var nan_coeffs = List[Float64]()
    nan_coeffs.append(0.0 / 0.0)
    nan_coeffs.append(1.0)
    var nonfinite_apply = esrnn_apply_linear_correction(backbone, X, nan_coeffs, intercept)
    if len(mismatched_apply) == 0 and len(nonfinite_apply) == 0:
        passed += 1
        print("  ✅ apply_linear_correction refuses on a row-count mismatch and a non-finite coefficient")
    else:
        failed += 1
        print("  ❌ refusal path wrong:", len(mismatched_apply), len(nonfinite_apply))

    print("  [esrnn.per_frequency] Passed:", passed, "Failed:", failed)
