"""test_query_packedkey.mojo — composite key PACKING: identity, the guard, the
ceilings, and the NaN policy.

Hand-written. `query.packedkey` claims one thing and one thing only: on a batch
whose key tuple fits a probed integral domain, the dense direct-index route
returns what the HASH route returns — the same groups in the same order with
the same bits — and on any other batch it REFUSES rather than writing out of
bounds. Everything below is a comparison against `group_by_many_banded` /
`group_by_many_parallel` on identical data, because "identical to the engine
that already shipped" is the only claim worth making about an optimization.

What each block protects, in order:

  * PACKED == BANDED, BIT FOR BIT, per opcode and per band count. Not `==` on
    the values: the bit patterns, so a NaN answer with a different payload and a
    -0.0/+0.0 swap both fail. Bit equality at several band counts is the
    merge-order claim — the packed merge folds bands in ascending index like
    the banded merge does, which is why a continuous-value MEAN (Welford, where
    association is observable) comes back identical rather than close.
  * The NaN POLICY, unchanged, because this module reuses `observe_op` /
    `merge_from` rather than reimplementing them: a NaN contributes to no
    extremum, still counts, and an all-NaN group's min/max is the canonical NaN.
    Pinned per opcode, with NaN first and NaN last, since seed position is
    exactly what defect #459 turned on.
  * The GUARD. A key outside the probed domain — including EXACTLY `hi` and
    EXACTLY `lo - 1`, the off-by-one pair — must be a typed refusal with an
    empty result. An out-of-range packed slot is an unchecked write into
    `alloc`'d memory, which is an uncatchable abort that takes the worker down;
    so the refusal is tested at both boundaries and at magnitudes whose slot
    would land gigabytes away.
  * REFUSAL IS NOT AN ANSWER. `group_by_many_routed_parallel` must return the
    hash engines' exact result whenever the packed route declines or refuses,
    on the same batch, so a refusal costs a pass and never a wrong number.
  * The CEILINGS, before allocation. The span product against
    `MAX_PACKED_SLOTS` (checked inside the stride fold so it cannot overflow on
    the way to being rejected), and `bands x slots x n_aggs x
    size_of[GroupAccumulator]()` against `MAX_PACKED_STATE_BYTES` — which must
    SATURATE, because a bound computed with a wrapped product is a rubber stamp.
  * The per-column LO OFFSET, which is what makes the route available on any
    integer domain that does not start at zero, and the exact round trip of the
    unpack (a key digit must come back as the same Float64 bits that went in).

Data is generated by a fixed-seed LCG in this file, so failures reproduce.
"""
from std.memory import bitcast
from std.sys.info import size_of

from columnar.array import Float64Array, float64_from_list, float64_with_nulls
from columnar.batch import RecordBatch, schema_of
from numeric.contract import AGG_AVG, AGG_COUNT, AGG_MAX, AGG_MIN, AGG_SUM
from query.aggregate import (
    GroupAccumulator,
    ManyGroupedResult,
    group_by_many_banded,
    group_by_many_parallel,
)
from query.packedkey import (
    GROUP_PACKED_DOMAIN_TOO_LARGE,
    MAX_PACKED_SLOTS,
    MAX_PACKED_STATE_BYTES,
    MAX_PACKED_WIDTH,
    PACKED_ROUTE_MAX_SLOTS,
    PackedDomain,
    group_by_many_routed_parallel,
    group_by_packed_parallel,
    packed_route_ok,
    packed_state_bytes,
    packed_status_name,
    probe_packed_domain,
)

comptime GROUP_CODED_OK: Int = 330
comptime GROUP_CODED_KEY_NOT_A_CODE: Int = 332
comptime GROUP_CODED_BAD_REQUEST: Int = 333


def _lcg(mut state: UInt64) -> UInt64:
    """Fixed-seed LCG so a failure reproduces exactly."""
    state = state * 6364136223846793005 + 1442695040888963407
    return state


def _bits(x: Float64) -> UInt64:
    return bitcast[DType.uint64](x)


def _identical(a: ManyGroupedResult, b: ManyGroupedResult) -> String:
    """Empty when a and b are the same result DOWN TO THE BITS, else the first
    difference. Bit comparison, not `==`: `==` calls +0.0 and -0.0 equal and
    calls every NaN unequal, and both are answers this module can produce."""
    if a.n_groups() != b.n_groups():
        return "n_groups " + String(a.n_groups()) + " vs " + String(b.n_groups())
    if a.key_width != b.key_width:
        return "key_width"
    if a.n_aggs != b.n_aggs:
        return "n_aggs"
    if a.null_key_rows != b.null_key_rows:
        return (
            "null_key_rows " + String(a.null_key_rows) + " vs "
            + String(b.null_key_rows)
        )
    if len(a.key_tuples) != len(b.key_tuples) or len(a.values) != len(b.values):
        return "lengths"
    for i in range(len(a.key_tuples)):
        if _bits(a.key_tuples[i]) != _bits(b.key_tuples[i]):
            return (
                "key_tuples[" + String(i) + "] " + String(a.key_tuples[i]) + " vs "
                + String(b.key_tuples[i])
            )
    for i in range(len(a.values)):
        if _bits(a.values[i]) != _bits(b.values[i]):
            return (
                "values[" + String(i) + "] bits " + String(_bits(a.values[i]))
                + " vs " + String(_bits(b.values[i]))
            )
        if a.present[i] != b.present[i]:
            return "present[" + String(i) + "]"
        if _bits(a.counts[i]) != _bits(b.counts[i]):
            return "counts[" + String(i) + "]"
    return String("")


def _col(vals: List[Float64]) -> Float64Array:
    return float64_from_list(vals.copy())


def _b3(a: List[Float64], b: List[Float64], v: List[Float64], n: Int) -> RecordBatch:
    var names = List[String]()
    names.append("a")
    names.append("b")
    names.append("v")
    var cols = List[Float64Array]()
    cols.append(_col(a))
    cols.append(_col(b))
    cols.append(_col(v))
    return RecordBatch(schema_of(names^), cols^, n)


def _i1(a: Int) -> List[Int]:
    var out = List[Int]()
    out.append(a)
    return out^


def _i2(a: Int, b: Int) -> List[Int]:
    var out = List[Int]()
    out.append(a)
    out.append(b)
    return out^


def _i3(a: Int, b: Int, c: Int) -> List[Int]:
    var out = List[Int]()
    out.append(a)
    out.append(b)
    out.append(c)
    return out^


def _opcodes() -> List[Int]:
    var out = List[Int]()
    out.append(AGG_SUM)
    out.append(AGG_AVG)
    out.append(AGG_MIN)
    out.append(AGG_MAX)
    out.append(AGG_COUNT)
    return out^


def main() raises:
    var passed = 0
    var failed = 0
    var nan_v = Float64("nan")
    var inf_v = Float64("inf")

    # ── 1. PACKED == BANDED, bit for bit, per opcode x band count ────────────
    # Continuous values on purpose: an integer-only value column would agree
    # under ANY fold association and would not test the merge order at all.
    var state: UInt64 = 20260801
    var ka = List[Float64]()
    var kb = List[Float64]()
    var vv = List[Float64]()
    for i in range(5000):
        ka.append(Float64(Int(_lcg(state) % 17)) + 3.0)
        kb.append(Float64(Int(_lcg(state) % 11)) - 4.0)
        vv.append(Float64(Int(_lcg(state) % 1000003)) * 1.0000000001e-3 - 500.0)
        _ = i
    var batch = _b3(ka, kb, vv, 5000)
    var keys = _i2(0, 1)
    var vals = _i1(2)
    var dom = probe_packed_domain(batch, keys, 1 << 16)
    var ops = _opcodes()
    var id_ok = dom.valid() and dom.slots == 17 * 11
    if not id_ok:
        print("  [identity] domain refused or wrong size:", dom.describe())
    var bands_tried = List[Int]()
    bands_tried.append(1)
    bands_tried.append(2)
    bands_tried.append(3)
    bands_tried.append(8)
    bands_tried.append(16)
    bands_tried.append(64)
    bands_tried.append(6000)  # more bands than rows
    for bi in range(len(bands_tried)):
        var nb = bands_tried[bi]
        for oi in range(len(ops)):
            var o = _i1(ops[oi])
            var want = group_by_many_banded(batch, keys, vals, o, nb)
            var got = group_by_packed_parallel(batch, keys, dom, vals, o, nb)
            if not got.ok():
                id_ok = False
                print(
                    "  [identity] bands", nb, "opcode", ops[oi], "refused:",
                    packed_status_name(got.status),
                )
                continue
            var d = _identical(want, got.result)
            if d != "":
                id_ok = False
                print("  [identity] bands", nb, "opcode", ops[oi], "->", d)
    # A fused THREE-aggregate request, one of them a mean of the same column.
    var v3c = _i3(2, 2, 2)
    var o3 = _i3(AGG_AVG, AGG_SUM, AGG_MIN)
    for bi in range(len(bands_tried)):
        var nb = bands_tried[bi]
        var want = group_by_many_banded(batch, keys, v3c, o3, nb)
        var got = group_by_packed_parallel(batch, keys, dom, v3c, o3, nb)
        var d = _identical(want, got.result)
        if not got.ok() or d != "":
            id_ok = False
            print("  [identity] fused 3-agg bands", nb, "->", d)
    if id_ok:
        passed += 1
        print(
            "  ✅ packed == banded bit for bit: 5 opcodes + a fused 3-aggregate"
            " request, at 1/2/3/8/16/64 bands and bands > rows"
        )
    else:
        failed += 1
        print("  ❌ the packed route disagrees with the hash route it replaces")

    # ── 2. the NaN policy survives, per opcode, in both seed positions ───────
    var nan_ok = True
    var na = List[Float64]()
    var nbb = List[Float64]()
    var nv = List[Float64]()
    for i in range(600):
        na.append(Float64(i % 5))
        nbb.append(Float64(i % 4))
        # group (0,0) mod 20 == 0 is entirely NaN; elsewhere NaN is interleaved
        # so it lands FIRST for some groups and LAST for others.
        if i % 20 == 0 or i % 7 == 0:
            nv.append(nan_v)
        else:
            nv.append(Float64(i) * 0.5 - 100.0)
    var nbatch = _b3(na, nbb, nv, 600)
    var ndom = probe_packed_domain(nbatch, keys, 1 << 16)
    for oi in range(len(ops)):
        var o = _i1(ops[oi])
        for nb in range(1, 6):
            var want = group_by_many_banded(nbatch, keys, vals, o, nb)
            var got = group_by_packed_parallel(nbatch, keys, ndom, vals, o, nb)
            var d = _identical(want, got.result)
            if not got.ok() or d != "":
                nan_ok = False
                print("  [nan] opcode", ops[oi], "bands", nb, "->", d)
    # An ALL-NaN group: min/max must be the canonical NaN and count must be
    # nonzero. Read it off the result rather than trusting the comparison, so
    # this block fails even if BOTH engines regressed together.
    var aa = List[Float64]()
    var ab = List[Float64]()
    var av = List[Float64]()
    for i in range(40):
        aa.append(0.0)
        ab.append(0.0)
        av.append(nan_v)
        _ = i
    var abatch = _b3(aa, ab, av, 40)
    var adom = probe_packed_domain(abatch, keys, 1 << 16)
    var amin = group_by_packed_parallel(abatch, keys, adom, vals, _i1(AGG_MIN), 4)
    var amax = group_by_packed_parallel(abatch, keys, adom, vals, _i1(AGG_MAX), 4)
    if not amin.ok() or amin.result.n_groups() != 1:
        nan_ok = False
        print("  [nan] all-NaN group vanished")
    else:
        var mn = amin.result.value_at(0, 0)
        var mx = amax.result.value_at(0, 0)
        if mn == mn or mx == mx:
            nan_ok = False
            print("  [nan] all-NaN min/max must be NaN, got", mn, mx)
        if _bits(mn) != _bits(mx):
            nan_ok = False
            print("  [nan] all-NaN min/max must be the SAME canonical NaN")
        if amin.result.count_at(0, 0) != 40.0:
            nan_ok = False
            print("  [nan] a NaN must still COUNT, got", amin.result.count_at(0, 0))
    if nan_ok:
        passed += 1
        print(
            "  ✅ NaN contributes to no extremum, still counts, and an all-NaN"
            " group's min/max is ONE canonical NaN — on the packed route too"
        )
    else:
        failed += 1
        print("  ❌ the packed route moved the NaN policy (defect #459's shape)")

    # ── 3. THE GUARD: out of domain REFUSES, at both boundaries ─────────────
    var guard_ok = True
    var planted = List[Float64]()
    planted.append(4.0)       # EXACTLY hi for a 0..3 domain: the off-by-one
    planted.append(-1.0)      # EXACTLY lo - 1: the two-sided half
    planted.append(2.5)       # non-integral
    planted.append(nan_v)
    planted.append(inf_v)
    planted.append(-inf_v)
    planted.append(1e9)       # a slot ~8 GB past the array
    planted.append(-1e9)
    planted.append(Float64(1 << 54))  # past 2^53: not exactly representable
    for pi in range(len(planted)):
        var ga = List[Float64]()
        var gb = List[Float64]()
        var gv = List[Float64]()
        for i in range(3000):
            ga.append(Float64(i % 4))
            gb.append(Float64(i % 4))
            gv.append(Float64(i))
        ga[2999] = planted[pi]
        var gbatch = _b3(ga, gb, gv, 3000)
        # Probe only the first 100 rows, so the planted key is genuinely
        # OUTSIDE the window — the "the window can only lie one way" case.
        var gdom = probe_packed_domain(gbatch, keys, 100)
        if not gdom.valid() or gdom.slots != 16:
            guard_ok = False
            print("  [guard] probe window setup wrong:", gdom.describe())
            continue
        for nb in range(1, 5):
            var got = group_by_packed_parallel(gbatch, keys, gdom, vals, _i1(AGG_SUM), nb)
            if got.status != GROUP_CODED_KEY_NOT_A_CODE or got.result.n_groups() != 0:
                guard_ok = False
                print(
                    "  [guard] planted", planted[pi], "bands", nb,
                    "must refuse KEY_NOT_A_CODE, got", packed_status_name(got.status),
                    "with", got.result.n_groups(), "groups",
                )
            # and the router must still produce the hash engines' answer
            var routed = group_by_many_routed_parallel(gbatch, keys, vals, _i1(AGG_SUM), nb)
            var want = group_by_many_parallel(gbatch, keys, vals, _i1(AGG_SUM), nb)
            var d = _identical(want, routed)
            if d != "":
                guard_ok = False
                print("  [guard] fallback for", planted[pi], "bands", nb, "->", d)
    if guard_ok:
        passed += 1
        print(
            "  ✅ a key outside the probed domain REFUSES (both boundaries, both"
            " infinities, NaN, non-integral, past 2^53) and the router falls back"
            " to the hash engines' exact answer"
        )
    else:
        failed += 1
        print("  ❌ the domain guard leaks — an out-of-bounds packed write is reachable")

    # ── 4. THE CEILINGS, before allocation, and they must SATURATE ──────────
    var cap_ok = True
    var acc_bytes = size_of[GroupAccumulator]()
    if packed_state_bytes(10000, 1, 16, 2) != 10000 * (16 * (acc_bytes + 9) + acc_bytes + 8 + 16):
        cap_ok = False
        print("  [ceiling] exact case wrong:", packed_state_bytes(10000, 1, 16, 2))
    # Each of these overflows a naive product on some machine word; the bound
    # must report OVER, never a small positive number.
    if packed_state_bytes(MAX_PACKED_SLOTS, 32, 64, 2) <= MAX_PACKED_STATE_BYTES:
        cap_ok = False
        print("  [ceiling] 1M slots x 32 aggs x 64 bands passed the budget")
    if packed_state_bytes(MAX_PACKED_SLOTS, 32, 1 << 45, 2) <= MAX_PACKED_STATE_BYTES:
        cap_ok = False
        print("  [ceiling] a wrapping band count passed the budget")
    if packed_state_bytes(1 << 40, 32, 1 << 40, 8) <= MAX_PACKED_STATE_BYTES:
        cap_ok = False
        print("  [ceiling] a wrapping slot count passed the budget")
    # The span PRODUCT ceiling, checked inside the fold. Two columns of span
    # 5000 is 25M slots.
    var wa = List[Float64]()
    var wb = List[Float64]()
    var wv = List[Float64]()
    for i in range(500):
        wa.append(Float64(i * 10))
        wb.append(Float64(i * 10))
        wv.append(Float64(i))
    var wbatch = _b3(wa, wb, wv, 500)
    var wdom = probe_packed_domain(wbatch, keys, 1 << 16)
    if wdom.status != GROUP_PACKED_DOMAIN_TOO_LARGE or wdom.valid():
        cap_ok = False
        print("  [ceiling] a 25M-slot product was not refused:", wdom.describe())
    var wg = group_by_packed_parallel(wbatch, keys, wdom, vals, _i1(AGG_SUM), 8)
    if wg.status != GROUP_PACKED_DOMAIN_TOO_LARGE or wg.result.n_groups() != 0:
        cap_ok = False
        print("  [ceiling] the engine accepted an invalid domain:", packed_status_name(wg.status))
    var wr = group_by_many_routed_parallel(wbatch, keys, vals, _i1(AGG_SUM), 8)
    var wwant = group_by_many_parallel(wbatch, keys, vals, _i1(AGG_SUM), 8)
    var wd = _identical(wwant, wr)
    if wd != "":
        cap_ok = False
        print("  [ceiling] router fallback on a too-large domain ->", wd)
    # A width past MAX_PACKED_WIDTH is a BAD_REQUEST, not a crash.
    var wide_keys = List[Int]()
    for _ in range(MAX_PACKED_WIDTH + 1):
        wide_keys.append(0)
    var wide_dom = probe_packed_domain(batch, wide_keys, 1 << 16)
    if wide_dom.status != GROUP_CODED_BAD_REQUEST:
        cap_ok = False
        print("  [ceiling] width", MAX_PACKED_WIDTH + 1, "must be BAD_REQUEST")
    if cap_ok:
        passed += 1
        print(
            "  ✅ both ceilings bind BEFORE allocation, the byte budget saturates"
            " instead of wrapping, and an over-wide tuple is a typed refusal"
        )
    else:
        failed += 1
        print("  ❌ a ceiling is a rubber stamp — allocation is not bounded")

    # ── 5. per-column LO offsets, and the unpack round trip ────────────────
    var lo_ok = True
    var ya = List[Float64]()
    var yb = List[Float64]()
    var yv = List[Float64]()
    for i in range(900):
        ya.append(Float64(2000 + i % 26))    # calendar years
        yb.append(Float64(-30 + i % 7))      # a signed domain
        yv.append(Float64(Int(_lcg(state) % 99991)) * 1e-4)
    var ybatch = _b3(ya, yb, yv, 900)
    var ydom = probe_packed_domain(ybatch, keys, 1 << 16)
    # 26 x 7 = 182 slots WITH the offsets. Without them it would be 2026 x 31 =
    # 62 806 — the whole reason the offsets exist.
    if not ydom.valid() or ydom.slots != 182:
        lo_ok = False
        print("  [offsets] want 182 slots, got:", ydom.describe())
    for nb in range(1, 9):
        var want = group_by_many_banded(ybatch, keys, vals, _i1(AGG_AVG), nb)
        var got = group_by_packed_parallel(ybatch, keys, ydom, vals, _i1(AGG_AVG), nb)
        var d = _identical(want, got.result)
        if not got.ok() or d != "":
            lo_ok = False
            print("  [offsets] bands", nb, "->", d)
    # The unpack must return the ORIGINAL Float64 bits, not a value that merely
    # prints the same — this is what makes the key column trustworthy.
    if lo_ok:
        var got = group_by_packed_parallel(ybatch, keys, ydom, vals, _i1(AGG_SUM), 4)
        for g in range(got.result.n_groups()):
            var k = got.result.key_at(g)
            if _bits(k[0]) != _bits(Float64(Int(k[0]))) or k[0] < 2000.0 or k[0] > 2025.0:
                lo_ok = False
                print("  [offsets] unpacked key 0 out of domain:", k[0])
            if k[1] < -30.0 or k[1] > -24.0:
                lo_ok = False
                print("  [offsets] unpacked key 1 out of domain:", k[1])
    if lo_ok:
        passed += 1
        print(
            "  ✅ per-column lo offsets keep an offset domain dense (182 slots,"
            " not 62 806) and every unpacked key digit round-trips exactly"
        )
    else:
        failed += 1
        print("  ❌ the offset packing is wrong — keys or slot count are off")

    # ── 6. nulls: a null KEY excludes and tallies, a null VALUE moves only
    #      its own accumulator — both exactly as on the hash routes ──────────
    var null_ok = True
    var nka = List[Float64]()
    var nkb = List[Float64]()
    var nkv = List[Float64]()
    var kvalid = List[Bool]()
    var vvalid = List[Bool]()
    for i in range(700):
        nka.append(Float64(i % 6))
        nkb.append(Float64(i % 5))
        nkv.append(Float64(Int(_lcg(state) % 7919)) * 0.125 - 400.0)
        kvalid.append(i % 11 != 0)
        vvalid.append(i % 4 != 0)
    var nnames = List[String]()
    nnames.append("a")
    nnames.append("b")
    nnames.append("v")
    var ncols = List[Float64Array]()
    ncols.append(float64_with_nulls(nka.copy(), kvalid.copy()))
    ncols.append(_col(nkb))
    ncols.append(float64_with_nulls(nkv.copy(), vvalid.copy()))
    var nullb = RecordBatch(schema_of(nnames^), ncols^, 700)
    var nulld = probe_packed_domain(nullb, keys, 1 << 16)
    for oi in range(len(ops)):
        var o = _i1(ops[oi])
        for nb in range(1, 7):
            var want = group_by_many_banded(nullb, keys, vals, o, nb)
            var got = group_by_packed_parallel(nullb, keys, nulld, vals, o, nb)
            var d = _identical(want, got.result)
            if not got.ok() or d != "":
                null_ok = False
                print("  [nulls] opcode", ops[oi], "bands", nb, "->", d)
            if want.null_key_rows == 0:
                null_ok = False
                print("  [nulls] the reference tallied no null keys — bad fixture")
    if null_ok:
        passed += 1
        print(
            "  ✅ null keys are excluded and tallied, null values move only their"
            " own accumulator, identical to the hash route at every band count"
        )
    else:
        failed += 1
        print("  ❌ null handling diverges on the packed route")

    # ── 7. the ROUTING line is a preference, not a capability ──────────────
    var route_ok = True
    var ra = List[Float64]()
    var rb = List[Float64]()
    var rv = List[Float64]()
    for i in range(30000):
        ra.append(Float64(i % 700))
        rb.append(Float64(i % 701))
        rv.append(Float64(i) * 0.5)
    var rbatch = _b3(ra, rb, rv, 30000)
    var rdom = probe_packed_domain(rbatch, keys, 1 << 16)
    if not rdom.valid() or rdom.slots <= PACKED_ROUTE_MAX_SLOTS:
        route_ok = False
        print("  [route] fixture must exceed the routing line:", rdom.describe())
    var rplan = packed_route_ok(rbatch, keys, 1, 16)
    if rplan.valid():
        route_ok = False
        print("  [route] the router must DECLINE above the measured line")
    # This particular domain is ALSO past the byte budget (490 700 slots x 16
    # bands is 616 MiB), so the pinned call must refuse on the BUDGET — the
    # safety ceiling, not the routing line. Block 9c covers the other window,
    # where the line refuses and the budget does not, which is the only place the
    # line alone is observable.
    var rgot = group_by_packed_parallel(rbatch, keys, rdom, vals, _i1(AGG_SUM), 16)
    if rgot.status != GROUP_PACKED_DOMAIN_TOO_LARGE:
        route_ok = False
        print("  [route] 490 700 slots x 16 bands must refuse on the BUDGET, got",
              packed_status_name(rgot.status))
    var rrouted = group_by_many_routed_parallel(rbatch, keys, vals, _i1(AGG_SUM), 16)
    var rref = group_by_many_parallel(rbatch, keys, vals, _i1(AGG_SUM), 16)
    var rdd = _identical(rref, rrouted)
    if rdd != "":
        route_ok = False
        print("  [route] declined -> wrapper must be group_by_many:", rdd)
    # A single-worker request belongs to the existing entry point.
    var one = group_by_many_routed_parallel(batch, keys, vals, _i1(AGG_SUM), 1)
    var one_ref = group_by_many_parallel(batch, keys, vals, _i1(AGG_SUM), 1)
    if _identical(one_ref, one) != "":
        route_ok = False
        print("  [route] 1 worker must be exactly group_by_many_parallel")
    if route_ok:
        passed += 1
        print(
            "  ✅ the routing line and the safety ceilings are separate refusals:"
            " a domain past BOTH refuses on the budget, and the wrapper answers"
            " through group_by_many either way"
        )
    else:
        failed += 1
        print("  ❌ the routing line and the capability are conflated")

    # ── 8. degenerate shapes answer rather than crash ───────────────────────
    var edge_ok = True
    var ea = List[Float64]()
    var eb = List[Float64]()
    var ev = List[Float64]()
    ea.append(7.0)
    eb.append(-3.0)
    ev.append(1.5)
    var e1 = _b3(ea, eb, ev, 1)
    var ed = probe_packed_domain(e1, keys, 1 << 16)
    for nb in range(1, 40):
        var got = group_by_packed_parallel(e1, keys, ed, vals, _i1(AGG_AVG), nb)
        var want = group_by_many_parallel(e1, keys, vals, _i1(AGG_AVG), nb)
        if not got.ok() or _identical(want, got.result) != "":
            edge_ok = False
            print("  [edge] 1 row at", nb, "bands diverged")
    # A zero-length request is a typed refusal, not an index.
    var empty_req = List[Int]()
    var er = group_by_packed_parallel(batch, keys, dom, empty_req, empty_req, 4)
    if er.status != GROUP_CODED_BAD_REQUEST:
        edge_ok = False
        print("  [edge] zero aggregates must be BAD_REQUEST, got", packed_status_name(er.status))
    # Zero key columns is not this route's question.
    var no_keys = List[Int]()
    var nd = probe_packed_domain(batch, no_keys, 1 << 16)
    if nd.valid():
        edge_ok = False
        print("  [edge] width 0 must not produce a domain")
    # A probe window with no rows has no evidence.
    var zd = probe_packed_domain(batch, keys, 0)
    if zd.valid():
        edge_ok = False
        print("  [edge] a zero-row probe window must not produce a domain")
    if edge_ok:
        passed += 1
        print(
            "  ✅ 1 row at 1-39 bands, zero aggregates, width 0 and an empty"
            " probe window are all typed answers, not crashes"
        )
    else:
        failed += 1
        print("  ❌ a degenerate shape is mishandled")

    # ── 9. the three cases a VACUOUS-mutation sweep proved were missing ─────
    #
    # Each block below exists because a plausible mutation of `packedkey.mojo`
    # left the suite GREEN, which means the suite did not constrain that line.
    # Named for what they cover, not for the mutation, so they read as coverage:
    #
    #   9a  the GENERAL (width >= 3) scan loop's refusal path. Every other guard
    #       case here goes through the specialized width-2 loop, so removing the
    #       general loop's break changed nothing observable.
    #   9b  a non-integral key INSIDE the probed range. Every earlier
    #       non-integral case was ALSO out of range, so the range test masked the
    #       integrality test and deleting integrality changed nothing.
    #   9c  the routing line where the byte budget is NOT also refusing. The
    #       earlier fixture was wide enough that the budget refused it anyway, so
    #       ignoring the measured line changed nothing.
    var gap_ok = True

    # 9a — width 3, out-of-domain third digit planted past the probe window
    var q3a = List[Float64]()
    var q3b = List[Float64]()
    var q3c = List[Float64]()
    var q3v = List[Float64]()
    for i in range(3000):
        q3a.append(Float64(i % 4))
        q3b.append(Float64(i % 3))
        q3c.append(Float64(i % 5))
        q3v.append(Float64(Int(_lcg(state) % 8191)) * 0.125 - 500.0)
    var n4 = List[String]()
    n4.append("a")
    n4.append("b")
    n4.append("c")
    n4.append("v")
    var k3w = List[Int]()
    k3w.append(0)
    k3w.append(1)
    k3w.append(2)
    var v3w = List[Int]()
    v3w.append(3)
    var c4 = List[Float64Array]()
    c4.append(_col(q3a))
    c4.append(_col(q3b))
    c4.append(_col(q3c))
    c4.append(_col(q3v))
    var b4 = RecordBatch(schema_of(n4.copy()), c4^, 3000)
    var d4 = probe_packed_domain(b4, k3w, 1 << 16)
    if not d4.valid() or d4.slots != 60:
        gap_ok = False
        print("  [gap 9a] width-3 domain wrong:", d4.describe())
    for nb in range(1, 6):
        var want = group_by_many_banded(b4, k3w, v3w, _i1(AGG_AVG), nb)
        var got = group_by_packed_parallel(b4, k3w, d4, v3w, _i1(AGG_AVG), nb)
        var d = _identical(want, got.result)
        if not got.ok() or d != "":
            gap_ok = False
            print("  [gap 9a] width-3 general loop bands", nb, "->", d)
    var q3c2 = q3c.copy()
    q3c2[2999] = 99.0
    var c4b = List[Float64Array]()
    c4b.append(_col(q3a))
    c4b.append(_col(q3b))
    c4b.append(_col(q3c2))
    c4b.append(_col(q3v))
    var b4b = RecordBatch(schema_of(n4.copy()), c4b^, 3000)
    var d4b = probe_packed_domain(b4b, k3w, 100)
    for nb in range(1, 6):
        var got = group_by_packed_parallel(b4b, k3w, d4b, v3w, _i1(AGG_SUM), nb)
        if got.status != GROUP_CODED_KEY_NOT_A_CODE or got.result.n_groups() != 0:
            gap_ok = False
            print("  [gap 9a] general loop must refuse, got",
                  packed_status_name(got.status), "with", got.result.n_groups(), "groups")
        var routed = group_by_many_routed_parallel(b4b, k3w, v3w, _i1(AGG_SUM), nb)
        var ref4 = group_by_many_parallel(b4b, k3w, v3w, _i1(AGG_SUM), nb)
        if _identical(ref4, routed) != "":
            gap_ok = False
            print("  [gap 9a] width-3 router fallback wrong at", nb, "bands")

    # 9b — 2.5 inside a [0, 4) domain: only integrality can reject it
    var ia = List[Float64]()
    var ib = List[Float64]()
    var iv = List[Float64]()
    for i in range(3000):
        ia.append(Float64(i % 4))
        ib.append(Float64(i % 4))
        iv.append(Float64(i))
    ia[2999] = 2.5
    var ibatch = _b3(ia, ib, iv, 3000)
    var idom = probe_packed_domain(ibatch, keys, 100)
    if not idom.valid() or idom.los[0] != 0.0 or idom.his[0] != 4.0:
        gap_ok = False
        print("  [gap 9b] fixture must put 2.5 INSIDE the range:", idom.describe())
    for nb in range(1, 6):
        var got = group_by_packed_parallel(ibatch, keys, idom, vals, _i1(AGG_SUM), nb)
        if got.status != GROUP_CODED_KEY_NOT_A_CODE or got.result.n_groups() != 0:
            gap_ok = False
            print("  [gap 9b] an IN-RANGE non-integral key must refuse, got",
                  packed_status_name(got.status))
        var routed = group_by_many_routed_parallel(ibatch, keys, vals, _i1(AGG_SUM), nb)
        var ref9 = group_by_many_parallel(ibatch, keys, vals, _i1(AGG_SUM), nb)
        if _identical(ref9, routed) != "":
            gap_ok = False
            print("  [gap 9b] router fallback wrong at", nb, "bands")

    # 9c — above the line, inside the budget: the line alone must decide. Both
    # columns cover their span inside the 64k probe window (7 and 11 are coprime
    # to 400) or the window would lie and the scan would refuse instead.
    var pa = List[Float64]()
    var pb = List[Float64]()
    var pv = List[Float64]()
    for i in range(200000):
        pa.append(Float64((i * 7) % 400))
        pb.append(Float64((i * 11) % 400))
        pv.append(Float64(i) * 0.5)
    var pbatch = _b3(pa, pb, pv, 200000)
    var pdom = probe_packed_domain(pbatch, keys, 1 << 16)
    var pbytes = packed_state_bytes(pdom.slots, 1, 16, 2)
    if not (pdom.valid() and pdom.slots > PACKED_ROUTE_MAX_SLOTS
            and pbytes <= MAX_PACKED_STATE_BYTES):
        gap_ok = False
        print("  [gap 9c] fixture must be above the line AND inside the budget:",
              pdom.describe(), "bytes", pbytes)
    if packed_route_ok(pbatch, keys, 1, 16).valid():
        gap_ok = False
        print("  [gap 9c] the router must decline on the LINE, budget not masking")
    var pgot = group_by_packed_parallel(pbatch, keys, pdom, vals, _i1(AGG_SUM), 16)
    var pwant = group_by_many_banded(pbatch, keys, vals, _i1(AGG_SUM), 16)
    var pd = _identical(pwant, pgot.result)
    if not pgot.ok() or pd != "":
        gap_ok = False
        print("  [gap 9c] pinned above the line must still answer identically:", pd)
    if gap_ok:
        passed += 1
        print(
            "  ✅ the general width-3 loop refuses, an IN-RANGE non-integral key"
            " refuses, and the routing line decides where the budget does not —"
            " the three lines a vacuous-mutation sweep found unconstrained"
        )
    else:
        failed += 1
        print("  ❌ one of the three previously-unconstrained lines regressed")

    print("  [query.packedkey] Passed:", passed, "Failed:", failed)
    if failed > 0:
        raise Error("test_query_packedkey: " + String(failed) + " failure(s)")
