"""test_canonical_float_repr.mojo — the frozen float text, and the proof it round-trips.

Hand-written. Three kinds of assertion, and the difference between them is the point:

1. **Golden text.** Every expected string is written out literally, so a change to the
   formatter shows up as a diff instead of quietly agreeing with itself. These strings were
   generated by CPython's `repr` and pasted in, which is also what makes them a
   cross-language pin: if this suite passes, a Python caller's `repr` and this kernel
   produce the same bytes.

2. **Round-trip by proof, not by parser.** `round_trips` decides whether a decimal names a
   value by exact integer arithmetic on the value's rounding interval. It is used here as
   the bit-pattern round-trip test the obvious way cannot be: MEASURED, this toolchain's
   `Float64(String)` returns a NEIGHBOURING double for 0.086% of correct decimals and
   `String(Float64)` emits a decimal naming the wrong double for 0.026% of values, so
   "format it, parse it back, compare bits" would report failures for correct text. The
   toolchain parser is still exercised below — as a second opinion that must never
   CONTRADICT the proof — but it is not the oracle.

3. **Cross-checks against `canonical.encode`,** which hashes the bit pattern. Equal values
   must hash equally and different values must never share a text form; the one place those
   two policies deliberately diverge (`-0.0`) is asserted in both directions rather than
   left as a surprise.
"""
from std.math import isnan
from std.memory import bitcast

from canonical.encode import to_hex, write_float
from canonical.float_repr import (
    FLOAT_FINITE,
    FLOAT_NAN,
    FLOAT_NEG_INF,
    FLOAT_POS_INF,
    canonical_float,
    canonical_float_array,
    canonical_float_texts,
    float_class,
    float_class_name,
    float_text,
    float_text_version,
    hash_aligned_float,
    round_trips,
)


def _record(mut passed: Int, mut failed: Int, ok: Bool, label: String):
    if ok:
        passed += 1
        print("  ✅", label)
    else:
        failed += 1
        print("  ❌", label)


def _bits(value: Float64) -> UInt64:
    return bitcast[DType.uint64](value)


def _of_bits(pattern: UInt64) -> Float64:
    return bitcast[DType.float64](pattern)


def _float_hex(value: Float64) -> String:
    var out = List[UInt8]()
    write_float(out, value)
    return to_hex(out)


def main() raises:
    var passed = 0
    var failed = 0

    # ── the frozen spelling, one golden string per decision ──────────────────
    # Generated with CPython `repr` and pasted, so passing this block means a Python
    # caller and this kernel agree byte for byte.
    var values = List[Float64]()
    var golden = List[String]()

    def add(mut values: List[Float64], mut golden: List[String], v: Float64, text: String):
        values.append(v)
        golden.append(text)

    # 1.0 renders as "1.0", never "1": a canonical form that loses the float/int
    # distinction is not canonical. This is also the exact case where JS diverges.
    add(values, golden, 1.0, "1.0")
    add(values, golden, -1.0, "-1.0")
    add(values, golden, 100.0, "100.0")
    add(values, golden, -2.5, "-2.5")
    add(values, golden, 123.456, "123.456")
    # Not representable in binary: the shortest form is what a parser maps back, not the
    # exact expansion (0.1 is really 0.1000000000000000055511151231257827...).
    add(values, golden, 0.1, "0.1")
    add(values, golden, 0.3, "0.3")
    add(values, golden, 1.0 / 3.0, "0.3333333333333333")
    add(values, golden, 2.0 / 3.0, "0.6666666666666666")
    add(values, golden, 0.1 + 1.3877787807814457e-17, "0.10000000000000002")
    # Extremes: the smallest subnormal, the largest finite, the least normal and the
    # largest subnormal (which straddle the exponent-field boundary).
    add(values, golden, 5e-324, "5e-324")
    add(values, golden, 1.7976931348623157e308, "1.7976931348623157e+308")
    add(values, golden, 2.2250738585072014e-308, "2.2250738585072014e-308")
    add(values, golden, 2.2250738585072009e-308, "2.225073858507201e-308")
    add(values, golden, 9.87e-315, "9.87e-315")
    add(values, golden, 2.220446049250313e-16, "2.220446049250313e-16")
    # Powers of two either side of the 2^52 and 2^53 integer-grid boundaries. Below 2^52
    # the doubles are dense enough to need a fraction digit; above 2^53 they are not
    # consecutive integers any more, and 9007199254740993 does not exist at all.
    add(values, golden, 4503599627370495.0, "4503599627370495.0")
    add(values, golden, 4503599627370496.0, "4503599627370496.0")
    add(values, golden, 4503599627370497.0, "4503599627370497.0")
    add(values, golden, 9007199254740991.0, "9007199254740991.0")
    add(values, golden, 9007199254740992.0, "9007199254740992.0")
    add(values, golden, 9007199254740994.0, "9007199254740994.0")
    add(values, golden, 1234567890123456.0, "1234567890123456.0")
    # The exponent threshold: fixed notation up to 1e15, exponent notation from 1e16,
    # fixed down to 1e-4, exponent notation from 1e-5. Two exponent digits minimum.
    add(values, golden, 1e15, "1000000000000000.0")
    add(values, golden, 1e16, "1e+16")
    add(values, golden, 1e17, "1e+17")
    add(values, golden, 1e21, "1e+21")
    add(values, golden, 1e22, "1e+22")
    add(values, golden, 1e-4, "0.0001")
    add(values, golden, 1e-5, "1e-05")
    add(values, golden, 1e300, "1e+300")
    add(values, golden, 1e-300, "1e-300")
    # Both zeros, and the sign is KEPT (see the -0.0 block further down).
    add(values, golden, 0.0, "0.0")
    add(values, golden, -0.0, "-0.0")
    # The four values MEASURED to break the toolchain's own formatter or parser. Each is
    # built from its bit pattern so the literal cannot launder the defect.
    #   4856560017543203705: String(Float64) emitted "4.94657509214361e+16", which is a
    #   DIFFERENT double. 17 digits are required and it produced 15.
    add(values, golden, _of_bits(4856560017543203705), "4.9465750921436104e+16")
    #   4854345028385918414: 16 digits suffice, but only if a decimal exactly ON the
    #   halfway point is accepted per ties-to-even. An earlier draft of this kernel
    #   emitted 17 here and reported it as "shortest".
    add(values, golden, _of_bits(4854345028385918414), "3.388731734105887e+16")
    #   4892739285272635043 and 4862731730675928335: correct text, but Float64(String)
    #   parses each one ULP off in this toolchain.
    add(values, golden, _of_bits(4892739285272635043), "1.2971396250924816e+19")
    add(values, golden, _of_bits(4862731730675928335), "1.2562131792853835e+17")

    var text_mismatches = 0
    var first_bad_expected = String("")
    var first_bad_actual = String("")
    for i in range(len(values)):
        var actual = canonical_float(values[i])
        if actual != golden[i]:
            if text_mismatches == 0:
                first_bad_expected = golden[i]
                first_bad_actual = actual
            text_mismatches += 1
    _record(
        passed,
        failed,
        text_mismatches == 0,
        String("all ") + String(len(values)) + " golden spellings match (CPython repr)",
    )
    if text_mismatches != 0:
        print("     expected", first_bad_expected, "got", first_bad_actual)

    # ── the round-trip property, proved on bit patterns ─────────────────────
    var not_proved = 0
    var not_shortest = 0
    var not_verified = 0
    for i in range(len(values)):
        var report = float_text(values[i])
        if not report.round_trip_proved:
            not_proved += 1
        if not report.shortest_proved:
            not_shortest += 1
        if not round_trips(values[i], report.text):
            not_verified += 1
    _record(
        passed,
        failed,
        not_proved == 0 and not_verified == 0,
        String("every golden value's text provably names it: ")
        + String(len(values))
        + " values, exact interval arithmetic",
    )
    _record(
        passed,
        failed,
        not_shortest == 0,
        "no golden value needed more digits than the proved minimum",
    )

    # A second opinion from the toolchain's own parser. It may DISAGREE (measured: it is
    # wrong for 0.086% of correct decimals), so the assertion is one-directional — where
    # it reconstructs the exact bits, the proof must have said so too. A contradiction in
    # that direction would mean the prover is broken, not the parser.
    var parser_agrees = 0
    var prover_contradicted = 0
    for i in range(len(values)):
        var text = canonical_float(values[i])
        if isnan(values[i]):
            continue
        var reparsed = Float64(text)
        if _bits(reparsed) == _bits(values[i]):
            parser_agrees += 1
            if not round_trips(values[i], text):
                prover_contradicted += 1
    _record(
        passed,
        failed,
        prover_contradicted == 0 and parser_agrees > 0,
        String("toolchain Float64(String) rebuilt ")
        + String(parser_agrees)
        + " of "
        + String(len(values))
        + " bit patterns and never contradicted the proof",
    )

    # Sub-shortest decimals must be REFUSED, which is what makes "shortest" a claim about
    # the value and not about the formatter's taste. Each string below is one digit short
    # of the golden form and names a different double.
    var too_short = List[String]()
    var too_short_for = List[Float64]()
    too_short.append("0.333333333333333")
    too_short_for.append(1.0 / 3.0)
    too_short.append("0.10000000000000001")
    too_short_for.append(0.1 + 1.3877787807814457e-17)
    too_short.append("4.94657509214361e+16")
    too_short_for.append(_of_bits(4856560017543203705))
    too_short.append("1.797693134862315e+308")
    too_short_for.append(1.7976931348623157e308)
    var wrongly_accepted = 0
    for i in range(len(too_short)):
        if round_trips(too_short_for[i], too_short[i]):
            wrongly_accepted += 1
    _record(
        passed,
        failed,
        wrongly_accepted == 0,
        "decimals one digit too short are refused, including the one the toolchain emits",
    )

    # The exact expansion of a value is a different text with the same meaning, so the
    # proof must accept it too — round-tripping is a property of the decimal, not of the
    # spelling this module happens to choose.
    var exact_forms = round_trips(0.1, "0.1000000000000000055511151231257827021181583404541015625")
    exact_forms = exact_forms and round_trips(1.0, "1")
    exact_forms = exact_forms and round_trips(1.0, "1.000000000000000")
    exact_forms = exact_forms and round_trips(1.0, "0.1e1")
    exact_forms = exact_forms and round_trips(1e16, "10000000000000000")
    exact_forms = exact_forms and round_trips(5e-324, "4.9406564584124654e-324")
    _record(passed, failed, exact_forms, "other exact spellings of the same value are accepted")

    # ── -0.0: text keeps the sign, the hash does not ────────────────────────
    var neg_zero_text = canonical_float(-0.0) == "-0.0"
    var zero_text_differs = canonical_float(-0.0) != canonical_float(0.0)
    var zero_round_trip = round_trips(-0.0, "-0.0") and not round_trips(-0.0, "0.0")
    var pos_zero_round_trip = round_trips(0.0, "0.0") and not round_trips(0.0, "-0.0")
    _record(
        passed,
        failed,
        neg_zero_text and zero_text_differs and zero_round_trip and pos_zero_round_trip,
        "-0.0 keeps its sign in text and only -0.0's text names -0.0",
    )
    # And the deliberate asymmetry with the hash, asserted in BOTH directions so neither
    # side can drift into agreeing by accident.
    var hash_same = _float_hex(-0.0) == _float_hex(0.0)
    var aligned_same = hash_aligned_float(-0.0) == hash_aligned_float(0.0)
    var aligned_is_positive = hash_aligned_float(-0.0) == "0.0"
    _record(
        passed,
        failed,
        hash_same and aligned_same and aligned_is_positive,
        "encode hashes both zeros alike, and hash_aligned_float is the ONE place text follows",
    )
    _record(
        passed,
        failed,
        not round_trips(-0.0, hash_aligned_float(-0.0)),
        "hash_aligned_float(-0.0) deliberately does NOT round-trip — the trap, asserted",
    )
    # Underflow: a decimal below half the least subnormal names a zero of its own sign.
    var underflow = round_trips(0.0, "1e-400") and round_trips(-0.0, "-1e-400")
    underflow = underflow and not round_trips(0.0, "-1e-400")
    underflow = underflow and not round_trips(5e-324, "1e-400")
    _record(passed, failed, underflow, "underflowing decimals name a signed zero, not the subnormal")

    # ── NaN and +-Inf are absent, not zero, and never an unparseable token ──
    var nan_a = Float64(0.0) / Float64(0.0)
    var nan_b = Float64("inf") - Float64("inf")
    var pos_inf = Float64("inf")
    var neg_inf = -Float64("inf")
    var nonfinite = List[Float64]()
    nonfinite.append(nan_a)
    nonfinite.append(nan_b)
    nonfinite.append(-nan_a)
    nonfinite.append(pos_inf)
    nonfinite.append(neg_inf)
    var all_null = True
    var any_number_flag = False
    var any_zero_text = False
    for i in range(len(nonfinite)):
        var report = float_text(nonfinite[i])
        if report.text != "null":
            all_null = False
        if report.is_number:
            any_number_flag = True
        if report.text == "0.0" or report.text == "0":
            any_zero_text = True
    _record(
        passed,
        failed,
        all_null and not any_number_flag and not any_zero_text,
        "NaN/+-Inf render as null — absent (rule 4), never 0.0, never the token `nan`",
    )
    var classes = float_class(nan_a) == FLOAT_NAN
    classes = classes and float_class(pos_inf) == FLOAT_POS_INF
    classes = classes and float_class(neg_inf) == FLOAT_NEG_INF
    classes = classes and float_class(1.0) == FLOAT_FINITE
    classes = classes and float_class(-0.0) == FLOAT_FINITE
    var labels = float_text(nan_a).label == "NaN"
    labels = labels and float_text(pos_inf).label == "Infinity"
    labels = labels and float_text(neg_inf).label == "-Infinity"
    labels = labels and float_text(1.0).label == ""
    _record(
        passed,
        failed,
        classes and labels,
        "the NaN / +Inf / -Inf distinction survives in class_code and label, not in the number",
    )
    var names = float_class_name(FLOAT_NAN) == "nan"
    names = names and float_class_name(FLOAT_POS_INF) == "positive_infinity"
    names = names and float_class_name(FLOAT_NEG_INF) == "negative_infinity"
    names = names and float_class_name(FLOAT_FINITE) == "finite"
    names = names and float_class_name(704) == "unknown"
    _record(passed, failed, names, "class names cover 700-703 and refuse to invent one for 704")
    # No decimal names a non-finite value, whatever text is offered.
    var nonfinite_claimed = False
    for i in range(len(nonfinite)):
        if round_trips(nonfinite[i], "null") or round_trips(nonfinite[i], "0.0"):
            nonfinite_claimed = True
        if round_trips(nonfinite[i], "1e400") or round_trips(nonfinite[i], "nan"):
            nonfinite_claimed = True
    _record(
        passed,
        failed,
        not nonfinite_claimed,
        "round_trips never certifies text for a non-finite value",
    )
    # hash_aligned_float collapses NaN the way write_float collapses its bit patterns.
    _record(
        passed,
        failed,
        hash_aligned_float(nan_a) == "null"
        and hash_aligned_float(nan_b) == "null"
        and _float_hex(nan_a) == _float_hex(nan_b),
        "every NaN shares one text and one hash",
    )

    # ── two different values must never share a text form ───────────────────
    # Distinct bit patterns, so distinct texts — with ONE documented exception that is
    # tested the other way round above: +-0.0 are distinct patterns of an equal value.
    var collisions = 0
    for i in range(len(values)):
        for j in range(i + 1, len(values)):
            if _bits(values[i]) == _bits(values[j]):
                continue
            if canonical_float(values[i]) == canonical_float(values[j]):
                collisions += 1
    _record(
        passed,
        failed,
        collisions == 0,
        String("no two of the ")
        + String(len(values))
        + " distinct values share a text form",
    )
    # A denser check where collisions are most likely: neighbouring doubles around the
    # integer-grid boundary, whose shortest forms differ in the last digit only.
    var neighbours = List[String]()
    var anchor = _bits(9007199254740992.0)
    for k in range(-8, 9):
        var pattern = anchor + UInt64(k) if k >= 0 else anchor - UInt64(-k)
        neighbours.append(canonical_float(_of_bits(pattern)))
    var neighbour_collisions = 0
    var neighbour_unproved = 0
    for i in range(len(neighbours)):
        var pattern_i = anchor + UInt64(i) - 8
        if not round_trips(_of_bits(pattern_i), neighbours[i]):
            neighbour_unproved += 1
        for j in range(i + 1, len(neighbours)):
            if neighbours[i] == neighbours[j]:
                neighbour_collisions += 1
    _record(
        passed,
        failed,
        neighbour_collisions == 0 and neighbour_unproved == 0,
        "17 consecutive doubles at the 2^53 boundary get 17 distinct proved texts",
    )

    # ── the same value hashes the same whatever text form it arrived as ─────
    # Five spellings of 1.0, all exact so the toolchain parser cannot mangle them. They
    # must collapse to one bit pattern, therefore one hash, therefore one canonical text.
    var spellings = List[String]()
    spellings.append("1.0")
    spellings.append("1")
    spellings.append("1e0")
    spellings.append("0.1e1")
    spellings.append("10e-1")
    var one_hash = _float_hex(1.0)
    var one_text = canonical_float(1.0)
    var forms_agree = True
    for i in range(len(spellings)):
        var rebuilt = Float64(spellings[i])
        if _float_hex(rebuilt) != one_hash:
            forms_agree = False
        if canonical_float(rebuilt) != one_text:
            forms_agree = False
        if not round_trips(1.0, spellings[i]):
            forms_agree = False
    _record(
        passed,
        failed,
        forms_agree,
        "five text forms of 1.0 collapse to one hash and one canonical spelling",
    )

    # ── malformed text is refused, and refusing it does not crash ───────────
    # `round_trips` takes caller text, so it is the one entry point here that has to
    # survive garbage. A read past the end of a String would be an uncatchable abort
    # (rule 1), so every scan is bounded and every non-decimal is rejected rather than
    # salvaged: failing open would let this certify text a real parser refuses.
    var malformed = List[String]()
    malformed.append("")
    malformed.append("-")
    malformed.append("+")
    malformed.append(".")
    malformed.append(".5")
    malformed.append("+1.0")
    malformed.append("1.")
    malformed.append("1.0.0")
    malformed.append("1.0garbage")
    malformed.append("nan")
    malformed.append("inf")
    malformed.append("-Infinity")
    malformed.append("null")
    malformed.append("1e")
    malformed.append("1e+")
    malformed.append("1e-")
    malformed.append("1e1e1")
    malformed.append("0x1p3")
    malformed.append("1_000.0")
    malformed.append(" 1.0")
    malformed.append("1.0 ")
    malformed.append("１.０")
    malformed.append("1e999999999999999999")
    var long_text = String("1.")
    for _ in range(5000):
        long_text += "9"
    malformed.append(long_text)
    var deep_exponent = String("1e")
    for _ in range(400):
        deep_exponent += "9"
    malformed.append(deep_exponent)
    var accepted_garbage = 0
    for i in range(len(malformed)):
        if round_trips(1.0, malformed[i]):
            accepted_garbage += 1
        if round_trips(0.0, malformed[i]):
            accepted_garbage += 1
        if round_trips(5e-324, malformed[i]):
            accepted_garbage += 1
    _record(
        passed,
        failed,
        accepted_garbage == 0,
        String("all ")
        + String(len(malformed))
        + " malformed / oversized texts are refused without a crash",
    )
    # And a valid literal still passes, so the check above did not just refuse everything.
    _record(
        passed,
        failed,
        round_trips(1.0, "1.0") and round_trips(5e-324, "5e-324"),
        "valid decimals still pass after the malformed sweep",
    )

    # ── self-consistency: no two claims in one report may contradict ────────
    # A struct carrying mutually exclusive fields means a caller can trust neither, so the
    # relationships between them are asserted rather than assumed.
    var inconsistent = 0
    var probe = List[Float64]()
    for i in range(len(values)):
        probe.append(values[i])
    probe.append(nan_a)
    probe.append(pos_inf)
    probe.append(neg_inf)
    for i in range(len(probe)):
        var report = float_text(probe[i])
        var finite_claim = report.class_code == FLOAT_FINITE
        if report.is_number != finite_claim:
            inconsistent += 1
        if report.is_number != report.round_trip_proved:
            inconsistent += 1
        if report.is_number and report.significant_digits < 1:
            inconsistent += 1
        if not report.is_number and report.significant_digits != 0:
            inconsistent += 1
        if not report.is_number and report.text != "null":
            inconsistent += 1
        if report.is_number and report.label != "":
            inconsistent += 1
        if report.text != canonical_float(probe[i]):
            inconsistent += 1
    _record(
        passed,
        failed,
        inconsistent == 0,
        String("every field of ") + String(len(probe)) + " reports agrees with every other",
    )

    # ── the list and array helpers ──────────────────────────────────────────
    var mixed = List[Float64]()
    mixed.append(1.0)
    mixed.append(-0.0)
    mixed.append(nan_a)
    mixed.append(pos_inf)
    mixed.append(1e16)
    _record(
        passed,
        failed,
        canonical_float_array(mixed) == "[1.0,-0.0,null,null,1e+16]",
        "canonical_float_array emits a parseable JSON array with null for the absent values",
    )
    var texts = canonical_float_texts(mixed)
    var texts_match = len(texts) == len(mixed)
    if texts_match:
        for i in range(len(mixed)):
            if texts[i] != canonical_float(mixed[i]):
                texts_match = False
    _record(passed, failed, texts_match, "canonical_float_texts agrees with canonical_float")
    var empty = List[Float64]()
    _record(
        passed,
        failed,
        canonical_float_array(empty) == "[]" and len(canonical_float_texts(empty)) == 0,
        "an empty list is an empty array, not a fabricated element",
    )

    # ── the version string is the identity of the spelling ──────────────────
    _record(
        passed,
        failed,
        float_text_version() == "algenta-float-repr/v1",
        "float_text_version pins the spelling so a change has to be deliberate",
    )

    # ── a swept proof over structured bit patterns ──────────────────────────
    # Every power of two, both signs, plus the subnormal powers of two: the classes where
    # a formatter's rounding is most likely to fall off the grid. Proof and shortest-ness
    # are asserted for each, and every text is required to be distinct from the last.
    var sweep_unproved = 0
    var sweep_not_shortest = 0
    var sweep_count = 0
    var previous = String("")
    var sweep_dupes = 0
    for k in range(1, 2047):
        var pattern = UInt64(k) << 52
        var v = _of_bits(pattern)
        var report = float_text(v)
        sweep_count += 1
        if not round_trips(v, report.text):
            sweep_unproved += 1
        if not report.shortest_proved:
            sweep_not_shortest += 1
        if report.text == previous:
            sweep_dupes += 1
        previous = report.text
        var negative = float_text(_of_bits(pattern | (UInt64(1) << 63)))
        if negative.text != String("-") + report.text:
            sweep_unproved += 1
    for k in range(0, 52):
        var v = _of_bits(UInt64(1) << UInt64(k))
        var report = float_text(v)
        sweep_count += 1
        if not round_trips(v, report.text):
            sweep_unproved += 1
        if not report.shortest_proved:
            sweep_not_shortest += 1
    _record(
        passed,
        failed,
        sweep_unproved == 0 and sweep_not_shortest == 0 and sweep_dupes == 0,
        String("all ")
        + String(sweep_count)
        + " powers of two (normal and subnormal) round-trip, shortest, sign-symmetric",
    )

    print("  [canonical.float_repr] Passed:", passed, "Failed:", failed)
