{
  "name": "algenta-sdk",
  "version": "1.0.0",
  "description": "TypeScript/JavaScript SDK for Codna public data, query, and simulation APIs",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "proto",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepack": "tsc",
    "test": "tsc && vitest run",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "algenta",
    "decision",
    "query",
    "simulation",
    "monte-carlo",
    "api"
  ],
  "homepage": "https://codna.ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/algenta/decision-engine.git",
    "directory": "packages/ts-sdk"
  },
  "bugs": {
    "url": "https://github.com/algenta/decision-engine/issues"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@grpc/grpc-js": "^1.14.3",
    "@grpc/proto-loader": "^0.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.4.0",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
