\cf5 \cb19 comptime\cf17  MATRIX_N \cf5 =\cf17  MATRIX_SIZE  \cf6 # Number of columns in matrices B and C\cf17 \cb1 \
\cf5 \cb19 comptime\cf17  MATRIX_K \cf5 =\cf17  MATRIX_SIZE  \cf6 # Shared dimension (A cols = B rows)\cf17 \cb1 \
\
\pard\pardeftab720\partightenfactor0
