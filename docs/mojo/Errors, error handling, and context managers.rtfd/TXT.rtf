\pard\pardeftab720\partightenfactor0
\cf13 \cb14     \cf5 print(\cf15 "Working..."\cf5 )\cf13 \cb1 \
\
\pard\pardeftab720\partightenfactor0
\cf6 \cb14 # Typed error, suppressed \'97 __exit__[ErrType] returns True\cf13 \cb1 \
\pard\pardeftab720\partightenfactor0
\cf5 \cb14 with\cf13  ResourceGuard\cf5 (\cf15 "cache"\cf5 ,\cf13  suppress_errors\cf5 =\cf22 True\cf5 ):\cf13 \cb1 \
\pard\pardeftab720\partightenfactor0
\cf13 \cb14     use_connection\cf5 ()\cf13   \cf6 # raises ConnectionError\cf13 \cb1 \
\pard\pardeftab720\partightenfactor0
