\fs28 \cf5 \cb14 from\cf13  std\cf5 .\cf13 reflection \cf5 import\cf13  \cf5 *\cf13 \cb1 \
\
\cf5 \cb14 @fieldwise_init\cf13 \cb1 \
\cf5 \cb14 struct\cf13  \cf18 ConnectionError\cf5 (\cf13 Copyable\cf5 ,\cf13  Writable\cf5 ):\cf13 \cb1 \
\pard\pardeftab720\partightenfactor0
\cf13 \cb14     \cf5 var\cf13  message\cf5 :\cf13  String\cb1 \
\
\cb14     \cf5 def\cf13  \cf18 write_to\cf5 (\cf13 self\cf5 ,\cf13  \cf5 mut\cf13  writer\cf5 :\cf13  Some\cf5 [\cf13 Writer\cf5 ]):\cf13 \cb1 \
\cb14         writer\cf5 .\cf13 write\cf5 (\cf15 "ConnectionError: "\cf5 ,\cf13  self\cf5 .\cf13 message\cf5 )\cf13 \cb1 \
\
\
\pard\pardeftab720\partightenfactor0
\cf5 \cb14 struct\cf13  \cf18 ResourceGuard\cf5 (\cf13 ImplicitlyCopyable\cf5 ):\cf13 \cb1 \
\pard\pardeftab720\partightenfactor0
\cf13 \cb14     \cf5 var\cf13  name\cf5 :\cf13  String\cb1 \
\cb14     \cf5 var\cf13  suppress_errors\cf5 :\cf13  Bool\cb1 \
\
\cb14     \cf5 def\cf13  \cf18 __init__\cf5 (out\cf13  self\cf5 ,\cf13  name\cf5 :\cf13  String\cf5 ,\cf13  suppress_errors\cf5 :\cf13  Bool \cf5 =\cf13  \cf22 False\cf5 ):\cf13 \cb1 \
\cb14         self\cf5 .\cf13 name \cf5 =\cf13  name\cb1 \
\cb14         self\cf5 .\cf13 suppress_errors \cf5 =\cf13  suppress_errors\cb1 \
\
\cb14     \cf5 def\cf13  \cf18 __enter__\cf5 (\cf13 self\cf5 )\cf13  \cf5 ->\cf13  Self\cf5 :\cf13 \cb1 \
\cb14         \cf5 print(\cf15 "Acquiring:"\cf5 ,\cf13  self\cf5 .\cf13 name\cf5 )\cf13 \cb1 \
