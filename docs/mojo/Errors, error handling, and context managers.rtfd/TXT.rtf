\
\cb14     \cf5 def\cf13  __exit__\cf5 [\cf13 ErrType\cf5 :\cf13  AnyType\cf5 ](\cf13 self\cf5 ,\cf13  err\cf5 :\cf13  ErrType\cf5 )\cf13  \cf5 ->\cf13  Bool\cf5 :\cf13 \cb1 \
\cb14         \cf5 comptime\cf13  type_name \cf5 =\cf13  get_type_name\cf5 [\cf13 ErrType\cf5 ]()\cf13 \cb1 \
