\cf2 Exponent values of all zeros or all ones represent special cases. These patterns allow floating-point numbers to encode positive and negative infinity, signed zeros, and not-a-number (NaN). These values are available as static constants provided by {\field{\*\fldinst{HYPERLINK "https://docs.modular.com/stable/mojo/std/builtin/float_literal/FloatLiteral/"}}{\fldrslt 
\fs28 \cf5 \cb12 \ul \ulc5 FloatLiteral}}:\
\pard\pardeftab720\partightenfactor0

\fs28 \cf5 \cb16 from\cf17  std\cf5 .\cf17 math \cf5 import\cf17  copysign\cb1 \
\cf5 \cb16 from\cf17  std\cf5 .\cf17 utils\cf5 .\cf17 numerics \cf5 import\cf17  isfinite\cf5 ,\cf17  isinf\cf5 ,\cf17  isnan\cb1 \
\
\cf5 \cb16 var\cf17  inf \cf5 =\cf17  FloatLiteral\cf5 .\cf17 infinity\cb1 \
\cf5 \cb16 print(\cf17 isinf\cf5 (\cf17 inf\cf5 ))\cf17   \cf6 # `True`\cf17 \cb1 \
\cf5 \cb16 print(\cf17 inf \cf5 >\cf17  \cf18 0\cf5 )\cf17      \cf6 # `True`\cf17 \cb1 \
\
\cf5 \cb16 var\cf17  neginf \cf5 =\cf17  FloatLiteral\cf5 .\cf17 negative_infinity\cb1 \
\cf5 \cb16 print(\cf17 isinf\cf5 (\cf17 neginf\cf5 ))\cf17   \cf6 # `True`\cf17 \cb1 \
\cf5 \cb16 print(\cf17 neginf \cf5 <\cf17  \cf18 0\cf5 )\cf17      \cf6 # `True`\cf17 \cb1 \
\
\cf5 \cb16 var\cf17  nan \cf5 =\cf17  FloatLiteral\cf5 .\cf17 nan\cb1 \
\cf5 \cb16 print(\cf17 isnan\cf5 (\cf17 nan\cf5 ))\cf17   \cf6 # `True`\cf17 \cb1 \
\
\cf5 \cb16 var\cf17  negzero \cf5 =\cf17  FloatLiteral\cf5 .\cf17 negative_zero\cb1 \
\cf5 \cb16 print(\cf17 negzero \cf5 ==\cf17  \cf18 0.0\cf5 )\cf17               \cf6 # `True`\cf17 \cb1 \
\cf5 \cb16 print(\cf17 copysign\cf5 (\cf18 1.0\cf5 ,\cf17  negzero\cf5 )\cf17  \cf5 <\cf17  \cf18 0\cf5 )\cf17   \cf6 # `True`\cf17 \cb1 \
