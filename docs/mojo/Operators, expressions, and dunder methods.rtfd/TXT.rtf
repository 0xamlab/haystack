\fs40 \cf2 Substring testing\
\pard\pardeftab720\sa320\partightenfactor0

\fs28 \cf10 \cb12 String
\fs32 \cf2 \cb1 , 
\fs28 \cf10 \cb12 StringLiteral
\fs32 \cf2 \cb1 , and 
\fs28 \cf10 \cb12 StringSlice
\fs32 \cf2 \cb1  support using the 
\fs28 \cf10 \cb12 in
\fs32 \cf2 \cb1  operator to produce a 
\fs28 \cf10 \cb12 Bool
\fs32 \cf2 \cb1  result indicating whether a given substring appears within another string. The operator is overloaded so that you can use any combination of 
\fs28 \cf10 \cb12 String
\fs32 \cf2 \cb1  and 
\fs28 \cf10 \cb12 StringLiteral
\fs32 \cf2 \cb1  for both the substring and the string to test.\
\pard\pardeftab720\partightenfactor0

\fs28 \cf5 \cb15 var\cf16  food\cf5 :\cf16  String \cf5 =\cf16  \cf21 "peanut butter"\cf16 \cb1 \
\
\cf5 \cb15 if\cf16  \cf21 "nut"\cf16  \cf5 in\cf16  food\cf5 :\cf16 \cb1 \
\cb15     \cf5 print(\cf21 "It contains a nut"\cf5 )\cf16 \cb1 \
\cf5 \cb15 else:\cf16 \cb1 \
\cb15     \cf5 print(\cf21 "It doesn't contain a nut"\cf5 )\cf16 \cb1 \
\pard\pardeftab720\qc\partightenfactor0

