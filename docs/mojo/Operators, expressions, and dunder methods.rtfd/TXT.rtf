\fs40 \cf2 String comparison\
\pard\pardeftab720\sa320\partightenfactor0

\fs28 \cf10 \cb12 String
\fs32 \cf2 \cb1  and 
\fs28 \cf10 \cb12 StringLiteral
\fs32 \cf2 \cb1  values can be compared using standard lexicographical ordering, producing a 
\fs28 \cf10 \cb12 Bool
\fs32 \cf2 \cb1 . For example, "Zebra" is treated as less than "ant" because upper case letters occur before lower case letters in the character encoding.\
\pard\pardeftab720\partightenfactor0

\fs28 \cf5 \cb15 var\cf16  animal\cf5 :\cf16  String \cf5 =\cf16  \cf21 "bird"\cf16 \cb1 \
\
\cb15 is_cat_eq \cf5 =\cf16  \cf21 "cat"\cf16  \cf5 ==\cf16  animal\cb1 \
\cf5 \cb15 print(\cf21 'Is "cat" equal to "\{\}"?'\cf5 .\cf22 format\cf5 (\cf16 animal\cf5 ),\cf16  is_cat_eq\cf5 )\cf16 \cb1 \
\
\cb15 is_cat_ne \cf5 =\cf16  \cf21 "cat"\cf16  \cf5 !=\cf16  animal\cb1 \
\cf5 \cb15 print(\cf21 'Is "cat" not equal to "\{\}"?'\cf5 .\cf22 format\cf5 (\cf16 animal\cf5 ),\cf16  is_cat_ne\cf5 )\cf16 \cb1 \
\
\cb15 is_bird_eq \cf5 =\cf16  \cf21 "bird"\cf16  \cf5 ==\cf16  animal\cb1 \
\cf5 \cb15 print(\cf21 'Is "bird" equal to "\{\}"?'\cf5 .\cf22 format\cf5 (\cf16 animal\cf5 ),\cf16  is_bird_eq\cf5 )\cf16 \cb1 \
\
\cb15 is_cat_gt \cf5 =\cf16  \cf21 "CAT"\cf16  \cf5 >\cf16  animal\cb1 \
\cf5 \cb15 print(\cf21 'Is "CAT" greater than "\{\}"?'\cf5 .\cf22 format\cf5 (\cf16 animal\cf5 ),\cf16  is_cat_gt\cf5 )\cf16 \cb1 \
\
\cb15 is_ge_cat \cf5 =\cf16  animal \cf5 >=\cf16  \cf21 "CAT"\cf16 \cb1 \
\cf5 \cb15 print(\cf21 'Is "\{\}" greater than or equal to "CAT"?'\cf5 .\cf22 format\cf5 (\cf16 animal\cf5 ),\cf16  is_ge_cat\cf5 )\cf16 \cb1 \
\pard\pardeftab720\qc\partightenfactor0

\fs32 \cf17 \
\pard\pardeftab720\qc\partightenfactor0
\cf18 \
\pard\pardeftab720\partightenfactor0

\fs28 \cf16 \cb15 Is "cat" equal to "bird"? False\cb1 \
\cb15 Is "cat" not equal to "bird"? True\cb1 \
\cb15 Is "bird" equal to "bird"? True\cb1 \
\cb15 Is "CAT" greater than "bird"? False\cb1 \
\cb15 Is "bird" greater than or equal to "CAT"? True\cb1 \
