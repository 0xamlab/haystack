\fs40 \cf2 String indexing and slicing\
\pard\pardeftab720\sa320\partightenfactor0

\fs28 \cf10 \cb12 String
\fs32 \cf2 \cb1 , 
\fs28 \cf10 \cb12 StringLiteral
\fs32 \cf2 \cb1 , and 
\fs28 \cf10 \cb12 StringSlice
\fs32 \cf2 \cb1  allow you to use indexing to return a single byte. Byte positions are identified with a zero-based index starting from the first byte. You can also specify a negative index to count backwards from the end of the string, with the last character identified by index -1. Specifying an index beyond the bounds of the string results in a run-time error.\
\pard\pardeftab720\partightenfactor0

\fs28 \cf5 \cb15 var\cf16  alphabet \cf5 =\cf16  \cf21 "ABCDEFGHIJKLMNOPQRSTUVWXYZ"\cf16   \cf6 # String type value\cf16 \cb1 \
\cf5 \cb15 print(\cf16 alphabet\cf5 [\cf16 byte\cf5 =\cf14 0\cf5 ],\cf16  alphabet\cf5 [\cf16 byte\cf5 =-\cf14 1\cf5 ])\cf16 \cb1 \
\
\cf6 \cb15 # The following would produce a run-time error\cf16 \cb1 \
\cf6 \cb15 # print(alphabet[45])\cf16 \cb1 \
\pard\pardeftab720\qc\partightenfactor0

\fs32 \cf17 \
\pard\pardeftab720\qc\partightenfactor0
\cf18 \
\pard\pardeftab720\partightenfactor0

\fs28 \cf16 \cb15 A Z\cb1 \
\pard\pardeftab720\sa320\partightenfactor0

\fs32 \cf2 The 
\fs28 \cf10 \cb12 String
\fs32 \cf2 \cb1  and 
\fs28 \cf10 \cb12 StringSlice
\fs32 \cf2 \cb1  types\'97but not the 
\fs28 \cf10 \cb12 StringLiteral
\fs32 \cf2 \cb1  type\'97also support slices to return a substring from the original 
\fs28 \cf10 \cb12 String
\fs32 \cf2 \cb1 . Providing a slice in the form 
\fs28 \cf10 \cb12 [start:end]
\fs32 \cf2 \cb1  returns a substring starting with the character index specified by 
\fs28 \cf10 \cb12 start
\fs32 \cf2 \cb1  and continuing up to but not including the character at index 
\fs28 \cf10 \cb12 end
\fs32 \cf2 \cb1 . You can use positive or negative indexing for both the start and end values. Omitting 
\fs28 \cf10 \cb12 start
\fs32 \cf2 \cb1  is the same as specifying 
\fs28 \cf10 \cb12 0
\fs32 \cf2 \cb1 , and omitting 
\fs28 \cf10 \cb12 end
\fs32 \cf2 \cb1  is the same as specifying the length of the string.\
\pard\pardeftab720\partightenfactor0

\fs28 \cf5 \cb15 var\cf16  alphabet \cf5 =\cf16  \cf21 "ABCDEFGHIJKLMNOPQRSTUVWXYZ"\cf16  \cf6 # String type value\cf16 \cb1 \
\cf5 \cb15 print(\cf16 alphabet\cf5 [\cf16 byte\cf5 =\cf14 1\cf5 :\cf14 4\cf5 ])\cf16   \cf6 # The 2nd through 4th characters\cf16 \cb1 \
\cf5 \cb15 print(\cf16 alphabet\cf5 [\cf16 byte\cf5 =:\cf14 6\cf5 ])\cf16    \cf6 # The first 6 characters\cf16 \cb1 \
\cf5 \cb15 print(\cf16 alphabet\cf5 [\cf16 byte\cf5 =-\cf14 6\cf5 :])\cf16   \cf6 # The last 6 characters\cf16 \cb1 \
\pard\pardeftab720\qc\partightenfactor0

\fs32 \cf17 \
\pard\pardeftab720\qc\partightenfactor0
\cf18 \
\pard\pardeftab720\partightenfactor0

\fs28 \cf16 \cb15 BCD\cb1 \
\cb15 ABCDEF\cb1 \
\cb15 UVWXYZ\cb1 \
