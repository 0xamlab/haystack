\cb15         self\cf5 .\cf16 re \cf5 +=\cf16  rhs\cf5 .\cf16 re\cb1 \
\cb15         self\cf5 .\cf16 im \cf5 +=\cf16  rhs\cf5 .\cf16 im\cb1 \
\
\cb15     \cf5 def\cf16  \cf22 __iadd__\cf5 (mut\cf16  self\cf5 ,\cf16  rhs\cf5 :\cf16  Float64\cf5 )\cf16  raises \cf5 ->\cf16  \cf14 None\cf5 :\cf16 \cb1 \
\cb15         self\cf5 .\cf16 re \cf5 +=\cf16  rhs\cb1 \
\
\cb15     \cf5 def\cf16  \cf22 __isub__\cf5 (mut\cf16  self\cf5 ,\cf16  rhs\cf5 :\cf16  Self\cf5 )\cf16  raises \cf5 ->\cf16  \cf14 None\cf5 :\cf16 \cb1 \
\cb15         self\cf5 .\cf16 re \cf5 -=\cf16  rhs\cf5 .\cf16 re\cb1 \
\cb15         self\cf5 .\cf16 im \cf5 -=\cf16  rhs\cf5 .\cf16 im\cb1 \
\
\cb15     \cf5 def\cf16  \cf22 __isub__\cf5 (mut\cf16  self\cf5 ,\cf16  rhs\cf5 :\cf16  Float64\cf5 )\cf16  raises \cf5 ->\cf16  \cf14 None\cf5 :\cf16 \cb1 \
\cb15         self\cf5 .\cf16 re \cf5 -=\cf16  rhs\cb1 \
\
\cb15     \cf5 def\cf16  \cf22 __imul__\cf5 (mut\cf16  self\cf5 ,\cf16  rhs\cf5 :\cf16  Self\cf5 )\cf16  raises \cf5 ->\cf16  \cf14 None\cf5 :\cf16 \cb1 \
\cb15         new_re \cf5 =\cf16  self\cf5 .\cf16 re \cf5 *\cf16  rhs\cf5 .\cf16 re \cf5 -\cf16  self\cf5 .\cf16 im \cf5 *\cf16  rhs\cf5 .\cf16 im\cb1 \
\cb15         new_im \cf5 =\cf16  self\cf5 .\cf16 re \cf5 *\cf16  rhs\cf5 .\cf16 im \cf5 +\cf16  self\cf5 .\cf16 im \cf5 *\cf16  rhs\cf5 .\cf16 re\cb1 \
\cb15         self\cf5 .\cf16 re \cf5 =\cf16  new_re\cb1 \
\cb15         self\cf5 .\cf16 im \cf5 =\cf16  new_im\cb1 \
\
\cb15     \cf5 def\cf16  \cf22 __imul__\cf5 (mut\cf16  self\cf5 ,\cf16  rhs\cf5 :\cf16  Float64\cf5 )\cf16  raises \cf5 ->\cf16  \cf14 None\cf5 :\cf16 \cb1 \
\cb15         self\cf5 .\cf16 re \cf5 *=\cf16  rhs\cb1 \
\cb15         self\cf5 .\cf16 im \cf5 *=\cf16  rhs\cb1 \
\
