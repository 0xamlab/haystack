\fs28 \cf5 \cb15 (\cf14 5\cf16  \cf5 +\cf16  \cf5 (\cf14 4\cf16  \cf5 *\cf16  \cf5 (\cf14 3\cf16  \cf5 **\cf16  \cf14 2\cf5 )))\cf16  \cf5 -\cf16  \cf14 1\cf16 \cb1 \
\pard\pardeftab720\qc\partightenfactor0

