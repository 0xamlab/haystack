\fs28 \cf14 \cb15 5\cf16  \cf5 +\cf16  \cf14 4\cf16  \cf5 *\cf16  \cf14 3\cf16  \cf5 **\cf16  \cf14 2\cf16  \cf5 -\cf16  \cf14 1\cf16 \cb1 \
\pard\pardeftab720\qc\partightenfactor0

