\cb15         \cf5 return\cf16  Self\cf5 (\cf16 self\cf5 .\cf16 re \cf5 -\cf16  rhs\cf5 .\cf16 re\cf5 ,\cf16  self\cf5 .\cf16 im \cf5 -\cf16  rhs\cf5 .\cf16 im\cf5 )\cf16 \cb1 \
\
\cb15     \cf5 def\cf16  \cf22 __mul__\cf5 (\cf16 self\cf5 ,\cf16  rhs\cf5 :\cf16  Self\cf5 )\cf16  raises \cf5 ->\cf16  Self\cf5 :\cf16 \cb1 \
\cb15         \cf5 return\cf16  Self\cf5 (\cf16 \cb1 \
\cb15             self\cf5 .\cf16 re \cf5 *\cf16  rhs\cf5 .\cf16 re \cf5 -\cf16  self\cf5 .\cf16 im \cf5 *\cf16  rhs\cf5 .\cf16 im\cf5 ,\cf16 \cb1 \
\cb15             self\cf5 .\cf16 re \cf5 *\cf16  rhs\cf5 .\cf16 im \cf5 +\cf16  self\cf5 .\cf16 im \cf5 *\cf16  rhs\cf5 .\cf16 re\cb1 \
