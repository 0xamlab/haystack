\cb15         denom \cf5 =\cf16  rhs\cf5 .\cf16 squared_norm\cf5 ()\cf16 \cb1 \
\cb15         new_re \cf5 =\cf16  \cf5 (\cf16 self\cf5 .\cf16 re \cf5 *\cf16  rhs\cf5 .\cf16 re \cf5 +\cf16  self\cf5 .\cf16 im \cf5 *\cf16  rhs\cf5 .\cf16 im\cf5 )\cf16  \cf5 /\cf16  denom\cb1 \
\cb15         new_im \cf5 =\cf16  \cf5 (\cf16 self\cf5 .\cf16 im \cf5 *\cf16  rhs\cf5 .\cf16 re \cf5 -\cf16  self\cf5 .\cf16 re \cf5 *\cf16  rhs\cf5 .\cf16 im\cf5 )\cf16  \cf5 /\cf16  denom\cb1 \
