\fs28 \cf5 \cb13 %%\cf12 mojo\cb1 \
\
\pard\pardeftab720\partightenfactor0
\cf6 \cb13 # Compiler-parameterized function\cf12 \cb1 \
\pard\pardeftab720\partightenfactor0
\cf5 \cb13 def\cf12  repeat\cf5 [\cf12 count\cf5 :\cf12  Int\cf5 ](\cf12 msg\cf5 :\cf12  String\cf5 ):\cf12 \cb1 \
\cb13     \cf5 comptime\cf12  \cf5 for\cf12  i \cf5 in\cf12  \cf18 range\cf5 (\cf12 count\cf5 ):\cf12 \cb1 \
\cb13         \cf5 print(\cf12 msg\cf5 )\cf12 \cb1 \
\
\pard\pardeftab720\partightenfactor0
