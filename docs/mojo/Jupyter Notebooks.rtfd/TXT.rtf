\fs48 \cf2 Hello, Apple Silicon\
\pard\pardeftab720\sa320\partightenfactor0

\fs32 \cf2 On Apple Silicon, 
\fs28 \cf10 \cb16 print()
\fs32 \cf2 \cb1  isn't available inside GPU kernels. But you can still say hello.\
Instead of printing from the kernel, write a value to device memory and read it back on the host:\
\pard\pardeftab720\partightenfactor0

\fs28 \cf5 \cb13 %%\cf12 mojo\cb1 \
\cf5 \cb13 from\cf12  std\cf5 .\cf12 memory \cf5 import\cf12  UnsafePointer\cb1 \
\cf5 \cb13 from\cf12  std\cf5 .\cf12 gpu\cf5 .\cf12 host \cf5 import\cf12  DeviceContext\cb1 \
\
\cf5 \cb13 comptime\cf12  `\uc0\u9989 `\cf5 :\cf12  Int32 \cf5 =\cf12  \cf17 1\cf12 \cb1 \
\cf5 \cb13 comptime\cf12  `\uc0\u10060 `\cf5 :\cf12  Int32 \cf5 =\cf12  \cf17 0\cf12 \cb1 \
\
\cf5 \cb13 def\cf12  \cf18 kernel\cf5 (\cf12 value\cf5 :\cf12  UnsafePointer\cf5 [\cf12 Scalar\cf5 [\cf12 DType\cf5 .\cf12 int32\cf5 ],\cf12  MutAnyOrigin\cf5 ]):\cf12 \cb1 \
\cb13     value\cf5 [\cf17 0\cf5 ]\cf12  \cf5 =\cf12  `\uc0\u9989 `\cb1 \
\
\cf5 \cb13 def\cf12  \cf18 main\cf5 ()\cf12  raises\cf5 :\cf12 \cb1 \
\cb13     \cf5 with\cf12  DeviceContext\cf5 ()\cf12  \cf5 as\cf12  ctx\cf5 :\cf12 \cb1 \
\cb13         \cf6 # Build it\cf12 \cb1 \
\cb13         \cf5 var\cf12  \cf5 out\cf12  \cf5 =\cf12  ctx\cf5 .\cf12 enqueue_create_buffer\cf5 [\cf12 DType\cf5 .\cf12 int32\cf5 ](\cf17 1\cf5 )\cf12 \cb1 \
\cb13         \cf5 out.\cf12 enqueue_fill\cf5 (\cf12 `\uc0\u10060 `\cf5 )\cf12 \cb1 \
\
\cb13         \cf6 # Run it\cf12 \cb1 \
\cb13         ctx\cf5 .\cf12 enqueue_function\cf5 [\cf12 kernel\cf5 ,\cf12  kernel\cf5 ](out,\cf12  grid_dim\cf5 =\cf17 1\cf5 ,\cf12  block_dim\cf5 =\cf17 1\cf5 )\cf12 \cb1 \
\
\cb13         \cf6 # Report the result\cf12 \cb1 \
\cb13         \cf5 with\cf12  \cf5 out.\cf12 map_to_host\cf5 ()\cf12  \cf5 as\cf12  out_host\cf5 :\cf12 \cb1 \
\cb13             \cf5 print(\cf19 "GPU responded:"\cf5 ,\cf12  \cf19 "\uc0\u55357 \u56395 , \u55357 \u56613 "\cf12  \cf5 if\cf12  out_host\cf5 [\cf17 0\cf5 ]\cf12  \cf5 ==\cf12  `\uc0\u9989 ` \cf5 else\cf12  \cf19 "\uc0\u55357 \u56866 "\cf5 )\cf12 \cb1 \
\pard\pardeftab720\qc\partightenfactor0

\fs32 \cf14 \
\pard\pardeftab720\qc\partightenfactor0
\cf15 \
\pard\pardeftab720\sa320\partightenfactor0
\cf2 While 
\fs28 \cf10 \cb16 print()
\fs32 \cf2 \cb1  isn't supported inside Apple Silicon GPU kernels, the final report runs on the CPU and is safe to run.\
\pard\pardeftab720\sa320\partightenfactor0

\fs48 \cf2 Example: GPU vector addition\
\pard\pardeftab720\sa320\partightenfactor0

\fs32 \cf2 This example runs elementwise vector addition on the GPU. Each GPU thread updates one element.\
\pard\pardeftab720\partightenfactor0

\fs28 \cf5 \cb13 %%\cf12 mojo\cb1 \
\
\cf5 \cb13 from\cf12  std\cf5 .\cf12 gpu \cf5 import\cf12  thread_idx\cb1 \
\cf5 \cb13 from\cf12  std\cf5 .\cf12 gpu\cf5 .\cf12 host \cf5 import\cf12  DeviceContext\cb1 \
\cf5 \cb13 from\cf12  layout \cf5 import\cf12  Layout\cf5 ,\cf12  LayoutTensor\cb1 \
\cf5 \cb13 from\cf12  std\cf5 .\cf12 sys \cf5 import\cf12  has_accelerator\cb1 \
\
\cf5 \cb13 comptime\cf12  VECTOR_WIDTH \cf5 =\cf12  \cf17 10\cf12 \cb1 \
\cf5 \cb13 comptime\cf12  layout \cf5 =\cf12  Layout\cf5 .\cf12 row_major\cf5 (\cf12 VECTOR_WIDTH\cf5 )\cf12 \cb1 \
\cf5 \cb13 comptime\cf12  active_dtype \cf5 =\cf12  DType\cf5 .\cf12 uint8\cb1 \
\cf5 \cb13 comptime\cf12  Tensor \cf5 =\cf12  LayoutTensor\cf5 [\cf12 active_dtype\cf5 ,\cf12  layout\cf5 ,\cf12  MutAnyOrigin\cf5 ]\cf12 \cb1 \
\
\
\pard\pardeftab720\partightenfactor0
\cf6 \cb13 # Elementwise vector addition on GPU threads\cf12 \cb1 \
\pard\pardeftab720\partightenfactor0
\cf5 \cb13 def\cf12  \cf18 vector_addition\cf5 (\cf12 left\cf5 :\cf12  Tensor\cf5 ,\cf12  right\cf5 :\cf12  Tensor\cf5 ,\cf12  output\cf5 :\cf12  Tensor\cf5 ):\cf12 \cb1 \
\cb13     \cf5 var\cf12  idx \cf5 =\cf12  thread_idx\cf5 .\cf12 x\cb1 \
\cb13     output\cf5 [\cf12 idx\cf5 ]\cf12  \cf5 =\cf12  left\cf5 [\cf12 idx\cf5 ]\cf12  \cf5 +\cf12  right\cf5 [\cf12 idx\cf5 ]\cf12 \cb1 \
\
\
\cf5 \cb13 def\cf12  \cf18 main\cf5 ()\cf12  raises\cf5 :\cf12 \cb1 \
\cb13     \cf6 # Ensure a supported GPU (NVIDIA or AMD) is available\cf12 \cb1 \
\cb13     \cf5 comptime\cf12  \cf5 assert\cf12  has_accelerator\cf5 (),\cf12  \cf19 "This example requires a supported GPU"\cf12 \cb1 \
\
\cb13     \cf6 # Create GPU device context\cf12 \cb1 \
\cb13     \cf5 var\cf12  ctx \cf5 =\cf12  DeviceContext\cf5 ()\cf12 \cb1 \
\
\cb13     \cf6 # Allocate buffers and tensors for left and right operands, and output\cf12 \cb1 \
\cb13     \cf5 var\cf12  left_buffer \cf5 =\cf12  ctx\cf5 .\cf12 enqueue_create_buffer\cf5 [\cf12 active_dtype\cf5 ](\cf12 VECTOR_WIDTH\cf5 )\cf12 \cb1 \
\cb13     \cf5 var\cf12  left_tensor \cf5 =\cf12  Tensor\cf5 (\cf12 left_buffer\cf5 )\cf12 \cb1 \
\
\cb13     \cf5 var\cf12  right_buffer \cf5 =\cf12  ctx\cf5 .\cf12 enqueue_create_buffer\cf5 [\cf12 active_dtype\cf5 ](\cf12 VECTOR_WIDTH\cf5 )\cf12 \cb1 \
\cb13     \cf5 var\cf12  right_tensor \cf5 =\cf12  Tensor\cf5 (\cf12 right_buffer\cf5 )\cf12 \cb1 \
\
\cb13     \cf5 var\cf12  output_buffer \cf5 =\cf12  ctx\cf5 .\cf12 enqueue_create_buffer\cf5 [\cf12 active_dtype\cf5 ](\cf12 VECTOR_WIDTH\cf5 )\cf12 \cb1 \
\cb13     \cf5 var\cf12  output_tensor \cf5 =\cf12  Tensor\cf5 (\cf12 output_buffer\cf5 )\cf12 \cb1 \
\
\cb13     \cf6 # Initialize input buffers with sample data\cf12 \cb1 \
\cb13     \cf5 var\cf12  message_bytes\cf5 :\cf12  List\cf5 [\cf12 UInt8\cf5 ]\cf12  \cf5 =\cf12  \cf5 [\cf12 \cb1 \
\cb13         \cf17 71\cf5 ,\cf12  \cf17 100\cf5 ,\cf12  \cf17 107\cf5 ,\cf12  \cf17 107\cf5 ,\cf12  \cf17 110\cf5 ,\cf12  \cf17 31\cf5 ,\cf12  \cf17 76\cf5 ,\cf12  \cf17 110\cf5 ,\cf12  \cf17 105\cf5 ,\cf12  \cf17 110\cf12 \cb1 \
\cb13     \cf5 ]\cf12 \cb1 \
\cb13     \cf5 with\cf12  left_buffer\cf5 .\cf12 map_to_host\cf5 ()\cf12  \cf5 as\cf12  mapped_buffer\cf5 :\cf12 \cb1 \
\cb13         \cf5 var\cf12  mapped_tensor \cf5 =\cf12  Tensor\cf5 (\cf12 mapped_buffer\cf5 )\cf12 \cb1 \
\cb13         \cf5 for\cf12  idx \cf5 in\cf12  \cf18 range\cf5 (\cf12 VECTOR_WIDTH\cf5 ):\cf12 \cb1 \
\cb13             mapped_tensor\cf5 [\cf12 idx\cf5 ]\cf12  \cf5 =\cf12  message_bytes\cf5 [\cf12 idx\cf5 ]\cf12 \cb1 \
\cb13     _ \cf5 =\cf12  right_buffer\cf5 .\cf12 enqueue_fill\cf5 (\cf17 1\cf5 )\cf12 \cb1 \
\
\cb13     \cf6 # Launch GPU kernel\cf12 \cb1 \
\cb13     ctx\cf5 .\cf12 enqueue_function\cf5 [\cf12 vector_addition\cf5 ,\cf12  vector_addition\cf5 ](\cf12 \cb1 \
\cb13         left_tensor\cf5 ,\cf12 \cb1 \
\cb13         right_tensor\cf5 ,\cf12 \cb1 \
\cb13         output_tensor\cf5 ,\cf12 \cb1 \
\cb13         grid_dim\cf5 =\cf17 1\cf5 ,\cf12 \cb1 \
\cb13         block_dim\cf5 =\cf12 VECTOR_WIDTH\cf5 ,\cf12 \cb1 \
\cb13     \cf5 )\cf12 \cb1 \
\cb13     ctx\cf5 .\cf12 synchronize\cf5 ()\cf12 \cb1 \
\
\cb13     \cf6 # Read results back and print as ASCII\cf12 \cb1 \
\cb13     \cf5 with\cf12  output_buffer\cf5 .\cf12 map_to_host\cf5 ()\cf12  \cf5 as\cf12  mapped_buffer\cf5 :\cf12 \cb1 \
\cb13         \cf5 var\cf12  mapped_tensor \cf5 =\cf12  Tensor\cf5 (\cf12 mapped_buffer\cf5 )\cf12 \cb1 \
\cb13         \cf5 for\cf12  idx \cf5 in\cf12  \cf18 range\cf5 (\cf12 VECTOR_WIDTH\cf5 ):\cf12 \cb1 \
\cb13             \cf5 print(\cf18 chr\cf5 (\cf12 Int\cf5 (\cf12 mapped_tensor\cf5 [\cf12 idx\cf5 ])),\cf12  end\cf5 =\cf19 ""\cf5 )\cf12 \cb1 \
\cb13         \cf5 print()\cf12 \cb1 \
\pard\pardeftab720\qc\partightenfactor0

