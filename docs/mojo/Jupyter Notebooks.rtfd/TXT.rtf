\fs64 \cf2 Using Mojo with GPU support\
\pard\pardeftab720\sa320\partightenfactor0

\fs32 \cf2 Google Colab offers GPU-backed runtimes so you can run Mojo GPU examples even without local hardware. T4, L4, and A100 accelerators are supported. Before running GPU code, select Runtime > Change runtime type > [GPU].\
\pard\pardeftab720\sa320\partightenfactor0

\fs48 \cf2 Example: GPU Hello World\
\pard\pardeftab720\partightenfactor0

\fs28 \cf5 \cb13 %%\cf12 mojo\cb1 \
\
\cf5 \cb13 from\cf12  std\cf5 .\cf12 gpu\cf5 .\cf12 host \cf5 import\cf12  DeviceContext\cb1 \
\
\cf5 \cb13 def\cf12  \cf18 kernel\cf5 ():\cf12 \cb1 \
\cb13     \cf6 # This call does not work on Apple Silicon\cf12 \cb1 \
\cb13     \cf5 print(\cf19 "Hello from the GPU"\cf5 )\cf12 \cb1 \
\
\cf5 \cb13 def\cf12  \cf18 main\cf5 ()\cf12  raises\cf5 :\cf12 \cb1 \
\cb13     \cf6 # Launch GPU kernel\cf12 \cb1 \
\cb13     \cf5 with\cf12  DeviceContext\cf5 ()\cf12  \cf5 as\cf12  ctx\cf5 :\cf12 \cb1 \
\cb13         ctx\cf5 .\cf12 enqueue_function\cf5 [\cf12 kernel\cf5 ,\cf12  kernel\cf5 ](\cf12 grid_dim\cf5 =\cf17 1\cf5 ,\cf12  block_dim\cf5 =\cf17 1\cf5 )\cf12 \cb1 \
\cb13         ctx\cf5 .\cf12 synchronize\cf5 ()\cf12 \cb1 \
\pard\pardeftab720\qc\partightenfactor0

