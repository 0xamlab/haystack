\pard\pardeftab720\partightenfactor0

\fs28 \cf13 \cb14 Short-circuit "or" evaluation\cb1 \
\cb14 Executing true_func\cb1 \
\cb14 True result\cb1 \
\pard\pardeftab720\sa320\partightenfactor0

\fs32 \cf2 If the first argument to an 
\fs28 \cf10 \cb12 and
\fs32 \cf2 \cb1  operator evaluates to 
\fs28 \cf10 \cb12 False
\fs32 \cf2 \cb1 , the second argument is not evaluated.\
\pard\pardeftab720\partightenfactor0

\fs28 \cf5 \cb14 print(\cf16 'Short-circuit "and" evaluation'\cf5 )\cf13 \cb1 \
\cf5 \cb14 if\cf13  false_func\cf5 ()\cf13  \cf5 and\cf13  true_func\cf5 ():\cf13 \cb1 \
\cb14     \cf5 print(\cf16 "True result"\cf5 )\cf13 \cb1 \
\pard\pardeftab720\qc\partightenfactor0

