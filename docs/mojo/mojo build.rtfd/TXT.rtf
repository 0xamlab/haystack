\fs35 \cf10 \cb16 --ignore-incompatible-package-errors
\fs40 \cf2 \cb1 \
\pard\pardeftab720\sa320\partightenfactor0

\fs32 \cf2 Ignore errors encountered when loading incompatible Mojo packages.\
\pard\pardeftab720\sa320\partightenfactor0

\fs48 \cf2 Linker options\
\pard\pardeftab720\sa320\partightenfactor0

\fs35 \cf10 \cb16 -Xlinker <ARG>
\fs40 \cf2 \cb1 \
\pard\pardeftab720\sa320\partightenfactor0

\fs32 \cf2 Pass ARG to the linker.\
\pard\pardeftab720\sa320\partightenfactor0

\fs48 \cf2 Experimental compilation options\
\pard\pardeftab720\sa320\partightenfactor0

\fs35 \cf10 \cb16 --sanitize <CHECK>
\fs40 \cf2 \cb1 \
\pard\pardeftab720\sa320\partightenfactor0

\fs32 \cf2 Turns on runtime checks. The following values are supported: 
\fs28 \cf10 \cb16 address
\fs32 \cf2 \cb1  (detects memory issues), and 
\fs28 \cf10 \cb16 thread
\fs32 \cf2 \cb1  (detects multi-threading issues).\
\pard\pardeftab720\sa320\partightenfactor0

\fs35 \cf10 \cb16 --shared-libasan
\fs40 \cf2 \cb1 \
\pard\pardeftab720\sa320\partightenfactor0

\fs32 \cf2 Dynamically link the address sanitizer runtime. Requires address sanitization turned on with 
\fs28 \cf10 \cb16 --sanitize
\fs32 \cf2 \cb1  option.\
\pard\pardeftab720\sa320\partightenfactor0

\fs35 \cf10 \cb16 --debug-info-language <LANGUAGE>
\fs40 \cf2 \cb1 \
\pard\pardeftab720\sa320\partightenfactor0

\fs32 \cf2 Sets the language to emit as part of the debug info. The supported languages are: 
\fs28 \cf10 \cb16 Mojo
\fs32 \cf2 \cb1 , and 
\fs28 \cf10 \cb16 C
\fs32 \cf2 \cb1 . 
\fs28 \cf10 \cb16 Mojo
\fs32 \cf2 \cb1  is the default. 
\fs28 \cf10 \cb16 C
\fs32 \cf2 \cb1  is useful to enable rudimentary debugging and binary introspection in tools that don't understand Mojo, but is not required for 
\fs28 \cf10 \cb16 mojo debug
\fs32 \cf2 \cb1 .\
\pard\pardeftab720\sa320\partightenfactor0

