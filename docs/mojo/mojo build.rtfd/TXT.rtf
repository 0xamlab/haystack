\fs96 \cf2 mojo build\
\pard\pardeftab720\sa400\partightenfactor0

\fs32 \cf2 Builds an executable from a Mojo file.\
\pard\pardeftab720\sa800\partightenfactor0

\fs64 \cf2 Synopsis\
\pard\pardeftab720\partightenfactor0

\fs28 \cf12 \cb13 mojo build [options] <path>\cb1 \
\pard\pardeftab720\qc\partightenfactor0

\fs32 \cf14 \
\pard\pardeftab720\qc\partightenfactor0
\cf15 \
\pard\pardeftab720\sa800\partightenfactor0

\fs64 \cf2 Description\
\pard\pardeftab720\sa320\partightenfactor0

\fs32 \cf2 Compiles the Mojo file at the given path into an executable.\
By default, the executable is saved to the current directory and named the same as the input file, but without a file extension.\
Beware that any Python libraries used in your Mojo project are not included in the executable binary, so they must be provided by the environment where you run the executable.\
\pard\pardeftab720\sa800\partightenfactor0

\fs64 \cf2 Options\
\pard\pardeftab720\sa320\partightenfactor0

\fs48 \cf2 Output options\
\pard\pardeftab720\sa320\partightenfactor0

\fs35 \cf10 \cb16 -o <PATH>
\fs40 \cf2 \cb1 \
\pard\pardeftab720\sa320\partightenfactor0

\fs32 \cf2 Sets the path and filename for the executable output. By default, it outputs the executable to the current directory, with the same name and no extension.\
\pard\pardeftab720\sa320\partightenfactor0

\fs35 \cf10 \cb16 --emit <FILE_TYPE>
\fs40 \cf2 \cb1 \
\pard\pardeftab720\sa320\partightenfactor0

\fs32 \cf2 The type of output file to generate.\
\pard\tx220\tx720\pardeftab720\li720\fi-720\partightenfactor0
\ls4\ilvl0
\fs28 \cf10 \cb16 \kerning1\expnd0\expndtw0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
exe
\fs32 \cf2 \cb1  (default): emit an executable binary file.\
\ls4\ilvl0
\fs28 \cf10 \cb16 \kerning1\expnd0\expndtw0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
shared-lib
\fs32 \cf2 \cb1 : emit a shared (dynamic) library.\
\ls4\ilvl0
\fs28 \cf10 \cb16 \kerning1\expnd0\expndtw0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
object
\fs32 \cf2 \cb1 : (EXPERIMENTAL) emit a single object file.\
\ls4\ilvl0
\fs28 \cf10 \cb16 \kerning1\expnd0\expndtw0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
llvm
\fs32 \cf2 \cb1 : emit unoptimized LLVM IR.\
\ls4\ilvl0
\fs28 \cf10 \cb16 \kerning1\expnd0\expndtw0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
llvm-bitcode
\fs32 \cf2 \cb1 : emit bitcode of unoptimized LLVM IR.\
\ls4\ilvl0
\fs28 \cf10 \cb16 \kerning1\expnd0\expndtw0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
asm
\fs32 \cf2 \cb1 : emit target assembly. For GPU targets, also emits a sidecar file per kernel alongside the host assembly: 
\fs28 \cf10 \cb16 .ptx
\fs32 \cf2 \cb1  for NVIDIA, 
\fs28 \cf10 \cb16 .amdgcn
\fs32 \cf2 \cb1  for AMD, 
\fs28 \cf10 \cb16 .ll
\fs32 \cf2 \cb1  for Metal.\
\pard\pardeftab720\sa320\partightenfactor0

\fs48 \cf2 Compilation options\
\pard\pardeftab720\sa320\partightenfactor0

\fs35 \cf10 \cb16 --optimization-level <LEVEL>
\fs40 \cf2 \cb1 , 
\fs35 \cf10 \cb16 -O
\fs40 \cf2 \cb1 , 
\fs35 \cf10 \cb16 --no-optimization (LEVEL=0)
\fs40 \cf2 \cb1 \
\pard\pardeftab720\sa320\partightenfactor0

\fs32 \cf2 Sets the level of optimization to use at compilation. The value must be a number between 0 and 3. The default is 3.\
\pard\pardeftab720\sa320\partightenfactor0

\fs35 \cf10 \cb16 -I <PATH>
\fs40 \cf2 \cb1 \
\pard\pardeftab720\sa320\partightenfactor0

\fs32 \cf2 Appends the given path to the list of directories to search for imported Mojo files.\
\pard\pardeftab720\sa320\partightenfactor0

\fs35 \cf10 \cb16 -D <KEY=VALUE>
\fs40 \cf2 \cb1 \
\pard\pardeftab720\sa320\partightenfactor0

\fs32 \cf2 Defines a named value that can be used from within the Mojo source file being executed. For example, 
\fs28 \cf10 \cb16 -Dfoo=42
\fs32 \cf2 \cb1  defines a name 
\fs28 \cf10 \cb16 foo
\fs32 \cf2 \cb1  that, when queried with the 
\fs28 \cf10 \cb16 sys.param_env
\fs32 \cf2 \cb1  module from within the Mojo program, would yield the compile-time value 
\fs28 \cf10 \cb16 42
\fs32 \cf2 \cb1 .\
\pard\pardeftab720\sa320\partightenfactor0

\fs35 \cf10 \cb16 --debug-level <LEVEL>
\fs40 \cf2 \cb1 , 
\fs35 \cf10 \cb16 -g (LEVEL=full)
\fs40 \cf2 \cb1 , 
\fs35 \cf10 \cb16 -g0 (LEVEL=none)
\fs40 \cf2 \cb1 , 
\fs35 \cf10 \cb16 -g1 (LEVEL=line-tables)
\fs40 \cf2 \cb1 , 
\fs35 \cf10 \cb16 -g2 (LEVEL=full)
\fs40 \cf2 \cb1 \
\pard\pardeftab720\sa320\partightenfactor0

\fs32 \cf2 Sets the level of debug info to use at compilation. The value must be one of: 
\fs28 \cf10 \cb16 none
\fs32 \cf2 \cb1 , 
\fs28 \cf10 \cb16 line-tables
\fs32 \cf2 \cb1 , or 
\fs28 \cf10 \cb16 full
\fs32 \cf2 \cb1 . Default is 
\fs28 \cf10 \cb16 none
\fs32 \cf2 \cb1 , except when using 
\fs28 \cf10 \cb16 mojo debug foo.mojo
\fs32 \cf2 \cb1 , which defaults to 
\fs28 \cf10 \cb16 full
\fs32 \cf2 \cb1 . Please note that there are issues when generating debug info for some Mojo programs that have yet to be addressed.\
\pard\pardeftab720\sa320\partightenfactor0

\fs35 \cf10 \cb16 --num-threads <NUM>
\fs40 \cf2 \cb1 , 
\fs35 \cf10 \cb16 -j
\fs40 \cf2 \cb1 \
\pard\pardeftab720\sa320\partightenfactor0

\fs32 \cf2 Sets the maximum number of threads to use for compilation. The default is 0 (use all available threads).\
\pard\pardeftab720\sa320\partightenfactor0

\fs35 \cf10 \cb16 --elaboration-error-include-prelude
\fs40 \cf2 \cb1 \
\pard\pardeftab720\sa320\partightenfactor0

\fs32 \cf2 Show elaboration error with locations in mojo startup modules (prelude).\
\pard\pardeftab720\sa320\partightenfactor0

\fs48 \cf2 Target options\
\pard\pardeftab720\sa320\partightenfactor0

\fs35 \cf10 \cb16 --target-triple <TRIPLE>
\fs40 \cf2 \cb1 \
\pard\pardeftab720\sa320\partightenfactor0

\fs32 \cf2 Sets the compilation target triple. Defaults to the host target.\
\pard\pardeftab720\sa320\partightenfactor0

\fs35 \cf10 \cb16 --target-cpu <CPU>
\fs40 \cf2 \cb1 \
\pard\pardeftab720\sa320\partightenfactor0

\fs32 \cf2 Sets the compilation target CPU. Defaults to the host CPU.\
\pard\pardeftab720\sa320\partightenfactor0

\fs35 \cf10 \cb16 --target-features <FEATURES>
\fs40 \cf2 \cb1 \
\pard\pardeftab720\sa320\partightenfactor0

\fs32 \cf2 Sets the compilation target CPU features. Defaults to the host features.\
\pard\pardeftab720\sa320\partightenfactor0

\fs35 \cf10 \cb16 --march <ARCHITECTURE>
\fs40 \cf2 \cb1 \
\pard\pardeftab720\sa320\partightenfactor0

\fs32 \cf2 Sets the architecture for which to generate code.\
\pard\pardeftab720\sa320\partightenfactor0

\fs35 \cf10 \cb16 --mcpu <CPU>
\fs40 \cf2 \cb1 \
\pard\pardeftab720\sa320\partightenfactor0

\fs32 \cf2 Sets the CPU for which to generate code.\
\pard\pardeftab720\sa320\partightenfactor0

\fs35 \cf10 \cb16 --mtune <TUNE>
\fs40 \cf2 \cb1 \
\pard\pardeftab720\sa320\partightenfactor0

\fs32 \cf2 Sets the CPU for which to tune code.\
\pard\pardeftab720\sa320\partightenfactor0

\fs35 \cf10 \cb16 --target-accelerator <ACCELERATOR>
\fs40 \cf2 \cb1 \
\pard\pardeftab720\sa320\partightenfactor0

\fs32 \cf2 Sets the GPU or accelerator architecture for heterogeneous computing (e.g., sm_90 for NVIDIA H100, gfx942 for AMD MI300).\
\pard\pardeftab720\sa320\partightenfactor0

\fs35 \cf10 \cb16 --print-effective-target
\fs40 \cf2 \cb1 \
\pard\pardeftab720\sa320\partightenfactor0

\fs32 \cf2 Print the effective target configuration after absorbing all command-line flags and exit.\
\pard\pardeftab720\sa320\partightenfactor0

\fs35 \cf10 \cb16 --print-supported-targets
\fs40 \cf2 \cb1 \
\pard\pardeftab720\sa320\partightenfactor0

\fs32 \cf2 Print all available target names and exit.\
\pard\pardeftab720\sa320\partightenfactor0

\fs35 \cf10 \cb16 --print-supported-cpus
\fs40 \cf2 \cb1 \
\pard\pardeftab720\sa320\partightenfactor0

\fs32 \cf2 Print valid CPU names for the specified target and exit. Requires --target-triple.\
\pard\pardeftab720\sa320\partightenfactor0

\fs35 \cf10 \cb16 --print-supported-accelerators
\fs40 \cf2 \cb1 \
\pard\pardeftab720\sa320\partightenfactor0

\fs32 \cf2 Print all supported GPU and accelerator architectures and exit.\
\pard\pardeftab720\sa320\partightenfactor0

\fs48 \cf2 Compilation diagnostic options\
\pard\pardeftab720\sa320\partightenfactor0

\fs32 \cf2 Controls how the Mojo compiler outputs diagnostics related to compiling and running Mojo source code.\
\pard\pardeftab720\sa320\partightenfactor0

\fs35 \cf10 \cb16 --diagnose-missing-doc-strings
\fs40 \cf2 \cb1 \
\pard\pardeftab720\sa320\partightenfactor0

\fs32 \cf2 Emits diagnostics for missing or partial doc strings.\
\pard\pardeftab720\sa320\partightenfactor0

\fs35 \cf10 \cb16 --max-notes-per-diagnostic <INTEGER>
\fs40 \cf2 \cb1 \
\pard\pardeftab720\sa320\partightenfactor0

\fs32 \cf2 When the Mojo compiler emits diagnostics, it sometimes also prints notes with additional information. This option sets an upper threshold on the number of notes that can be printed with a diagnostic. If not specified, the default maximum is 10.\
\pard\pardeftab720\sa320\partightenfactor0

\fs35 \cf10 \cb16 --disable-builtins
\fs40 \cf2 \cb1 \
\pard\pardeftab720\sa320\partightenfactor0

\fs32 \cf2 Do not use builtins when create package.\
\pard\pardeftab720\sa320\partightenfactor0

\fs35 \cf10 \cb16 --disable-warnings
\fs40 \cf2 \cb1 \
\pard\pardeftab720\sa320\partightenfactor0

\fs32 \cf2 Do not print warning messages.\
\pard\pardeftab720\sa320\partightenfactor0

\fs35 \cf10 \cb16 --experimental-fixit
\fs40 \cf2 \cb1 \
\pard\pardeftab720\sa320\partightenfactor0

\fs32 \cf2 Automatically apply fix-its to the code, and rerun the command again after the fix-its are applied. WARNING: this feature is highly experimental and may result in irreversible data loss.\
\pard\pardeftab720\sa320\partightenfactor0

\fs35 \cf10 \cb16 --experimental-export-fixit <YAML_FILE>
\fs40 \cf2 \cb1 \
\pard\pardeftab720\sa320\partightenfactor0

\fs32 \cf2 Export fix-its to a YAML file in clang-tidy format instead of applying them directly. The file can be applied using 'clang-apply-replacements'. WARNING: this feature is highly experimental.\
\pard\pardeftab720\sa320\partightenfactor0

\fs35 \cf10 \cb16 --Werror
\fs40 \cf2 \cb1 \
\pard\pardeftab720\sa320\partightenfactor0

\fs32 \cf2 Treat warnings as errors.\
\pard\pardeftab720\sa320\partightenfactor0

\fs35 \cf10 \cb16 --Wno-error
\fs40 \cf2 \cb1 \
\pard\pardeftab720\sa320\partightenfactor0

\fs32 \cf2 Do not treat warnings as errors.\
\pard\pardeftab720\sa320\partightenfactor0

\fs35 \cf10 \cb16 --warn-on-unstable-apis
\fs40 \cf2 \cb1 \
\pard\pardeftab720\sa320\partightenfactor0

