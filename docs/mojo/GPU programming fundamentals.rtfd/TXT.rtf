\fs32 \cf2 Here is a complete example showing a kernel function that simply prints the thread block index, thread index, and global index for each thread executed.\
\pard\pardeftab720\partightenfactor0

\fs28\fsmilli14400 \cf13 \cb14 print_threads.mojo\
\pard\pardeftab720\partightenfactor0

\fs28 \cf5 \cb15 from\cf13  std\cf5 .\cf13 sys \cf5 import\cf13  exit\cf5 ,\cf13  has_accelerator\cf5 ,\cf13  has_apple_gpu_accelerator\cb1 \
\
\cf5 \cb15 from\cf13  std\cf5 .\cf13 gpu\cf5 .\cf13 host \cf5 import\cf13  DeviceContext\cb1 \
\cf5 \cb15 from\cf13  std\cf5 .\cf13 gpu \cf5 import\cf13  block_dim\cf5 ,\cf13  block_idx\cf5 ,\cf13  global_idx\cf5 ,\cf13  grid_dim\cf5 ,\cf13  thread_idx\cb1 \
\
\cf5 \cb15 def\cf13  \cf16 print_threads\cf5 ():\cf13 \cb1 \
\cb15     \cf17 """Print thread block and thread indices."""\cf13 \cb1 \
\
\cb15     \cf5 print(\cf13 \cb1 \
\cb15         \cf17 "block_idx: ["\cf5 ,\cf13 \cb1 \
\cb15             block_idx\cf5 .\cf13 x\cf5 ,\cf13 \cb1 \
\cb15             block_idx\cf5 .\cf13 y\cf5 ,\cf13 \cb1 \
\cb15             block_idx\cf5 .\cf13 z\cf5 ,\cf13 \cb1 \
\cb15         \cf17 "]\\tthread_idx: ["\cf5 ,\cf13 \cb1 \
\cb15             thread_idx\cf5 .\cf13 x\cf5 ,\cf13 \cb1 \
\cb15             thread_idx\cf5 .\cf13 y\cf5 ,\cf13 \cb1 \
\cb15             thread_idx\cf5 .\cf13 z\cf5 ,\cf13 \cb1 \
\cb15         \cf17 "]\\tglobal_idx: ["\cf5 ,\cf13 \cb1 \
\cb15             global_idx\cf5 .\cf13 x\cf5 ,\cf13 \cb1 \
\cb15             global_idx\cf5 .\cf13 y\cf5 ,\cf13 \cb1 \
\cb15             global_idx\cf5 .\cf13 z\cf5 ,\cf13 \cb1 \
\cb15         \cf17 "]\\tcalculated global_idx: ["\cf5 ,\cf13 \cb1 \
\cb15             block_dim\cf5 .\cf13 x \cf5 *\cf13  block_idx\cf5 .\cf13 x \cf5 +\cf13  thread_idx\cf5 .\cf13 x\cf5 ,\cf13 \cb1 \
\cb15             block_dim\cf5 .\cf13 y \cf5 *\cf13  block_idx\cf5 .\cf13 y \cf5 +\cf13  thread_idx\cf5 .\cf13 y\cf5 ,\cf13 \cb1 \
\cb15             block_dim\cf5 .\cf13 z \cf5 *\cf13  block_idx\cf5 .\cf13 z \cf5 +\cf13  thread_idx\cf5 .\cf13 z\cf5 ,\cf13 \cb1 \
\cb15         \cf17 "]"\cf5 ,\cf13 \cb1 \
\cb15     \cf5 )\cf13 \cb1 \
\
\cf5 \cb15 def\cf13  \cf16 main\cf5 ()\cf13  raises\cf5 :\cf13 \cb1 \
\cb15     \cf5 comptime\cf13  \cf5 for\cf13  \cf5 not\cf13  has_accelerator\cf5 ():\cf13 \cb1 \
\cb15         \cf5 print(\cf17 "No compatible GPU found"\cf5 )\cf13 \cb1 \
\cb15     \cf5 elif\cf13  has_apple_gpu_accelerator\cf5 ():\cf13 \cb1 \
\cb15         \cf5 print(\cf13 \cb1 \
\cb15             \cf17 "Printing from a kernel is not currently supported on Apple silicon"\cf13 \cb1 \
\cb15             \cf17 " GPUs"\cf13 \cb1 \
\cb15         \cf5 )\cf13 \cb1 \
\cb15     \cf5 else:\cf13 \cb1 \
\cb15         \cf6 # Initialize GPU context for device 0 (default GPU device).\cf13 \cb1 \
\cb15         ctx \cf5 =\cf13  DeviceContext\cf5 ()\cf13 \cb1 \
\
\cb15         ctx\cf5 .\cf13 enqueue_function\cf5 [\cf13 print_threads\cf5 ,\cf13  print_threads\cf5 ](\cf13 \cb1 \
\cb15             grid_dim\cf5 =(\cf22 2\cf5 ,\cf13  \cf22 2\cf5 ,\cf13  \cf22 1\cf5 ),\cf13   \cf6 # 2x2x1 blocks per grid\cf13 \cb1 \
\cb15             block_dim\cf5 =(\cf22 4\cf5 ,\cf13  \cf22 4\cf5 ,\cf13  \cf22 2\cf5 ),\cf13   \cf6 # 4x4x2 threads per block\cf13 \cb1 \
\cb15         \cf5 )\cf13 \cb1 \
\
\cb15         ctx\cf5 .\cf13 synchronize\cf5 ()\cf13 \cb1 \
\cb15         \cf5 print(\cf17 "Done"\cf5 )\cf13 \cb1 \
\pard\pardeftab720\qc\partightenfactor0

