\cb15         \cf5 print(\cf17 "GPU detected"\cf5 )\cf13 \cb1 \
\cb15         \cf6 # Enable GPU processing\cf13 \cb1 \
\cb15     \cf5 else:\cf13 \cb1 \
\cb15         \cf5 print(\cf17 "No GPU detected"\cf5 )\cf13 \cb1 \
\cb15         \cf6 # Print error or fall back to CPU-only execution\cf13 \cb1 \
