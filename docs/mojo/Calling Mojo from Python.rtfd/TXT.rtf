\fs28\fsmilli14400 \cf14 \cb19 \uc0\u55357 \u56333  Python\
\pard\pardeftab720\partightenfactor0

\fs28 \cf14 \cb15 counter \cf5 =\cf14  counter_module\cf5 .\cf14 Counter\cf5 ()\cf14   \cf6 # Creates Counter()\cf14 \cb1 \
