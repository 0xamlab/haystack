\
\cf5 \cb15 print(\cf14 Person\cf5 .\cf14 is_valid_age\cf5 (\cf21 45\cf5 ))\cf14  \cf6 # Prints 'True'\cf14 \cb1 \
\cf5 \cb15 print(\cf14 Person\cf5 .\cf14 is_valid_age\cf5 (-\cf21 1\cf5 ))\cf14  \cf6 # Prints 'False'\cf14 \cb1 \
