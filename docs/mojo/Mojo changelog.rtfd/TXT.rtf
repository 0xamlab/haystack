\fs28 \cf5 \cb12 \kerning1\expnd0\expndtw0 {\listtext	\uc0\u8226 	}{\field{\*\fldinst{HYPERLINK "https://docs.modular.com/stable/mojo/std/collections/string/string_slice/StringSlice/#find"}}{\fldrslt \expnd0\expndtw0\kerning0
\ul StringSlice.find}}
