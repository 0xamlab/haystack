  \cf6 # String type.\cf14 \cb1 \
\ls76\ilvl0\cb13 \kerning1\expnd0\expndtw0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
  \cf5 alias\cf14  comptime_ptr \cf5 =\cf14  String\cf5 (\cf19 "foo"\cf14  \cf5 +\cf14  \cf19 "bar"\cf5 ).\cf14 unsafe_ptr\cf5 ()\cf14 \cb1 \
