\fs48 \cf2 Use the copying functionality\
\pard\pardeftab720\sa320\partightenfactor0

\fs32 \cf2 Demonstrating the behavior, this 
\fs28 \cf10 \cb14 main()
\fs32 \cf2 \cb1  function creates two instances, one populated by normal values, and one essentially zeroed-out. After copying, 
\fs28 \cf10 \cb14 target_instance
\fs32 \cf2 \cb1  has received its values from 
\fs28 \cf10 \cb14 original_instance
\fs32 \cf2 \cb1 's fields:\
\pard\pardeftab720\partightenfactor0

\fs28 \cf5 \cb15 def\cf16  \cf18 main\cf5 ():\cf16 \cb1 \
\cb15     \cf5 var\cf16  original_instance \cf5 =\cf16  MultiType\cf5 (\cf17 "Hello"\cf5 ,\cf16  \cf19 1\cf5 ,\cf16  \cf19 True\cf5 ,\cf16  \cf19 2.5\cf5 )\cf16 \cb1 \
\cb15     \cf5 var\cf16  target_instance \cf5 =\cf16  MultiType\cf5 (\cf17 ""\cf5 ,\cf16  \cf19 0\cf5 ,\cf16  \cf19 False\cf5 ,\cf16  \cf19 0.0\cf5 )\cf16 \cb1 \
\
\cb15     \cf5 print(\cf17 "Original instance:"\cf5 ,\cf16  original_instance\cf5 )\cf16      \cf6 # "Hello", 1, True, 2.5\cf16 \cb1 \
\cb15     \cf5 print(\cf17 "Target instance before: "\cf5 ,\cf16  target_instance\cf5 )\cf16  \cf6 # "", 0, False, 0.0\cf16 \cb1 \
\
\cb15     original_instance\cf5 .\cf16 copy_to\cf5 (\cf16 target_instance\cf5 )\cf16 \cb1 \
\cb15     \cf5 print(\cf17 "Target instance after: "\cf5 ,\cf16  target_instance\cf5 )\cf16   \cf6 #  "Hello", 1, True, 2.5\cf16 \cb1 \
\pard\pardeftab720\qc\partightenfactor0

