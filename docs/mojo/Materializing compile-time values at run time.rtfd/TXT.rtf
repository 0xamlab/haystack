\fs64 \cf2 Materializing literals\
\pard\pardeftab720\sa320\partightenfactor0

\fs32 \cf2 Literal values, like string literals and numeric literals are also materialized to their run-time equivalents, but this is mostly handled automatically by the compiler:\
\pard\pardeftab720\partightenfactor0

\fs28 \cf5 \cb12 comptime\cf13  str_literal \cf5 =\cf13  \cf19 "Hello"\cf13   \cf6 # at compile time, a StringLiteral\cf13 \cb1 \
\cf5 \cb12 var\cf13  \cf14 str\cf13  \cf5 =\cf13  str_literal  \cf6 # at run time, a String.\cf13 \cb1 \
\cf5 \cb12 var\cf13  static_str\cf5 :\cf13  StaticString \cf5 =\cf13  str_literal  \cf6 # or a StaticString\cf13 \cb1 \
\pard\pardeftab720\qc\partightenfactor0

\fs32 \cf16 \
\pard\pardeftab720\qc\partightenfactor0
