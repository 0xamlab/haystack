\cb15             grid_dim\cf5 =(\cf17 2\cf5 ,\cf16  \cf17 2\cf5 ,\cf16  \cf17 1\cf5 ),\cf16 \cb1 \
\cb15             block_dim\cf5 =(\cf17 16\cf5 ,\cf16  \cf17 4\cf5 ,\cf16  \cf17 2\cf5 )\cf16 \cb1 \
\cb15         \cf5 )\cf16 \cb1 \
\pard\pardeftab720\qc\partightenfactor0

