\
\cb16 Error: At Expression [2] wrapper:14:16: AssertionError: paradoxes are not allowed\cb1 \
\pard\pardeftab720\sa320\partightenfactor0

\fs32 \cf2 For comparing floating-point values, you should use 
\fs28 \cf10 \cb15 assert_almost_equal()
\fs32 \cf2 \cb1 , which allows you to specify either an absolute or relative tolerance.\
\pard\pardeftab720\partightenfactor0

\fs28 \cf17 \cb16 result \cf5 =\cf17  \cf19 10\cf17  \cf5 /\cf17  \cf19 3\cf17 \cb1 \
\cb16 assert_almost_equal\cf5 (\cf17 result\cf5 ,\cf17  \cf19 3.33\cf5 ,\cf17  atol\cf5 =\cf19 0.001\cf5 ,\cf17  msg\cf5 =\cf23 "close but no cigar"\cf5 )\cf17 \cb1 \
\pard\pardeftab720\qc\partightenfactor0

\fs32 \cf20 \
\pard\pardeftab720\qc\partightenfactor0
