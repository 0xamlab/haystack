\fs28 \cf6 \cb14 # given a tensor of size rows x cols\cf13 \cb1 \
\pard\pardeftab720\partightenfactor0
\cf5 \cb14 comptime\cf13  num_row_tiles \cf5 =\cf13  ceildiv\cf5 (\cf13 rows\cf5 ,\cf13  tile_size\cf5 )\cf13 \cb1 \
\cf5 \cb14 comptime\cf13  num_col_tiles \cf5 =\cf13  ceildiv\cf5 (\cf13 cols\cf5 ,\cf13  tile_size\cf5 )\cf13 \cb1 \
\
\cf5 \cb14 for\cf13  i \cf5 in\cf13  \cf20 range\cf5 (\cf13 num_row_tiles\cf5 ):\cf13 \cb1 \
\cb14     \cf5 var\cf13  \cf20 iter\cf13  \cf5 =\cf13  tensor\cf5 .\cf13 tiled_iterator\cf5 [\cf13 tile_size\cf5 ,\cf13  tile_size\cf5 ,\cf13  axis\cf5 =\cf17 1\cf5 ](\cf13 i\cf5 ,\cf13  \cf17 0\cf5 )\cf13 \cb1 \
\
\cb14     \cf5 for\cf13  _ \cf5 in\cf13  \cf20 range\cf5 (\cf13 num_col_tiles\cf5 ):\cf13 \cb1 \
\cb14         \cf5 var\cf13  tile \cf5 =\cf13  \cf20 iter\cf5 []\cf13 \cb1 \
\cb14         \cf6 # ... do something with the tile\cf13 \cb1 \
\cb14         \cf20 iter\cf13  \cf5 +=\cf13  \cf17 1\cf13 \cb1 \
