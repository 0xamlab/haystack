{
  "id": "refuse_free_variable",
  "family": "refusals",
  "description": "min x + y with x free: solvable in general, refused by the x >= 0 plane.",
  "maximize": false,
  "objective": {
    "coeffs": {
      "x": 1,
      "y": 1
    },
    "constant": 0.0
  },
  "variables": [
    {
      "name": "x",
      "kind": "continuous",
      "lower": null
    },
    {
      "name": "y",
      "kind": "continuous",
      "lower": 0.0
    }
  ],
  "constraints": [
    {
      "name": "floor",
      "coeffs": {
        "x": 1,
        "y": 1
      },
      "sense": ">=",
      "rhs": 2
    }
  ],
  "expect": "refused",
  "max_nodes": 10000,
  "referee_expectation": "optimal",
  "coverage_gap": "free_variable"
}
