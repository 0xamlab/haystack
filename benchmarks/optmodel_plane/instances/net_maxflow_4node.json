      "upper": 3
    },
    {
      "name": "sb",
      "kind": "continuous",
      "lower": 0.0,
      "upper": 2
    },
    {
      "name": "ab",
      "kind": "continuous",
      "lower": 0.0,
      "upper": 1
    },
    {
      "name": "at",
      "kind": "continuous",
      "lower": 0.0,
      "upper": 2
    },
    {
      "name": "bt",
      "kind": "continuous",
      "lower": 0.0,
      "upper": 3
    }
  ],
  "constraints": [
    {
      "name": "conserve_a",
      "coeffs": {
        "sa": 1,
