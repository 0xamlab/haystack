{
  "id": "refuse_unbounded",
  "family": "refusals",
  "description": "Maximise x with no ceiling anywhere: unbounded, refused.",
  "maximize": true,
  "objective": {
    "coeffs": {
      "x": 1,
      "y": 1
    },
    "constant": 0.0
  },
  "variables": [
    {
      "name": "x",
      "kind": "continuous",
      "lower": 0.0
    },
    {
      "name": "y",
      "kind": "continuous",
      "lower": 0.0
    }
  ],
  "constraints": [
    {
      "name": "gap",
      "coeffs": {
        "x": 1,
        "y": -1
      },
      "sense": "<=",
      "rhs": 1
    }
  ],
  "expect": "refused",
  "max_nodes": 10000,
  "referee_expectation": "unbounded"
}
