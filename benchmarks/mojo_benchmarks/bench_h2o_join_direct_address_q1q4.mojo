"""bench_h2o_join_direct_address_q1q4.mojo — does direct-addressing apply beyond q5?

`benchmarks/h2o_join/generate.py` proves (its own asserts) that `small.id1` and
`medium.id1`/`medium.id2` are EACH a bijection over a dense range, generated by the
exact same `split_xlr` permutation `big.id3` is -- i.e. q1-q4's dimension tables are
"near-1:1" in the same structural sense q5's is, not merely small. Update #5's
synthetic "duplicate keys" test fixture covered a DIFFERENT, general shape for
correctness breadth; it was never a claim about q1-q4's REAL data. This harness
checks the real data directly, against the already-shipped, general-purpose
`direct_address_join_indices` -- no new kernel code, just a question nobody asked of
it yet: does it also win on q1-q4?
"""
from std.time import perf_counter_ns

from columnar.array import Float64Array, float64_from_list
from columnar.batch import RecordBatch, schema_of
from query.join import (
    JOIN_INNER,
    JOIN_LEFT,
    JoinResult,
    direct_address_join_indices,
    hash_join_indices,
    materialize,
)

comptime DATA_DIR: String = "/tmp/h2o_join"
comptime N_X: Int = 10_000_000
comptime N_SMALL: Int = 10
comptime N_MEDIUM: Int = 10_000
comptime REPS: Int = 5


def _load_column(table: String, col: String, n_rows: Int) raises -> Float64Array:
    var path = DATA_DIR + "/" + table + "_" + col + ".f64.bin"
    var f = open(path, "r")
    var raw = f.read_bytes()
    f.close()
    if len(raw) != n_rows * 8:
        raise Error(
            path + " is " + String(len(raw)) + " bytes, expected "
            + String(n_rows * 8) + " -- run benchmarks/h2o_join/generate.py first"
        )
    var fp = raw.unsafe_ptr().bitcast[Float64]()
    var values = List[Float64](capacity=n_rows)
    for i in range(n_rows):
        values.append(fp[i])
    return float64_from_list(values^)


def _batch(var names: List[String], var cols: List[Float64Array], n: Int) -> RecordBatch:
    return RecordBatch(schema_of(names^), cols^, n)


def _sum(col: Float64Array) -> Float64:
    var total: Float64 = 0.0
    for i in range(col.length):
        if col.is_valid_at(i):
            total += col.get(i)
    return total


def _run_question(
    name: String,
    left: RecordBatch,
    left_key: Int,
    right: RecordBatch,
    right_key: Int,
    join_type: Int,
) raises -> Bool:
    """Times REPS reps of both methods, checks row count + checksum agree exactly,
    prints both mins and the ratio. Returns True iff direct_address's own build
    reported ok=True (a shape mismatch would otherwise silently look like "0 rows",
    which is a wrong-answer risk, not a fast one)."""
    var v1_idx = left.schema.index_of("v1")
    var v2_idx = right.schema.index_of("v2")

    var best_hash = 1e30
    var hash_rows = 0
    var hash_checksum: Float64 = 0.0
    for rep in range(REPS):
        var t0 = perf_counter_ns()
        var result = hash_join_indices(left, left_key, right, right_key, join_type)
        var answer = materialize(left, right, result, "right.")
        var t1 = perf_counter_ns()
        var elapsed = Float64(Int(t1 - t0)) / 1e9
        if elapsed < best_hash:
            best_hash = elapsed
        hash_rows = answer.n_rows
        hash_checksum = _sum(answer.columns[v1_idx]) + _sum(answer.columns[left.width() + v2_idx])

    var best_da = 1e30
    var da_rows = 0
    var da_checksum: Float64 = 0.0
    var da_ok = True
    for rep in range(REPS):
        var t0 = perf_counter_ns()
        var result: JoinResult
        try:
            result = direct_address_join_indices(left, left_key, right, right_key, join_type)
        except e:
            da_ok = False
            print("  " + name + "  direct_address raised: " + String(e))
            break
        var answer = materialize(left, right, result, "right.")
        var t1 = perf_counter_ns()
        var elapsed = Float64(Int(t1 - t0)) / 1e9
        if elapsed < best_da:
            best_da = elapsed
        da_rows = answer.n_rows
        da_checksum = _sum(answer.columns[v1_idx]) + _sum(answer.columns[left.width() + v2_idx])

    if not da_ok:
        return False

    print(
        "  " + name
        + "  hash min=" + String(best_hash) + "s (rows=" + String(hash_rows) + ", chk=" + String(hash_checksum) + ")"
    )
    print(
        "  " + name
        + "  direct_address min=" + String(best_da) + "s (rows=" + String(da_rows) + ", chk=" + String(da_checksum) + ")"
    )
    if hash_rows != da_rows or hash_checksum != da_checksum:
        print("  " + name + "  *** MISMATCH -- do not trust the speedup below ***")
        return False
    var speedup = best_hash / best_da
    print(
        "  " + name + "  direct_address vs hash: " + String(speedup) + "x"
        + (" (direct_address faster)" if speedup > 1.0 else " (direct_address SLOWER)")
    )
    print("")
    return True


def main() raises:
    print("=== does direct-addressing win on q1-q4, not just q5? ===")
    print("  loading tables from " + DATA_DIR + " ...")

    var x_id1 = _load_column("x", "id1", N_X)
    var x_id2 = _load_column("x", "id2", N_X)
    var x_v1 = _load_column("x", "v1", N_X)
    var x_names = List[String]()
    x_names.append("id1"); x_names.append("id2"); x_names.append("v1")
    var x_cols = List[Float64Array]()
    x_cols.append(x_id1^); x_cols.append(x_id2^); x_cols.append(x_v1^)
    var x = _batch(x_names^, x_cols^, N_X)

    var small_id1 = _load_column("small", "id1", N_SMALL)
    var small_v2 = _load_column("small", "v2", N_SMALL)
    var small_names = List[String]()
    small_names.append("id1"); small_names.append("v2")
    var small_cols = List[Float64Array]()
    small_cols.append(small_id1^); small_cols.append(small_v2^)
    var small = _batch(small_names^, small_cols^, N_SMALL)

    var medium_id1 = _load_column("medium", "id1", N_MEDIUM)
    var medium_id2 = _load_column("medium", "id2", N_MEDIUM)
    var medium_v2 = _load_column("medium", "v2", N_MEDIUM)
    var medium_names = List[String]()
    medium_names.append("id1"); medium_names.append("id2"); medium_names.append("v2")
    var medium_cols = List[Float64Array]()
    medium_cols.append(medium_id1^); medium_cols.append(medium_id2^); medium_cols.append(medium_v2^)
    var medium = _batch(medium_names^, medium_cols^, N_MEDIUM)

    print("  loaded: x=" + String(N_X) + " small=" + String(N_SMALL) + " medium=" + String(N_MEDIUM))
    print("")

    _ = _run_question("q1 small  inner on id1 ", x, 0, small, 0, JOIN_INNER)
    _ = _run_question("q2 medium inner on id2 ", x, 1, medium, 1, JOIN_INNER)
    _ = _run_question("q3 medium left  on id2 ", x, 1, medium, 1, JOIN_LEFT)
    _ = _run_question("q4 medium inner on id2*", x, 1, medium, 1, JOIN_INNER)
