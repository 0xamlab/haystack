# The real Mojo engine binary, built by build-mojo.yml on linux/amd64 (core-filtered dispatch,
# linked against the bundled GNU libstdc++). Pinned by tag; bump when the kernel is rebuilt.
ARG MOJO_IMAGE=ghcr.io/escrypto-labs/algenta/mojo:git-4b360dd
FROM ${MOJO_IMAGE} AS mojo

# ── Stage 1: Builder ─────────────────────────────────────────────────────────
FROM python:3.12-slim AS builder

WORKDIR /build

# Install build dependencies (needed for some Python packages)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential libpq-dev curl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements first (layer cache)
COPY requirements-dev.txt ./

# Install Python dependencies into /install prefix
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir --prefix=/install -r requirements-dev.txt

# Stage repository sources and guarantee optional build directories exist.
COPY . /build/context/
RUN mkdir -p /build/context/mojo_build

# ── Stage 2: Runtime ─────────────────────────────────────────────────────────
FROM python:3.12-slim AS runtime

WORKDIR /app

# Runtime system deps only (libpq for asyncpg)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 curl \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user with a writable home for persistent service state.
RUN groupadd --system app && useradd --system --gid app --home-dir /home/app --create-home app

# Copy installed packages from builder
COPY --from=builder /install /usr/local

# Copy application code
COPY --from=builder /build/context/apps/ /app/apps/
COPY --from=builder /build/context/engines/ /app/engines/
COPY --from=builder /build/context/training/ /app/training/
COPY --from=builder /build/context/scripts/ /app/scripts/
COPY --from=builder /build/context/mojo/ /app/mojo/

# Real Mojo kernel: the native binary + the runtime libs its $ORIGIN/../mojo_env rpath resolves.
# RUNTIME_FALLBACK_MODE=deny relies on this being a working binary (no Python fallback).
COPY --from=mojo /app/mojo_build/simulate /app/mojo_build/simulate
COPY --from=mojo /app/mojo_env/.pixi/envs/default/lib /app/mojo_env/.pixi/envs/default/lib

# Ensure the Mojo binary stays executable.
RUN chmod +x /app/mojo_build/simulate

# Set ownership
RUN mkdir -p /home/app/.algenta && chown -R app:app /app /home/app

ENV HOME=/home/app \
    MOJO_BINARY_PATH=/app/mojo_build/simulate

USER app

EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8000/v1/health || exit 1

CMD ["python", "-m", "uvicorn", "apps.api_server.main:app", \
    "--host", "0.0.0.0", "--port", "8000", \
    "--workers", "2", "--no-access-log"]
