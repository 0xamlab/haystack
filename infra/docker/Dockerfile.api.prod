# ── Stage 1: Builder ─────────────────────────────────────────────────────────
FROM python:3.12-slim AS builder

WORKDIR /build

# Install build dependencies (needed for some Python packages)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential libpq-dev curl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements first (layer cache)
COPY requirements-dev.txt ./

# Install Python dependencies into /install prefix
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir --prefix=/install -r requirements-dev.txt

# Stage repository sources and guarantee optional build directories exist.
COPY . /build/context/
RUN mkdir -p /build/context/mojo_build

# ── Stage 2: Runtime ─────────────────────────────────────────────────────────
FROM python:3.12-slim AS runtime

WORKDIR /app

# Runtime system deps only (libpq for asyncpg)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 curl \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN groupadd --system app && useradd --system --gid app --no-create-home app

# Copy installed packages from builder
COPY --from=builder /install /usr/local

# Copy application code
COPY --from=builder /build/context/apps/ /app/apps/
COPY --from=builder /build/context/mojo/ /app/mojo/
COPY --from=builder /build/context/mojo_build/ /app/mojo_build/

# Ensure the Mojo binary stays executable when present.
RUN chmod +x /app/mojo_build/simulate 2>/dev/null || true

# Set ownership
RUN chown -R app:app /app

USER app

EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8000/v1/health || exit 1

CMD ["python", "-m", "uvicorn", "apps.api_server.main:app", \
    "--host", "0.0.0.0", "--port", "8000", \
    "--workers", "2", "--no-access-log"]
