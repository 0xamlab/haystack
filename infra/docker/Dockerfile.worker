# ─── Build stage ───────────────────────────────────────────────────────────────
FROM python:3.14-slim AS builder

WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY apps/api-server/requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir --prefix=/install -r requirements.txt && \
    pip install --no-cache-dir --prefix=/install "dramatiq[redis]>=1.15"

# Stage repository sources and guarantee optional build directories exist.
COPY . /build/context/
RUN mkdir -p /build/context/mojo_build

# ─── Runtime stage ─────────────────────────────────────────────────────────────
FROM python:3.14-slim AS runtime

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --gid 1001 appgroup && \
    useradd --uid 1001 --gid appgroup --shell /bin/bash --create-home appuser

WORKDIR /app

COPY --from=builder /install /usr/local
COPY --from=builder /build/context/apps/ ./apps/
COPY --from=builder /build/context/mojo_build/ ./mojo_build/

RUN chmod +x ./mojo_build/simulate 2>/dev/null || true
RUN chown -R appuser:appgroup /app

USER appuser

ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

CMD ["python", "-m", "dramatiq", "apps.worker.tasks", "--processes", "2", "--threads", "4"]
