# Combined worker + agent-core sidecar image for the co-located Fly `codna-engine` app.
#
# WHY combined: the agent-core contract is shared-filesystem — the Celery worker materializes a
# repo `working_dir` and the sidecar mutates files in that SAME path, then Python recomputes the
# diff (apps/api_server/services/repository_intelligence_agent_core_client.py). Fly volumes attach
# to a single Machine, so the worker and the sidecar must run on the same Machine sharing the volume
# mounted at /home/app/.algenta. This image runs both via infra/docker/engine-entrypoint.sh.
#
# The sidecar is the codna-published, digest-pinned image (built by escrypto-labs/codna CI, NOT here).
# Bump SIDECAR_IMAGE when adopting a newer sidecar (keep it digest-pinned for reproducible deploys).
#
# Build (from repo root):
#   docker build -f infra/docker/Dockerfile.engine.prod -t codna-engine .

ARG SIDECAR_IMAGE=ghcr.io/escrypto-labs/codna/sidecar@sha256:4a7e873277e3c805e2744cba0dc3e0f192dea5944c2389570361c2dc8a9bca0b
FROM ${SIDECAR_IMAGE} AS sidecar

# The real Mojo engine binary, built by build-mojo.yml on linux/amd64 (core-filtered dispatch,
# linked against the bundled GNU libstdc++). Pinned by tag; bump when the kernel is rebuilt.
ARG MOJO_IMAGE=ghcr.io/escrypto-labs/algenta/mojo:git-648cfde
FROM ${MOJO_IMAGE} AS mojo

# ── Stage 1: Python builder (mirrors Dockerfile.worker.prod) ─────────────────
FROM python:3.12-slim AS builder
WORKDIR /build
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential libpq-dev \
    && rm -rf /var/lib/apt/lists/*
COPY requirements-dev.txt ./
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir --prefix=/install -r requirements-dev.txt
COPY . /build/context/
RUN mkdir -p /build/context/mojo_build

# ── Stage 2: Runtime (worker + bun + sidecar app) ────────────────────────────
FROM python:3.12-slim AS runtime
WORKDIR /app

# libpq5 for the worker; curl for the sidecar healthcheck; git + ca-certificates for repo clones.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 curl git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --system app && useradd --system --gid app --home-dir /home/app --create-home app

# Worker (Python) runtime + app + Mojo engine
COPY --from=builder /install /usr/local
COPY --from=builder /build/context/apps/ /app/apps/
COPY --from=builder /build/context/mojo/ /app/mojo/

# Real Mojo kernel: the native binary + the runtime libs its $ORIGIN/../mojo_env rpath resolves.
# RUNTIME_FALLBACK_MODE=deny relies on this being a working binary (no Python fallback).
COPY --from=mojo /app/mojo_build/simulate /app/mojo_build/simulate
COPY --from=mojo /app/mojo_env/.pixi/envs/default/lib /app/mojo_env/.pixi/envs/default/lib
RUN chmod +x /app/mojo_build/simulate

# Bun runtime + the prebuilt agent-core sidecar from the codna image
COPY --from=sidecar /usr/local/bin/bun /usr/local/bin/bun
COPY --from=sidecar --chown=app:app /app/agent-core /app/agent-core

COPY infra/docker/engine-entrypoint.sh /usr/local/bin/engine-entrypoint.sh
RUN chmod +x /usr/local/bin/engine-entrypoint.sh

RUN mkdir -p /home/app/.algenta && chown -R app:app /app /home/app
ENV HOME=/home/app \
    MOJO_BINARY_PATH=/app/mojo_build/simulate \
    AGENT_CORE_HOST=0.0.0.0 \
    AGENT_CORE_PORT=8787
USER app

# The sidecar listens here; api reaches it over Fly private networking (codna-engine.internal:8787).
EXPOSE 8787

CMD ["/usr/local/bin/engine-entrypoint.sh"]
