# Combined async-worker + agent-runtime image for Algenta deployments.
#
# WHY combined: the agent-runtime contract is shared-filesystem. The Celery worker materializes a
# repo `working_dir`, the agent runtime mutates files in that same path, and Python recomputes the
# diff. They must run in one container with /home/app/.algenta mounted as a shared volume.
#
# Build (from repo root):
#   docker build -f infra/docker/Dockerfile.engine.prod -t algenta-engine .

# Both ARGs must precede the first FROM to be global (usable in FROM lines); an ARG declared after
# a FROM is stage-scoped and reads blank in a later FROM (`base name should not be blank`).
ARG SIDECAR_IMAGE=ghcr.io/thyn-ai/codna/sidecar@sha256:4a7e873277e3c805e2744cba0dc3e0f192dea5944c2389570361c2dc8a9bca0b
# The real Mojo engine binary, built by build-mojo.yml on linux/amd64 (core-filtered dispatch,
# linked against the bundled GNU libstdc++). Pinned by tag; bump when the kernel is rebuilt.
ARG MOJO_IMAGE=ghcr.io/thyn-ai/algenta/mojo:git-53359d3
FROM ${SIDECAR_IMAGE} AS sidecar
FROM ${MOJO_IMAGE} AS mojo

# ── Stage 1: Python builder (mirrors Dockerfile.worker.prod) ─────────────────
FROM python:3.14-slim AS builder
WORKDIR /build
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential libpq-dev \
    && rm -rf /var/lib/apt/lists/*
COPY requirements-dev.txt ./
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir --prefix=/install -r requirements-dev.txt
# Telys code-lexical index (memengine.lexical; telys PR #87) — vendored as a pinned, pure-Python wheel.
# telys is a private repo and this builder has no git/creds, so a git+https pin can't resolve here; a
# committed wheel is reproducible + credential-free (and freezable for a publishable engine build).
# Powers the opt-in ALGENTA_REPOSITORIES_LEXICAL_RANKING triage lane; the lane is fail-open, so this
# only takes effect when the flag is set. numpy (its one runtime dep) is already pulled via pandas/pyarrow.
COPY vendor/wheels/telys_runtime-0.1.0a1-py3-none-any.whl /tmp/wheels/
RUN pip install --no-cache-dir --prefix=/install /tmp/wheels/telys_runtime-0.1.0a1-py3-none-any.whl
COPY . /build/context/
RUN mkdir -p /build/context/mojo_build

# ── Stage 2: Runtime (worker + bundled agent app) ────────────────────────────
FROM python:3.14-slim AS runtime
WORKDIR /app

# libpq5 for the worker; curl for the healthcheck; git + ca-certificates for repo clones.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 curl git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --system app && useradd --system --gid app --home-dir /home/app --create-home app

# Worker (Python) runtime + app + Mojo engine
COPY --from=builder /install /usr/local
COPY --from=builder /build/context/apps/ /app/apps/
COPY --from=builder /build/context/engines/ /app/engines/
COPY --from=builder /build/context/training/ /app/training/
COPY --from=builder /build/context/scripts/ /app/scripts/
COPY --from=builder /build/context/mojo/ /app/mojo/
COPY --from=builder /build/context/packages/mcp/ /app/packages/mcp/

# Runtime-manifest source artifacts (committed under build/, ~150KB) so /v1/runtime/manifest
# doesn't 500 on missing files (no tracked .dockerignore excludes build/).
COPY --from=builder /build/context/build/llm_rollout_proof_bundle.json \
                    /build/context/build/llm_rollout_parity_benchmark.json \
                    /build/context/build/llm_compiled_runtime_benchmark.json \
                    /app/build/

# Real Mojo kernel: the native binary + the runtime libs its $ORIGIN/../mojo_env rpath resolves.
# RUNTIME_FALLBACK_MODE=deny relies on this being a working binary (no Python fallback).
COPY --from=mojo /app/mojo_build/simulate /app/mojo_build/simulate
COPY --from=mojo /app/mojo_env/.pixi/envs/default/lib /app/mojo_env/.pixi/envs/default/lib
# Mojo embeds its build-time Python prefix for stdlib bootstrap. Preserve that
# path as a read-only symlink instead of setting PYTHONHOME globally, which
# would corrupt the worker's Python 3.14 runtime.
RUN mkdir -p /build && ln -s /app/mojo_env /build/mojo_env && chmod +x /app/mojo_build/simulate

# Bun runtime + the prebuilt agent application are encapsulated in this final image.
COPY --from=sidecar /usr/local/bin/bun /usr/local/bin/bun
COPY --from=sidecar --chown=app:app /app/agent-core /app/agent-core

COPY infra/docker/engine-entrypoint.sh /usr/local/bin/engine-entrypoint.sh
RUN chmod +x /usr/local/bin/engine-entrypoint.sh

RUN mkdir -p /home/app/.algenta && chown -R app:app /app /home/app
ENV HOME=/home/app \
    MOJO_BINARY_PATH=/app/mojo_build/simulate \
    RUNTIME_FALLBACK_MODE=deny \
    MOJO_ALLOW_SUBPROCESS_FALLBACK=false \
    AGENT_CORE_HOST=0.0.0.0 \
    AGENT_CORE_PORT=8787
USER app

# The bundled agent runtime listens here; the API reaches it over the private container network.
EXPOSE 8787

CMD ["/usr/local/bin/engine-entrypoint.sh"]
