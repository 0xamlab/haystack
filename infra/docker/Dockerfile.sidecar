# Algenta agent-core sidecar — the vendored Apache-2.0 Cline runtime, headless.
# Wave B3: makes the sidecar a real, supervised, deployable service (it was previously
# absent from every image/compose and had to be hand-started).
#
# Build (from repo root):
#   docker build -f infra/docker/Dockerfile.sidecar -t algenta/sidecar .

# ── build: compile the vendored Cline SDK + symlink @cline/* (verified recipe) ──
FROM oven/bun:1.3.13 AS build
WORKDIR /app/agent-core
COPY agent-core/ ./
# Build only the SDK packages (the CLI/apps are not needed by the sidecar), then
# symlink the built @cline/* workspaces so files outside them (algenta/*) can import.
RUN cd vendor/cline \
    && bun install \
    && bun run build:sdk \
    && bash algenta/postbuild.sh

# ── runtime: slim image, non-root, curl for healthcheck, git for proof provenance ──
FROM oven/bun:1.3.13-slim AS runtime
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl git ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN useradd --create-home --uid 10001 app
WORKDIR /app/agent-core
COPY --from=build --chown=app:app /app/agent-core /app/agent-core
USER app
ENV NODE_ENV=production \
    AGENT_CORE_PORT=8787 \
    AGENT_CORE_HOST=0.0.0.0
EXPOSE 8787
# run-server.mjs supervises run-server.ts (respawn-on-crash with backoff); on SIGTERM the
# child flips /ready -> 503 and drains in-flight requests before exiting (Wave A1 + B3).
CMD ["bun", "run-server.mjs"]
