# The real Mojo engine binary, built by build-mojo.yml on linux/amd64 (core-filtered dispatch,
# linked against the bundled GNU libstdc++). Pinned by tag; bump when the kernel is rebuilt.
ARG MOJO_IMAGE=ghcr.io/thyn-ai/algenta/mojo:git-ea78d66
FROM ${MOJO_IMAGE} AS mojo

# ── Stage 1: Builder ─────────────────────────────────────────────────────────
FROM python:3.14-slim AS builder

WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-dev.txt ./
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir --prefix=/install -r requirements-dev.txt

# Stage repository sources and guarantee optional build directories exist.
COPY . /build/context/
RUN mkdir -p /build/context/mojo_build

# ── Stage 2: Runtime ─────────────────────────────────────────────────────────
FROM python:3.14-slim AS runtime

WORKDIR /app

# libpq for asyncpg; git for remote-repo source resolution + clones (git ls-remote/clone).
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 git \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --system app && useradd --system --gid app --home-dir /home/app --create-home app

COPY --from=builder /install /usr/local
# --chown at COPY time replaces the later recursive `chown -R /app`, which re-wrote every file
# under /app into the image a second time (+~1 GB per image). Ownership at copy time costs nothing.
COPY --from=builder --chown=app:app /build/context/apps/ /app/apps/
COPY --from=builder --chown=app:app /build/context/mojo/ /app/mojo/

# Runtime-manifest source artifacts (committed under build/, ~150KB) so /v1/runtime/manifest
# doesn't 500 on missing files (no tracked .dockerignore excludes build/).
COPY --from=builder --chown=app:app /build/context/build/llm_rollout_proof_bundle.json \
                    /build/context/build/llm_rollout_parity_benchmark.json \
                    /build/context/build/llm_compiled_runtime_benchmark.json \
                    /app/build/

# Real Mojo kernel: the native binary + the runtime libs its $ORIGIN/../mojo_env rpath resolves.
# RUNTIME_FALLBACK_MODE=deny relies on this being a working binary (no Python fallback).
COPY --from=mojo --chown=app:app /app/mojo_build/simulate /app/mojo_build/simulate
COPY --from=mojo --chown=app:app /app/mojo_env/.pixi/envs/default/lib /app/mojo_env/.pixi/envs/default/lib

# Mojo embeds its build-time Python prefix for stdlib bootstrap. Preserve that
# path as a read-only symlink instead of setting PYTHONHOME globally, which
# would corrupt the worker's Python 3.14 runtime.
RUN mkdir -p /build && ln -s /app/mojo_env /build/mojo_env && chmod +x /app/mojo_build/simulate
# /home/app is created app-owned by useradd --create-home; only the state dir needs making.
RUN mkdir -p /home/app/.algenta && chown app:app /home/app/.algenta
ENV HOME=/home/app \
    MOJO_BINARY_PATH=/app/mojo_build/simulate \
    RUNTIME_FALLBACK_MODE=deny \
    MOJO_ALLOW_SUBPROCESS_FALLBACK=false
USER app

# Worker is a long-running Celery process for async job execution and persistence.
# Consumes `repository` too (decision-plan/pipeline + GitHub App fix jobs are enqueued there).
CMD ["python", "-m", "celery", "-A", "apps.worker.tasks.simulation_task:celery_app", "worker", "--loglevel=INFO", "--queues=persist,simulate,repository", "--concurrency=2"]
