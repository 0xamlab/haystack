# ── Stage 1: Builder ─────────────────────────────────────────────────────────
FROM python:3.12-slim AS builder

WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-dev.txt ./
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir --prefix=/install -r requirements-dev.txt

# Stage repository sources and guarantee optional build directories exist.
COPY . /build/context/
RUN mkdir -p /build/context/mojo_build

# ── Stage 2: Runtime ─────────────────────────────────────────────────────────
FROM python:3.12-slim AS runtime

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --system app && useradd --system --gid app --home-dir /home/app --create-home app

COPY --from=builder /install /usr/local
COPY --from=builder /build/context/apps/ /app/apps/
COPY --from=builder /build/context/mojo/ /app/mojo/
COPY --from=builder /build/context/mojo_build/ /app/mojo_build/

RUN chmod +x /app/mojo_build/simulate 2>/dev/null || true
RUN mkdir -p /home/app/.algenta && chown -R app:app /app /home/app
ENV HOME=/home/app
USER app

# Worker is a long-running Celery process for async job execution and persistence.
# Consumes `repository` too (decision-plan/pipeline + GitHub App fix jobs are enqueued there).
CMD ["python", "-m", "celery", "-A", "apps.worker.tasks.simulation_task:celery_app", "worker", "--loglevel=INFO", "--queues=persist,simulate,repository", "--concurrency=2"]
