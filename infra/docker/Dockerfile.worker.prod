# ── Stage 1: Builder ─────────────────────────────────────────────────────────
FROM python:3.12-slim AS builder

WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-dev.txt ./
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir --prefix=/install -r requirements-dev.txt

# ── Stage 2: Runtime ─────────────────────────────────────────────────────────
FROM python:3.12-slim AS runtime

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --system app && useradd --system --gid app --no-create-home app

COPY --from=builder /install /usr/local
COPY apps/ /app/apps/
COPY mojo/ /app/mojo/
COPY mojo_build/ /app/mojo_build/

RUN chown -R app:app /app
USER app

# Worker is a long-running dramatiq process
CMD ["python", "-m", "dramatiq", "apps.worker.tasks.simulation_task", "--processes", "2", "--threads", "4"]
