# Keep the build context lean + secret-free for `az acr build` / docker build.
# The prod image (Dockerfile.api.prod) selectively copies apps/ engines/ training/
# scripts/ mojo/ and three build/*.json runtime-manifest artifacts — everything else
# is safe to exclude from the upload.
.git
.gitignore
.venv
venv
env
**/__pycache__
**/*.pyc
**/*.pyo
**/*.pyd
.pytest_cache
.mypy_cache
.ruff_cache
.cache
.coverage
htmlcov
node_modules

# Secrets must never enter the image context.
.env
.env.*
*.pem
*.key

# Heavy / not-copied-into-the-image trees.
benchmarks
test_files
tests
gitbook
apps/docs
!apps/docs/
!apps/docs/integration_manifest.v1.json
mojo/tests
mojo_build
dist
*.log

# build/ is not copied wholesale — keep only the runtime-manifest artifacts the
# /v1/runtime/manifest endpoint needs (Dockerfile.api.prod copies these by name).
build/*
!build/llm_rollout_proof_bundle.json
!build/llm_rollout_parity_benchmark.json
!build/llm_compiled_runtime_benchmark.json
mojo_env
.pixi
build/artifacts
