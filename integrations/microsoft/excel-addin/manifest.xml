<?xml version="1.0" encoding="UTF-8"?>
<!--
  Algenta Decisions — Excel task-pane Add-in (Build order 8).

  A native Excel modelling surface over the customer-hosted Decision API: select ranges as a
  Decision Pack's assumptions, run the governed analysis in the customer's Azure, and write
  results (recommendation, sensitivity, evidence) back to NEW sheets after a preview. Entra SSO
  via <WebApplicationInfo> yields a token whose audience is the gateway API (the same audience
  services/entra_auth.py validates).

  OWNER go-live: host the static files (SourceLocation host), fill the Entra client id + api://
  audience below, then sideload/publish. See README.md.
-->
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
           xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides"
           xsi:type="TaskPaneApp">
  <Id>7f3a1c2e-0000-4a00-9d00-algentadecide01</Id>
  <Version>0.1.0</Version>
  <ProviderName>Algenta</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Algenta Decisions" />
  <Description DefaultValue="Turn workbook assumptions + approved enterprise data into governed decisions, computed in your Azure." />
  <IconUrl DefaultValue="https://YOUR-ADDIN-HOST/assets/icon-32.png" />
  <HighResolutionIconUrl DefaultValue="https://YOUR-ADDIN-HOST/assets/icon-80.png" />
  <SupportUrl DefaultValue="https://docs.algenta.ai/integrations/microsoft/excel" />
  <Hosts>
    <Host Name="Workbook" />
  </Hosts>
  <Requirements>
    <Sets DefaultMinVersion="1.3">
      <Set Name="ExcelApi" MinVersion="1.3" />
    </Sets>
  </Requirements>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://YOUR-ADDIN-HOST/taskpane.html" />
  </DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Workbook">
        <DesktopFormFactor>
          <GetStarted>
            <Title resid="GetStarted.Title" />
            <Description resid="GetStarted.Description" />
            <LearnMoreUrl resid="GetStarted.LearnMoreUrl" />
          </GetStarted>
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="Algenta.Group">
                <Label resid="Algenta.Group.Label" />
                <Control xsi:type="Button" id="Algenta.OpenPane">
                  <Label resid="Algenta.OpenPane.Label" />
                  <Supertip>
                    <Title resid="Algenta.OpenPane.Label" />
                    <Description resid="Algenta.OpenPane.Tooltip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Algenta.Icon16" />
                    <bt:Image size="32" resid="Algenta.Icon32" />
                    <bt:Image size="80" resid="Algenta.Icon80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>AlgentaDecisions</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url" />
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Algenta.Icon16" DefaultValue="https://YOUR-ADDIN-HOST/assets/icon-16.png" />
        <bt:Image id="Algenta.Icon32" DefaultValue="https://YOUR-ADDIN-HOST/assets/icon-32.png" />
        <bt:Image id="Algenta.Icon80" DefaultValue="https://YOUR-ADDIN-HOST/assets/icon-80.png" />
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Taskpane.Url" DefaultValue="https://YOUR-ADDIN-HOST/taskpane.html" />
        <bt:Url id="GetStarted.LearnMoreUrl" DefaultValue="https://docs.algenta.ai/integrations/microsoft/excel" />
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GetStarted.Title" DefaultValue="Algenta Decisions" />
        <bt:String id="Algenta.Group.Label" DefaultValue="Algenta" />
        <bt:String id="Algenta.OpenPane.Label" DefaultValue="Decisions" />
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="GetStarted.Description" DefaultValue="Frame a decision from your workbook and run it in your Azure." />
        <bt:String id="Algenta.OpenPane.Tooltip" DefaultValue="Open the Algenta Decisions pane." />
      </bt:LongStrings>
    </Resources>
    <WebApplicationInfo>
      <!-- OWNER: the gateway app registration's client id + api:// audience (== ALGENTA_ENTRA_AUDIENCE). -->
      <Id>REPLACE_WITH_ENTRA_CLIENT_ID</Id>
      <Resource>api://REPLACE_WITH_GATEWAY_AUDIENCE</Resource>
      <Scopes>
        <Scope>access_as_user</Scope>
      </Scopes>
    </WebApplicationInfo>
  </VersionOverrides>
</OfficeApp>
