# Go-live validation fixture envs
#
# Copy the keys you actually need into your shell or local .env before running:
#   make go-live-status
#   make test-go-live-connectivity
#   make test-go-live-full
#
# Full runbook:
#   tests/integration/GO_LIVE_VALIDATION.md

# Optional public no-auth case gate
DE_ENABLE_SLOW_PUBLIC_REST_CASES=

# Tier 2: credentialed examples
DE_TEST_FRED_API_KEY=
DE_TEST_FRED_SERIES_ID=GNPCA
DE_TEST_GITHUB_TOKEN=

# Tier 3: customer object storage
DE_TEST_S3_BUCKET=
DE_TEST_S3_KEY=
DE_TEST_S3_ACCESS_KEY_ID=
DE_TEST_S3_SECRET_ACCESS_KEY=
DE_TEST_S3_ENDPOINT_URL=
DE_TEST_S3_REGION=us-east-1
DE_TEST_S3_FILE_TYPE=csv

DE_TEST_GCS_BUCKET=
DE_TEST_GCS_BLOB=
DE_TEST_GCS_CREDENTIALS=
DE_TEST_GCS_PROJECT_ID=
DE_TEST_GCS_FILE_TYPE=csv

DE_TEST_AZURE_CONNECTION_STRING=
DE_TEST_AZURE_ACCOUNT_URL=
DE_TEST_AZURE_CONTAINER=
DE_TEST_AZURE_BLOB=
DE_TEST_AZURE_BLOB_URL=
DE_TEST_AZURE_FILE_TYPE=csv

# Tier 3: Redis
DE_TEST_REDIS_URL=

# Tier 3: Elasticsearch / Elastic Cloud
DE_TEST_ELASTICSEARCH_URL=
DE_TEST_ELASTICSEARCH_API_KEY=
DE_TEST_ELASTICSEARCH_INDEX=
DE_TEST_ELASTICSEARCH_QUERY=
DE_TEST_ELASTICSEARCH_LIMIT=100

# Tier 3: Neo4j / Aura
DE_TEST_NEO4J_URI=
DE_TEST_NEO4J_USERNAME=
DE_TEST_NEO4J_PASSWORD=
DE_TEST_NEO4J_DATABASE=neo4j

# Tier 3: ClickHouse
DE_TEST_CLICKHOUSE_URL=
DE_TEST_CLICKHOUSE_USER=
DE_TEST_CLICKHOUSE_PASSWORD=
DE_TEST_CLICKHOUSE_DATABASE=default

# Behavior validation requires one selector:
DE_TEST_CLICKHOUSE_QUERY=
DE_TEST_CLICKHOUSE_TABLE=
DE_TEST_CLICKHOUSE_LIMIT=100

# Tier 3: Snowflake
DE_TEST_SNOWFLAKE_ACCOUNT=
DE_TEST_SNOWFLAKE_USER=
DE_TEST_SNOWFLAKE_PASSWORD=
DE_TEST_SNOWFLAKE_WAREHOUSE=
DE_TEST_SNOWFLAKE_DATABASE=SNOWFLAKE_SAMPLE_DATA
DE_TEST_SNOWFLAKE_SCHEMA=TPCH_SF1

# Behavior validation requires one selector:
DE_TEST_SNOWFLAKE_QUERY=
DE_TEST_SNOWFLAKE_TABLE=
DE_TEST_SNOWFLAKE_LIMIT=100

# Tier 3: BigQuery
DE_TEST_BIGQUERY_PROJECT_ID=
DE_TEST_BIGQUERY_SERVICE_ACCOUNT_JSON=

# Behavior validation requires one selector:
DE_TEST_BIGQUERY_QUERY=
DE_TEST_BIGQUERY_DATASET=
DE_TEST_BIGQUERY_TABLE=
DE_TEST_BIGQUERY_LIMIT=100

# Fivetran validation-only wave 1
DE_TEST_FIVETRAN_API_KEY=
DE_TEST_FIVETRAN_API_SECRET=
DE_TEST_FIVETRAN_MANIFEST_PATH=tests/integration/fivetran_wave1_manifest.example.json
