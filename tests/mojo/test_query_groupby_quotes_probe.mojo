    var n_rows = 1000
    if len(codes) != n_rows or len(prices) != n_rows:
        raise Error("fixture is malformed: length mismatch")

    var names = List[String]()
    names.append("cust_type_code")
    names.append("unit_price")
    var schema = schema_of(names^)

    var columns = List[Float64Array]()
    columns.append(float64_from_list(codes^))
    columns.append(float64_from_list(prices^))
    var batch = RecordBatch(schema^, columns^, n_rows)

    # ONE dispatch: group by column 0 (cust_type_code), aggregate column 1
    # (unit_price) three ways at once -- mean, sum, count -- across ALL 16
    # categories present in the slice.
    var key_columns = List[Int]()
    key_columns.append(0)
    var value_columns = List[Int]()
    value_columns.append(1)
    value_columns.append(1)
    value_columns.append(1)
    var opcodes = List[Int]()
    opcodes.append(AGG_AVG)
    opcodes.append(AGG_SUM)
    opcodes.append(AGG_COUNT)

    var result = group_by_composed_parallel(batch, key_columns, value_columns, opcodes, 4)

    var expected_n_groups = 16
    if result.n_groups() == expected_n_groups:
        passed += 1
        print("  ✅ group_by_composed_parallel found all 16 real categories in one dispatch")
    else:
        failed += 1
        print("  ❌ wrong group count:", result.n_groups(), "expected", expected_n_groups)

    # Decode each group's code back to a category label and check mean/sum/count
    # against the independently-computed pandas ground truth for that category.
    var category_by_code = List[String]()
    category_by_code.append(" ELEC BRKR")
    category_by_code.append("AIRMAJ")
    category_by_code.append("AIRREG")
    category_by_code.append("BA")
    category_by_code.append("BIZJET")
    category_by_code.append("BROKER")
    category_by_code.append("COMREP")
    category_by_code.append("DIST")
    category_by_code.append("INTERCO")
    category_by_code.append("MRO")
    category_by_code.append("NA BROKER")
    category_by_code.append("OEM")
    category_by_code.append("SIMULATOR")
    category_by_code.append("TRADE")
    category_by_code.append("UNKNOWN")
    category_by_code.append("UTILITY")

    var n_checked = 0
    for g in range(result.n_groups()):
        var code = Int(result.key_tuples[g * result.key_width] + 0.5)
        var label = category_by_code[code]
        var mean_val = result.values[g * result.n_aggs + 0]
        var sum_val = result.values[g * result.n_aggs + 1]
        var count_val = result.values[g * result.n_aggs + 2]
        var mean_present = result.present[g * result.n_aggs + 0]

        if not mean_present:
            failed += 1
            print("  ❌", label, "has no mean, but the slice has observations for it")
            continue

        var expected_mean: Float64 = 0.0
        var expected_sum: Float64 = 0.0
        var expected_count: Float64 = 0.0
        var known = True
        if label == " ELEC BRKR":
            expected_mean = 153.335
            expected_sum = 1533.3500000000001
            expected_count = 10.0
        elif label == "AIRMAJ":
            expected_mean = 798.95
            expected_sum = 3195.8
            expected_count = 4.0
        elif label == "AIRREG":
            expected_mean = 93.60666666666667
            expected_sum = 280.82
            expected_count = 3.0
        elif label == "BA":
            expected_mean = 99.46733333333333
            expected_sum = 1492.01
            expected_count = 15.0
        elif label == "BIZJET":
            expected_mean = 369.85555555555555
            expected_sum = 3328.7
            expected_count = 9.0
        elif label == "BROKER":
            expected_mean = 181.66219123505977
            expected_sum = 45597.21
            expected_count = 251.0
        elif label == "COMREP":
            expected_mean = 606.476
            expected_sum = 6064.76
            expected_count = 10.0
        elif label == "DIST":
            expected_mean = 178.91576923076926
            expected_sum = 4651.81
            expected_count = 26.0
        elif label == "INTERCO":
            expected_mean = 0.5
            expected_sum = 0.5
            expected_count = 1.0
        elif label == "MRO":
            expected_mean = 98.92166666666667
            expected_sum = 593.53
            expected_count = 6.0
        elif label == "NA BROKER":
            expected_mean = 142.73754716981134
            expected_sum = 7565.09
            expected_count = 53.0
        elif label == "OEM":
            expected_mean = 127.50464419475655
            expected_sum = 68087.48
            expected_count = 534.0
        elif label == "SIMULATOR":
            expected_mean = 73.11875
            expected_sum = 2339.8
            expected_count = 32.0
        elif label == "TRADE":
            expected_mean = 134.35875
            expected_sum = 1074.87
            expected_count = 8.0
        elif label == "UNKNOWN":
            expected_mean = 223.12583333333333
            expected_sum = 8032.53
            expected_count = 36.0
        elif label == "UTILITY":
            expected_mean = 87.42
            expected_sum = 174.84
            expected_count = 2.0
        else:
            known = False

        if not known:
            failed += 1
            print("  ❌ unrecognized category label decoded:", label)
            continue

        n_checked += 1
        if _approx(mean_val, expected_mean, 0.005) and _approx(sum_val, expected_sum, 0.005) and _approx(count_val, expected_count, 0.0001):
            passed += 1
            print("  ✅", label, "mean=", mean_val, "sum=", sum_val, "count=", count_val, "(matches pandas)")
        else:
            failed += 1
            print("  ❌", label, "MISMATCH: kernel mean=", mean_val, "sum=", sum_val, "count=", count_val, " pandas mean=", expected_mean, "sum=", expected_sum, "count=", expected_count)

    var expected_checked = 16
    if n_checked == expected_checked:
        passed += 1
        print("  ✅ checked all", n_checked, "real categories against pandas ground truth")
    else:
        failed += 1
        print("  ❌ only checked", n_checked, "of", expected_checked, "categories")

    print("  [test_query_groupby_quotes_probe] Passed:", passed, "Failed:", failed)
    if failed > 0:
        raise Error("test_query_groupby_quotes_probe: " + String(failed) + " check(s) failed")
