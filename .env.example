# ─── Application ───────────────────────────────────────────────────────────────
API_ENV=development
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ─── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/decision_engine
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/decision_engine

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Object Storage (S3 / MinIO) ───────────────────────────────────────────────
S3_BUCKET_NAME=decision-engine-results
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION=us-east-1
RESULT_STORAGE_ENABLED=false

# ─── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-use-256-bit-random-value
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
API_KEY_PREFIX=de_live_
API_KEY_TEST_PREFIX=de_test_

# ─── Mojo Engine ───────────────────────────────────────────────────────────────
MOJO_BINARY_PATH=./mojo_build/simulate
MOJO_TIMEOUT_SECONDS=30
MOJO_MAX_CONCURRENT=4
RUNTIME_FALLBACK_MODE=auto
ALGENTA_SOURCES_DIR=/tmp/algenta/sources

# ─── Privacy / Deployment ──────────────────────────────────────────────────────
ALGENTA_DEPLOYMENT_MODE=saas
ALGENTA_DISABLE_CLOUD=
ALGENTA_DISABLE_TELEMETRY=
ALGENTA_TELEMETRY_MODE=
ALGENTA_METERING_MODE=
ALGENTA_REQUIRE_LOCAL_LICENSE=
ALGENTA_CONTROL_PLANE_URL=
ALGENTA_ALLOW_OUTBOUND_NETWORK=
ALGENTA_EGRESS_ALLOWLIST=
ALGENTA_LOCAL_LICENSE_PUBLIC_KEY_FILE=
ALGENTA_API_PUBLIC_BASE_URL=
ALGENTA_APP_BASE_URL=

# ─── Request Limits ────────────────────────────────────────────────────────────
MAX_PAYLOAD_SIZE_BYTES=1048576
MAX_SYNC_RUNS=100000
MAX_BATCH_ITEMS_FREE=10
MAX_BATCH_ITEMS_PRO=100

# ─── Billing (Stripe) ──────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# ─── Cloud Provider Credentials (for per-org isolated deployments) ─────────────
# Leave all blank to disable cloud provisioning (uses shared pool only)

# AWS — ECS Fargate + RDS + ElastiCache
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_ECR_IMAGE_URI=

# Azure — ACI + PostgreSQL Flexible + Redis Cache
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_RESOURCE_GROUP_PREFIX=algenta
AZURE_ACR_REGISTRY=

# GCP — Cloud Run + Cloud SQL + Memorystore
GCP_PROJECT_ID=
GCP_SERVICE_ACCOUNT_JSON=
GCP_REGION=us-central1
GCP_ARTIFACT_REGISTRY=

# Provisioning settings
ALGENTA_ENGINE_IMAGE=ghcr.io/algenta/decision-engine/api:latest
DEPLOYMENT_BASE_DOMAIN=deploy.algenta.ai
DEPLOYMENT_BILLING_MARKUP_PCT=20.0

# ─── Observability ─────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
SENTRY_DSN=
# Protect /metrics endpoint — Prometheus scraper must send X-Metrics-Secret: <value>
# Leave empty to restrict to loopback only (127.0.0.1)
METRICS_SECRET=

# ─── Email ─────────────────────────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=noreply@decisionengine.io

# ─── Webhooks ──────────────────────────────────────────────────────────────────
WEBHOOK_SIGNING_SECRET=change-me-in-production
WEBHOOK_MAX_RETRIES=3

# ─── Quotas (defaults, overridden per org plan in DB) ──────────────────────────
QUOTA_FREE_SIMULATIONS_MONTH=500
QUOTA_DEVELOPER_SIMULATIONS_MONTH=10000
QUOTA_PRO_SIMULATIONS_MONTH=100000

# ─── Go-Live Validation Fixtures (optional) ────────────────────────────────────
# See tests/integration/GO_LIVE_VALIDATION.md and
# tests/integration/go_live_validation.env.example for the full live matrix.

# Optional public no-auth case gate
DE_ENABLE_SLOW_PUBLIC_REST_CASES=

# Tier 2: credentialed examples
DE_TEST_FRED_API_KEY=
DE_TEST_FRED_SERIES_ID=GNPCA
DE_TEST_GITHUB_TOKEN=

# Tier 3: customer object storage
DE_TEST_S3_BUCKET=
DE_TEST_S3_KEY=
DE_TEST_S3_ACCESS_KEY_ID=
DE_TEST_S3_SECRET_ACCESS_KEY=
DE_TEST_S3_ENDPOINT_URL=
DE_TEST_S3_REGION=us-east-1
DE_TEST_S3_FILE_TYPE=csv

DE_TEST_GCS_BUCKET=
DE_TEST_GCS_BLOB=
DE_TEST_GCS_CREDENTIALS=
DE_TEST_GCS_PROJECT_ID=
DE_TEST_GCS_FILE_TYPE=csv

DE_TEST_AZURE_CONNECTION_STRING=
DE_TEST_AZURE_ACCOUNT_URL=
DE_TEST_AZURE_CONTAINER=
DE_TEST_AZURE_BLOB=
DE_TEST_AZURE_BLOB_URL=
DE_TEST_AZURE_FILE_TYPE=csv

# Tier 3: warehouse connector tests
DE_TEST_REDIS_URL=

DE_TEST_ELASTICSEARCH_URL=
DE_TEST_ELASTICSEARCH_API_KEY=
DE_TEST_ELASTICSEARCH_INDEX=
DE_TEST_ELASTICSEARCH_QUERY=
DE_TEST_ELASTICSEARCH_LIMIT=100

DE_TEST_NEO4J_URI=
DE_TEST_NEO4J_USERNAME=
DE_TEST_NEO4J_PASSWORD=
DE_TEST_NEO4J_DATABASE=neo4j

DE_TEST_CLICKHOUSE_URL=
DE_TEST_CLICKHOUSE_USER=
DE_TEST_CLICKHOUSE_PASSWORD=
DE_TEST_CLICKHOUSE_DATABASE=default
DE_TEST_CLICKHOUSE_QUERY=
DE_TEST_CLICKHOUSE_TABLE=
DE_TEST_CLICKHOUSE_LIMIT=100

DE_TEST_SNOWFLAKE_ACCOUNT=
DE_TEST_SNOWFLAKE_USER=
DE_TEST_SNOWFLAKE_PASSWORD=
DE_TEST_SNOWFLAKE_WAREHOUSE=
DE_TEST_SNOWFLAKE_DATABASE=SNOWFLAKE_SAMPLE_DATA
DE_TEST_SNOWFLAKE_SCHEMA=TPCH_SF1
DE_TEST_SNOWFLAKE_QUERY=
DE_TEST_SNOWFLAKE_TABLE=
DE_TEST_SNOWFLAKE_LIMIT=100

DE_TEST_BIGQUERY_PROJECT_ID=
DE_TEST_BIGQUERY_SERVICE_ACCOUNT_JSON=
DE_TEST_BIGQUERY_QUERY=
DE_TEST_BIGQUERY_DATASET=
DE_TEST_BIGQUERY_TABLE=
DE_TEST_BIGQUERY_LIMIT=100

# Fivetran validation-only wave 1
DE_TEST_FIVETRAN_API_KEY=
DE_TEST_FIVETRAN_API_SECRET=
DE_TEST_FIVETRAN_MANIFEST_PATH=tests/integration/fivetran_wave1_manifest.example.json
