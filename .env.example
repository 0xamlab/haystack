# ─── Application ───────────────────────────────────────────────────────────────
API_ENV=development
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ─── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/decision_engine
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/decision_engine

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Object Storage (S3 / MinIO) ───────────────────────────────────────────────
S3_BUCKET_NAME=decision-engine-results
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION=us-east-1

# ─── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-use-256-bit-random-value
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
API_KEY_PREFIX=de_live_
API_KEY_TEST_PREFIX=de_test_

# ─── Mojo Engine ───────────────────────────────────────────────────────────────
MOJO_BINARY_PATH=./mojo_build/simulate
MOJO_TIMEOUT_SECONDS=30
MOJO_MAX_CONCURRENT=4

# ─── Request Limits ────────────────────────────────────────────────────────────
MAX_PAYLOAD_SIZE_BYTES=1048576
MAX_SYNC_RUNS=100000
MAX_BATCH_ITEMS_FREE=10
MAX_BATCH_ITEMS_PRO=100

# ─── Billing (Stripe) ──────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# ─── Cloud Provider Credentials (for per-org isolated deployments) ─────────────
# Leave all blank to disable cloud provisioning (uses shared pool only)

# AWS — ECS Fargate + RDS + ElastiCache
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_ECR_IMAGE_URI=

# Azure — ACI + PostgreSQL Flexible + Redis Cache
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_RESOURCE_GROUP_PREFIX=algenta
AZURE_ACR_REGISTRY=

# GCP — Cloud Run + Cloud SQL + Memorystore
GCP_PROJECT_ID=
GCP_SERVICE_ACCOUNT_JSON=
GCP_REGION=us-central1
GCP_ARTIFACT_REGISTRY=

# Provisioning settings
ALGENTA_ENGINE_IMAGE=ghcr.io/algenta/decision-engine-api:latest
DEPLOYMENT_BASE_DOMAIN=deploy.algenta.ai
DEPLOYMENT_BILLING_MARKUP_PCT=20.0

# ─── Observability ─────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
SENTRY_DSN=
# Protect /metrics endpoint — Prometheus scraper must send X-Metrics-Secret: <value>
# Leave empty to restrict to loopback only (127.0.0.1)
METRICS_SECRET=

# ─── Email ─────────────────────────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=noreply@decisionengine.io

# ─── Webhooks ──────────────────────────────────────────────────────────────────
WEBHOOK_SIGNING_SECRET=change-me-in-production
WEBHOOK_MAX_RETRIES=3

# ─── Quotas (defaults, overridden per org plan in DB) ──────────────────────────
QUOTA_FREE_SIMULATIONS_MONTH=500
QUOTA_DEVELOPER_SIMULATIONS_MONTH=10000
QUOTA_PRO_SIMULATIONS_MONTH=100000
