{
  "name": "@algenta/gateway",
  "version": "1.0.0",
  "description": "Algenta API Gateway — Hono on Node.js 22. Auth, rate limiting, proxy.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev":   "tsx watch src/index.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/index.js",
    "lint":  "eslint src --ext .ts"
  },
  "dependencies": {
    "hono":            "^4.2.0",
    "@hono/node-server": "^1.10.0",
    "ioredis":         "^5.3.2",
    "jose":            "^5.3.0",
    "pino":            "^9.0.0",
    "prom-client":     "^15.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx":         "^4.7.0",
    "typescript":  "^5.4.0"
  },
  "engines": { "node": ">=22.0.0" }
}
