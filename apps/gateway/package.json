{
  "name": "@algenta/gateway",
  "version": "1.0.0",
  "description": "Algenta API Gateway — Hono on Node.js 22. Auth, rate limiting, proxy.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --project tsconfig.json",
