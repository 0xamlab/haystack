{
  "contract_version": "v1.2",
  "brand": "Algenta",
  "api_base_url": "https://api.algenta.ai",
  "mcp_endpoint": "https://api.algenta.ai/mcp/sse",
  "mcp_tools_endpoint": "https://api.algenta.ai/mcp/tools",
  "auth_scheme": "bearer_api_key",
  "api_key_prefixes": {
    "live": "de_live_",
    "test": "de_test_"
  },
  "compatibility": {
    "legacy_headers": [
      "X-API-Key"
    ],
    "legacy_env_vars": [
      "DE_API_KEY",
      "DE_BASE_URL"
    ],
    "legacy_domains": [
      "api.algenta.io",
      "api.decisionengine.io"
    ],
    "deprecation_window_days": 90
  },
  "defaults": {
    "read_only_default": true,
    "write_confirmation_required": true,
    "plan_limits": {
      "free": {
        "requests_per_minute": 60,
        "simulations_per_month": 500
      },
      "developer": {
        "requests_per_minute": 300,
        "simulations_per_month": 10000
      },
      "pro": {
        "requests_per_minute": 1000,
        "simulations_per_month": 100000
      },
      "enterprise": {
        "requests_per_minute": 10000,
        "simulations_per_month": "unlimited"
      }
    }
  },
  "integrations": [
    {
      "name": "ChatGPT",
