      ],
      "auth_scheme": "bearer_api_key",
      "required_scopes": [
        "read"
      ],
      "read_only_default": true,
      "write_actions": [
        "connect_data",
        "refresh_data",
        "disconnect_data"
      ],
      "admin_controls": [
        "tool_allowlist",
        "read_only_mode",
        "dataset_scope"
      ],
      "docs_url": "https://docs.algenta.ai/integrations/chatgpt-actions",
